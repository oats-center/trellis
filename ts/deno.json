{
  "workspace": [
    "./browser",
    "./integration",
    "./packages/result",
    "./packages/trellis-svelte",
    "./packages/trellis-testkit",
    "./packages/trellis"
  ],
  "tasks": {
    "install": "cargo run --manifest-path ../xtask/Cargo.toml -- install",
    "protocol:wasm": "cargo run --manifest-path ../xtask/Cargo.toml -- protocol-wasm",
    "browser:embedded": "deno task install && deno task protocol:wasm && deno task -c ../web/deno.json build:embedded",
    "build:runtime": "deno task browser:embedded",
    "packages:build:npm": "deno task -c packages/result/deno.json build:npm && deno task -c packages/trellis/deno.json build:npm && deno task -c packages/trellis-svelte/deno.json build:npm",
    "packages:build:npm:installed": "deno task -c packages/result/deno.json build:npm && deno task -c packages/trellis/deno.json build:npm:installed && deno task -c packages/trellis-svelte/deno.json build:npm",
    "test:packaging:built": "deno test -A tools/package_build && deno run -A tools/package_build/demo_consumers.ts",
    "build:npm": "deno task install && deno task packages:build:npm",
    "check": "deno task install && deno task protocol:wasm && deno check packages/trellis/index.ts packages/trellis-svelte/src/index.ts packages/trellis-svelte/src/context.svelte.ts packages/trellis-testkit/index.ts",
    "check:integration": "deno task install && deno task protocol:wasm && deno task --config integration/deno.json check",
    "fmt:integration": "deno fmt -c deno.json integration",
    "test:integration": "deno test --parallel -A -c integration/deno.json integration",
    "test:auth": "deno task install && deno task protocol:wasm && deno test -A packages/trellis/auth/conformance_test.ts packages/trellis/auth/session_auth_test.ts",
    "test:result": "deno test -A packages/result",
    "test:trellis": "deno test -A packages/trellis",
    "test:trellis-svelte": "deno test -A packages/trellis-svelte",
    "test:trellis-testkit": "deno test -A packages/trellis-testkit",
    "test:packages": {
      "dependencies": [
        "test:result",
        "test:trellis",
        "test:trellis-svelte",
        "test:trellis-testkit"
      ]
    },
    "test:ui-tools": "deno test -A ../web tools",
    "test": {
      "dependencies": [
        "test:packages",
        "test:ui-tools"
      ]
    },
    "test:browser": "deno task browser:embedded && deno test --parallel -A -c browser/deno.json browser/*.browser_test.ts",
    "test:browser:ui-hosting": "deno test -A -c browser/deno.json browser/ui_hosting.browser_test.ts",
    "test:browser:auth": "deno test -A -c browser/deno.json browser/console_login.browser_test.ts browser/cli_login.browser_test.ts browser/device_agent.browser_test.ts browser/consent_restart.browser_test.ts",
    "test:browser:console": "deno test --parallel -A -c browser/deno.json browser/console_services_devices.browser_test.ts browser/console_portals_grants.browser_test.ts browser/console_users_sessions.browser_test.ts browser/console_observability.browser_test.ts browser/console_navigation_permissions.browser_test.ts",
    "test:browser:functional": "deno task test:browser:auth && deno task test:browser:console",
    "test:browser:coverage": "TRELLIS_BROWSER_COVERAGE_SOURCEMAP=1 deno task browser:embedded && deno test -A -c browser/deno.json browser/*.browser_test.ts && deno task coverage:browser",
    "coverage:browser": "deno run -A tools/browser_v8_to_lcov.ts",
    "coverage:browser:merge": "deno run -A tools/browser_v8_to_lcov.ts --append-to ../coverage/live-integration/lcov.info",
    "trellis": "bash ../scripts/trellis-cli.sh"
  },
  "imports": {
    "@libsql/client": "npm:@libsql/client@^0.15.15",
    "@noble/hashes/hkdf": "npm:@noble/hashes@1.8.0/hkdf",
    "@noble/hashes/hmac": "npm:@noble/hashes@1.8.0/hmac",
    "@noble/hashes/sha256": "npm:@noble/hashes@1.8.0/sha256",
    "@hono/hono": "jsr:@hono/hono@^4.12.15",
    "@nats-io/jetstream": "npm:@nats-io/jetstream@^3.3.1",
    "@nats-io/jwt": "npm:@nats-io/jwt@^0.0.10-5",
    "@nats-io/kv": "npm:@nats-io/kv@^3.3.1",
    "@nats-io/obj": "npm:@nats-io/obj@^3.3.1",
    "@nats-io/nkeys": "npm:@nats-io/nkeys@^2.0.3",
    "@nats-io/nkeys/lib/codec.js": "npm:@nats-io/nkeys@^2.0.3/lib/codec.js",
    "@nats-io/nats-core": "npm:@nats-io/nats-core@^3.3.1",
    "@nats-io/nats-core/internal": "npm:@nats-io/nats-core@^3.3.1/internal",
    "@nats-io/transport-node": "npm:@nats-io/transport-node@^3.3.1",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.1",
    "@opentelemetry/context-async-hooks": "npm:@opentelemetry/context-async-hooks@^2.7.0",
    "@opentelemetry/core": "npm:@opentelemetry/core@^2.7.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "npm:@opentelemetry/exporter-metrics-otlp-proto@^0.215.0",
    "@opentelemetry/exporter-trace-otlp-proto": "npm:@opentelemetry/exporter-trace-otlp-proto@^0.215.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@^2.7.0",
    "@opentelemetry/sdk-metrics": "npm:@opentelemetry/sdk-metrics@^2.7.0",
    "@opentelemetry/sdk-trace-base": "npm:@opentelemetry/sdk-trace-base@^2.7.0",
    "@opentelemetry/sdk-trace-node": "npm:@opentelemetry/sdk-trace-node@^2.7.0",
    "@opentelemetry/sdk-trace-web": "npm:@opentelemetry/sdk-trace-web@^2.7.0",
    "@opentelemetry/semantic-conventions": "npm:@opentelemetry/semantic-conventions@^1.40.0",
    "@noble/curves/ed25519.js": "npm:@noble/curves@^2.0.1/ed25519.js",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.29/parse-args",
    "@std/collections": "jsr:@std/collections@^1.1.7",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@standard-schema/spec": "npm:@standard-schema/spec@^1.1.0",
    "@sveltejs/acorn-typescript": "npm:@sveltejs/acorn-typescript@^1.0.9",
    "@sveltejs/adapter-auto": "npm:@sveltejs/adapter-auto@^7.0.1",
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@3.0.10",
    "@sveltejs/kit": "npm:@sveltejs/kit@2.58.0",
    "@sveltejs/kit/": "./node_modules/@sveltejs/kit/",
    "@sveltejs/kit/internal": "./node_modules/@sveltejs/kit/src/exports/internal/index.js",
    "@sveltejs/kit/internal/server": "./node_modules/@sveltejs/kit/src/exports/internal/server.js",
    "@sveltejs/kit/vite": "npm:@sveltejs/kit@2.58.0/vite",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@7.0.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.4",
    "@types/cookie": "npm:@types/cookie@^1.0.0",
    "@types/node": "npm:@types/node@25.6.0",
    "trellis-web-generated": "../web/trellis/index.js",
    "acorn": "npm:acorn@^8.16.0",
    "clsx": "npm:clsx@2.1.1",
    "cookie": "npm:cookie@^1.1.1",
    "daisyui": "npm:daisyui@5.5.19/index.js",
    "devalue": "npm:devalue@^5.7.1",
    "diff": "npm:diff@^9.0.0",
    "lucide-svelte": "npm:lucide-svelte@^1.0.1",
    "esm-env": "npm:esm-env@^1.2.2",
    "json-schema-library": "npm:json-schema-library@^11.4.0",
    "js-sha256": "npm:js-sha256@^0.11.1",
    "jsonc-parser": "npm:jsonc-parser@^3.3.1",
    "graphology": "npm:graphology@^0.26.0",
    "graphology-layout-forceatlas2": "npm:graphology-layout-forceatlas2@^0.10.1",
    "kleur": "npm:kleur@^4.1.5",
    "magic-string": "npm:magic-string@^0.30.21",
    "mrmime": "npm:mrmime@^2.0.1",
    "pino": "npm:pino@^10.3.1",
    "playwright": "npm:playwright@1.59.1",
    "fake-indexeddb": "npm:fake-indexeddb@6.2.5",
    "fflate": "npm:fflate@^0.8.2",
    "serialize-error": "npm:serialize-error@^13.0.1",
    "set-cookie-parser": "npm:set-cookie-parser@^3.1.0",
    "sigma": "npm:sigma@^3.0.2",
    "sirv": "npm:sirv@^3.0.2",
    "svelte": "npm:svelte@5.55.5",
    "svelte-check": "npm:svelte-check@4.4.6",
    "svelteplot": "npm:svelteplot@0.14.2",
    "tailwindcss": "npm:tailwindcss@4.2.4",
    "tweetnacl": "npm:tweetnacl@^1.0.3",
    "ts-deepmerge": "npm:ts-deepmerge@^7.0.3",
    "type-fest": "npm:type-fest@^5.6.0",
    "typebox": "npm:typebox@^1.1.33",
    "typebox/error": "npm:typebox@^1.1.33/error",
    "typebox/value": "npm:typebox@^1.1.33/value",
    "typescript": "npm:typescript@6.0.3",
    "ulid": "npm:ulid@^3.0.2",
    "v8-to-istanbul": "npm:v8-to-istanbul@^9.3.0",
    "vite": "npm:vite@8.0.10",
    "zod": "npm:zod@^4.3.6",
    "@oatscenter/trellis": "./packages/trellis/index.ts",
    "@oatscenter/trellis/generated": "./packages/trellis/generated.ts",
    "@oatscenter/result": "./packages/result/mod.ts",
    "@oatscenter/trellis-svelte": "./packages/trellis-svelte/src/index.ts",
    "@oatscenter/trellis/auth": "./packages/trellis/auth.ts",
    "@oatscenter/trellis/auth/browser": "./packages/trellis/auth/browser.ts",
    "@oatscenter/trellis/device": "./packages/trellis/device.ts",
    "@oatscenter/trellis/service": "./packages/trellis/service/mod.ts",
    "@oatscenter/trellis/telemetry": "./packages/trellis/telemetry.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "exclude": [
      "packages/trellis-testkit/trellis",
      "packages/trellis-testkit/fixtures/authorization-trust",
      "packages/trellis/auth/protocol_wasm"
    ]
  },
  "lint": {
    "exclude": [
      "packages/trellis/auth/protocol_wasm"
    ],
    "rules": {
      "exclude": [
        "import-map-remap"
      ]
    }
  }
}
