import { auth, events, health, jobs, state } from trellis;

agent cli {
  use auth {
    capability roles.manage;
    capability users.manage;
    capability users.read;
    capability apis.accept;
    capability apis.forceReplace;
    capability clients.manage;
    capability sessions.read;
    capability sessions.revoke;
    capability platform.manage;
    required capability identities.read;
    required capability account.read;
  }
  use events {
    capability events.inspect;
    capability consumers.inspect;
    capability deadLetters.dismiss;
    capability deadLetters.inspect;
    capability deadLetters.replay;
    capability events.query;
  }
  use health { capability health.query; }
  use jobs { capability jobs.query; }
  use state {
    capability values.delete;
  }
}
