{
  "tasks": {
    "build": "deno run -A --frozen vite build",
    "build:embedded": "deno run -A scripts/build_embedded.ts",
    "check": "deno run -A --frozen svelte-check --tsconfig ./tsconfig.json",
    "dev": "deno run -A --frozen vite dev"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "dom.iterable", "deno.ns"]
  }
}
