{
  "name": "@trellis-demo/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "update": "trellis update",
    "generate": "trellis generate",
    "check": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.json && node -e \"require('node:fs').cpSync('trellis', 'build/service/trellis', {recursive: true})\"",
