import { fieldops } from service;

model SelectedSiteState { siteId: string; siteName: string; selectedAt: string; }
model DraftInspectionState { inspectionId: string; siteId: string; checklistName: string; notes: string; updatedAt: string; }

device Device {
  use fieldops {
    required capability assignmentsRead;
    required capability sitesRead;
    required capability evidenceRead;
    required capability sitesRefresh;
    required capability reportsGenerate;
    required capability evidenceUpload;
    required capability changesObserve;
  }
  state selectedSite { title "Selected site"; description "The active site."; schema SelectedSiteState; version 1; }
  kv draftInspections { title "Draft inspections"; description "Editable inspection drafts keyed by inspection id."; schema DraftInspectionState; version 1; history 1; ttl 0; }
}
