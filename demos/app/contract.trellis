import { fieldops } from service;

model InspectionContextState { siteId: string; note: string; updatedBy: string; updatedAt: string; }

app App {
  use fieldops {
    required capability assignmentsRead;
    required capability sitesRead;
    required capability evidenceRead;
    required capability evidenceDelete;
    required capability reportsRead;
    required capability sitesRefresh;
    required capability reportsGenerate;
    required capability evidenceUpload;
    required capability auditObserve;
  }
  state workspaceContext { title "Workspace context"; description "Current inspection workspace context."; schema InspectionContextState; version 1; }
}
