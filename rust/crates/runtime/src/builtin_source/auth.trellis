  TrellisSurfaceStatusResponsestatus3State,
  TrellisSurfaceStatusResponsestatus4,
  TrellisSurfaceStatusResponsestatus4State,
  TrellisSurfaceStatusResponsestatus5,
  TrellisSurfaceStatusResponsestatus5State,
} from types;

api auth@v1 {
  title "Trellis Auth";
  description "Authenticate Trellis principals and administer sessions, deployments, exact authority, devices, and login portals.";
  version "1.0.0";
  error AuthError(AuthErrorDetails);
  error UnexpectedError(AuthErrorDetails);
  error ValidationError(AuthErrorDetails);
  rpc Issuers.Revoke {
    input AuthIssuersRevokeRequest;
    output AuthIssuersRevokeResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  event Issuers.Revoked {
    payload AuthIssuersRevokedEvent;
  }
  rpc Participants.Install {
    input AuthParticipantsInstallRequest;
    output AuthParticipantsInstallResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Participants.Get {
    input AuthParticipantsGetRequest;
    output AuthParticipantsGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Participants.List {
    input AuthParticipantsListRequest;
    output AuthParticipantsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Deployments.Apply {
    input AuthDeploymentsApplyRequest;
    output AuthDeploymentsApplyResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Deployments.Get {
    input AuthDeploymentsGetRequest;
    output AuthDeploymentsGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Grants.Get {
    input AuthGrantsGetRequest;
    output AuthGrantsGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Grants.List {
    input AuthGrantsListRequest;
    output AuthGrantsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Grants.Set {
    input AuthGrantsSetRequest;
    output AuthGrantsMutationResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Grants.Revoke {
    input AuthGrantsRevokeRequest;
    output AuthGrantsMutationResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  event Grants.Changed {
    payload AuthGrantsChangedEvent;
  }
  rpc Capabilities.List {
    input AuthCapabilitiesListRequest;
    output AuthCapabilitiesListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc CapabilityGroups.Delete {
    input AuthCapabilityGroupsDeleteRequest;
    output AuthCapabilityGroupsDeleteResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc CapabilityGroups.Get {
    input AuthCapabilityGroupsGetRequest;
    output AuthCapabilityGroupsGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc CapabilityGroups.List {
    input AuthCapabilityGroupsListRequest;
    output AuthCapabilityGroupsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc CapabilityGroups.Put {
    input AuthCapabilityGroupsPutRequest;
    output AuthCapabilityGroupsPutResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Connections.Kick {
    input AuthConnectionsKickRequest;
    output AuthConnectionsKickResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Connections.List {
    input AuthConnectionsListRequest;
    output AuthConnectionsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Deployments.Create {
    input AuthDeploymentsCreateRequest;
    output AuthDeploymentsCreateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Deployments.Disable {
    input AuthDeploymentsDisableRequest;
    output AuthDeploymentsDisableResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Deployments.Enable {
    input AuthDeploymentsEnableRequest;
    output AuthDeploymentsEnableResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Deployments.List {
    input AuthDeploymentsListRequest;
    output AuthDeploymentsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Deployments.Remove {
    input AuthDeploymentsRemoveRequest;
    output AuthDeploymentsRemoveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc DeviceUserAuthorities.List {
    input AuthDeviceUserAuthoritiesListRequest;
    output AuthDeviceUserAuthoritiesListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc DeviceUserAuthorities.Reviews.Decide {
    input AuthDeviceUserAuthoritiesReviewsDecideRequest;
    output AuthDeviceUserAuthoritiesReviewsDecideResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc DeviceUserAuthorities.Reviews.List {
    input AuthDeviceUserAuthoritiesReviewsListRequest;
    output AuthDeviceUserAuthoritiesReviewsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc DeviceUserAuthorities.Revoke {
    input AuthDeviceUserAuthoritiesRevokeRequest;
    output AuthDeviceUserAuthoritiesRevokeResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Devices.Disable {
    input AuthDevicesDisableRequest;
    output AuthDevicesDisableResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Devices.Enable {
    input AuthDevicesEnableRequest;
    output AuthDevicesEnableResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Devices.List {
    input AuthDevicesListRequest;
    output AuthDevicesListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Devices.Provision {
    input AuthDevicesProvisionRequest;
    output AuthDevicesProvisionResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Devices.Remove {
    input AuthDevicesRemoveRequest;
    output AuthDevicesRemoveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.Get {
    input AuthPortalsGetRequest;
    output AuthPortalsGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.GrantOverrides.List {
    input AuthPortalsGrantOverridesListRequest;
    output AuthPortalsGrantOverridesListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Portals.GrantOverrides.Put {
    input AuthPortalsGrantOverridesPutRequest;
    output AuthPortalsGrantOverridesPutResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.GrantOverrides.Remove {
    input AuthPortalsGrantOverridesRemoveRequest;
    output AuthPortalsGrantOverridesRemoveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.List {
    input AuthPortalsListRequest;
    output AuthPortalsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Portals.LoginSettings.Get {
    input AuthPortalsLoginSettingsGetRequest;
    output AuthPortalsLoginSettingsGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.LoginSettings.Update {
    input AuthPortalsLoginSettingsUpdateRequest;
    output AuthPortalsLoginSettingsUpdateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.Put {
    input AuthPortalsPutRequest;
    output AuthPortalsPutResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.Remove {
    input AuthPortalsRemoveRequest;
    output AuthPortalsRemoveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.Routes.Put {
    input AuthPortalsRoutesPutRequest;
    output AuthPortalsRoutesPutResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Portals.Routes.Remove {
    input AuthPortalsRoutesRemoveRequest;
    output AuthPortalsRoutesRemoveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc ServiceInstances.Disable {
    input AuthServiceInstancesDisableRequest;
    output AuthServiceInstancesDisableResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc ServiceInstances.Enable {
    input AuthServiceInstancesEnableRequest;
    output AuthServiceInstancesEnableResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc ServiceInstances.List {
    input AuthServiceInstancesListRequest;
    output AuthServiceInstancesListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc ServiceInstances.Provision {
    input AuthServiceInstancesProvisionRequest;
    output AuthServiceInstancesProvisionResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc ServiceInstances.Remove {
    input AuthServiceInstancesRemoveRequest;
    output AuthServiceInstancesRemoveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Sessions.List {
    input AuthSessionsListRequest;
    output AuthSessionsListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Sessions.Logout {
    input AuthSessionsLogoutRequest;
    output AuthSessionsLogoutResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Sessions.Me {
    input AuthSessionsMeRequest;
    output AuthSessionsMeResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Sessions.Revoke {
    input AuthSessionsRevokeRequest;
    output AuthSessionsRevokeResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc UserIdentities.List {
    input AuthUserIdentitiesListRequest;
    output AuthUserIdentitiesListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc UserIdentities.Unlink {
    input AuthUserIdentitiesUnlinkRequest;
    output AuthUserIdentitiesUnlinkResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.Create {
    input AuthUsersCreateRequest;
    output AuthUsersCreateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.Get {
    input AuthUsersGetRequest;
    output AuthUsersGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.IdentityLink.Create {
    input AuthUsersIdentityLinkCreateRequest;
    output AuthUsersIdentityLinkCreateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.List {
    input AuthUsersListRequest;
    output AuthUsersListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Users.Password.Change {
    input AuthUsersPasswordChangeRequest;
    output AuthUsersPasswordChangeResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.PasswordReset.Create {
    input AuthUsersPasswordResetCreateRequest;
    output AuthUsersPasswordResetCreateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.Resolve {
    input AuthUsersResolveRequest;
    output AuthUsersResolveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc Users.Update {
    input AuthUsersUpdateRequest;
    output AuthUsersUpdateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  operation DeviceUserAuthorities.Resolve {
    input AuthDeviceUserAuthoritiesResolveRequest;
    output AuthDeviceUserAuthoritiesResolveResponse;
    progress AuthDeviceUserAuthoritiesResolveProgress;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  event Connections.Closed {
    payload AuthConnectionsClosedEvent;
  }
  event Connections.Kicked {
    payload AuthConnectionsKickedEvent;
  }
  event Connections.Opened {
    payload AuthConnectionsOpenedEvent;
  }
  event DeviceUserAuthorities.Approved {
    payload AuthDeviceUserAuthoritiesApprovedEvent;
    params [deploymentId];
  }
  event DeviceUserAuthorities.Requested {
    payload AuthDeviceUserAuthoritiesRequestedEvent;
    params [deploymentId];
  }
  event DeviceUserAuthorities.Resolved {
    payload AuthDeviceUserAuthoritiesResolvedEvent;
    params [deploymentId];
  }
  event DeviceUserAuthorities.ReviewRequested {
    payload AuthDeviceUserAuthoritiesReviewRequestedEvent;
    params [deploymentId];
  }
  event Sessions.Revoked {
    payload AuthSessionsRevokedEvent;
  }
  capabilities {
    public {
      allows { publish event Issuers.Revoked; subscribe event Issuers.Revoked; publish event Grants.Changed; subscribe event Grants.Changed; rpc Sessions.Logout; rpc Sessions.Me; rpc UserIdentities.List; rpc UserIdentities.Unlink; rpc Users.IdentityLink.Create; rpc Users.Password.Change; operation DeviceUserAuthorities.Resolve; publish event Connections.Closed; publish event Connections.Kicked; publish event Connections.Opened; publish event DeviceUserAuthorities.Approved; publish event DeviceUserAuthorities.Requested; publish event DeviceUserAuthorities.Resolved; publish event DeviceUserAuthorities.ReviewRequested; publish event Sessions.Revoked; }
    }
    capability authorities_mutate {
      title "Authorities Mutate";
      description "Allows authorities mutate.";
      consequence "The caller can use authorities mutate.";
      allows { rpc Issuers.Revoke; rpc Participants.Install; rpc Deployments.Apply; rpc Grants.Set; rpc Grants.Revoke; rpc CapabilityGroups.Delete; rpc CapabilityGroups.Put; }
    }
    capability authorities_read {
      title "Authorities Read";
      description "Allows authorities read.";
      consequence "The caller can use authorities read.";
      allows { rpc Participants.Get; rpc Participants.List; rpc Grants.Get; rpc Grants.List; }
    }
    capability capabilities_read {
      title "Capabilities Read";
      description "Allows capabilities read.";
      consequence "The caller can use capabilities read.";
      allows { rpc Capabilities.List; rpc CapabilityGroups.Get; rpc CapabilityGroups.List; }
    }
    capability connections_kick {
      title "Connections Kick";
      description "Allows connections kick.";
      consequence "The caller can use connections kick.";
      allows { rpc Connections.Kick; }
    }
    capability connections_read {
      title "Connections Read";
      description "Allows connections read.";
      consequence "The caller can use connections read.";
      allows { rpc Connections.List; }
    }
    capability deployments_mutate {
      title "Deployments Mutate";
      description "Allows deployments mutate.";
      consequence "The caller can use deployments mutate.";
      allows { rpc Deployments.Create; rpc Deployments.Disable; rpc Deployments.Enable; rpc Deployments.Remove; }
    }
    capability deployments_read {
      title "Deployments Read";
      description "Allows deployments read.";
      consequence "The caller can use deployments read.";
      allows { rpc Deployments.Get; rpc Deployments.List; }
    }
    capability devices_mutate {
      title "Devices Mutate";
      description "Allows devices mutate.";
      consequence "The caller can use devices mutate.";
      allows { rpc DeviceUserAuthorities.Revoke; rpc Devices.Disable; rpc Devices.Enable; rpc Devices.Provision; rpc Devices.Remove; }
    }
    capability devices_read {
      title "Devices Read";
      description "Allows devices read.";
      consequence "The caller can use devices read.";
      allows { rpc DeviceUserAuthorities.List; rpc Devices.List; }
    }
    capability devices_review {
      title "Devices Review";
      description "Allows devices review.";
      consequence "The caller can use devices review.";
      allows { rpc DeviceUserAuthorities.Reviews.Decide; rpc DeviceUserAuthorities.Reviews.List; }
    }
    capability events_stream {
      title "Events Stream";
      description "Allows events stream.";
      consequence "The caller can use events stream.";
      allows { subscribe event Connections.Closed; subscribe event Connections.Kicked; subscribe event Connections.Opened; subscribe event DeviceUserAuthorities.Approved; subscribe event DeviceUserAuthorities.Requested; subscribe event DeviceUserAuthorities.Resolved; subscribe event DeviceUserAuthorities.ReviewRequested; subscribe event Sessions.Revoked; }
    }
    capability portals_mutate {
      title "Portals Mutate";
      description "Allows portals mutate.";
      consequence "The caller can use portals mutate.";
      allows { rpc Portals.GrantOverrides.Put; rpc Portals.GrantOverrides.Remove; rpc Portals.LoginSettings.Update; rpc Portals.Put; rpc Portals.Remove; rpc Portals.Routes.Put; rpc Portals.Routes.Remove; }
    }
    capability portals_read {
      title "Portals Read";
      description "Allows portals read.";
      consequence "The caller can use portals read.";
      allows { rpc Portals.Get; rpc Portals.GrantOverrides.List; rpc Portals.List; rpc Portals.LoginSettings.Get; }
    }
    capability services_mutate {
      title "Services Mutate";
      description "Allows services mutate.";
      consequence "The caller can use services mutate.";
      allows { rpc ServiceInstances.Disable; rpc ServiceInstances.Enable; rpc ServiceInstances.Provision; rpc ServiceInstances.Remove; }
    }
    capability services_read {
      title "Services Read";
      description "Allows services read.";
      consequence "The caller can use services read.";
      allows { rpc ServiceInstances.List; }
    }
    capability sessions_read {
      title "Sessions Read";
      description "Allows sessions read.";
      consequence "The caller can use sessions read.";
      allows { rpc Sessions.List; }
    }
    capability sessions_revoke {
      title "Sessions Revoke";
      description "Allows sessions revoke.";
      consequence "The caller can use sessions revoke.";
      allows { rpc Sessions.Revoke; }
    }
    capability users_mutate {
      title "Users Mutate";
      description "Allows users mutate.";
      consequence "The caller can use users mutate.";
      allows { rpc Users.Create; rpc Users.PasswordReset.Create; rpc Users.Update; }
    }
    capability users_read {
      title "Users Read";
      description "Allows users read.";
      consequence "The caller can use users read.";
      allows { rpc Users.Get; rpc Users.List; rpc Users.Resolve; }
    }
  }
}
