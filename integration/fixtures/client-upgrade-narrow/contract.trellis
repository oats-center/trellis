model Value { value: string; }
api upgrade@v1 {
  title "Client upgrade acceptance";
  description "Stable API with changing app requirements.";
  rpc Echo { input Value; output Value; }
  rpc Extra { input Value; output Value; }
  capabilities {
    capability documents.read { title "Read documents"; description "Read fixture documents."; grants "The caller may read documents through Echo and Extra."; allows { rpc Echo; rpc Extra; } }
    capability echo.call { title "Echo"; description "Read through Echo only."; grants "The caller may invoke Echo."; allows { rpc Echo; } }
  }
}
service Provider { implements upgrade; }
agent Caller {
  use upgrade { required capability echo.call; }
}
app BrowserCaller {
  use upgrade { required capability echo.call; }
}
