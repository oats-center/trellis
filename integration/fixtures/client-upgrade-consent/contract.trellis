model Value { value: string; }
api upgrade@v1 {
  title "Client upgrade acceptance";
  description "Stable API with changing app requirements.";
  rpc Echo { input Value; output Value; }
  rpc Extra { input Value; output Value; }
  capabilities {
    capability read_documents {
      title "Read documents";
      description "Approve the revised usage terms for these document reads.";
      consequence "The caller can read documents under the revised usage terms.";
      consent_revision 2;
      allows { rpc Echo; rpc Extra; }
    }
    capability echo { title "Echo"; description "Read through Echo only."; consequence "The caller may invoke Echo."; consent_revision 1; allows { rpc Echo; } }
  }
}
service Provider { implements upgrade; }
app Caller {
  use upgrade { required capability read_documents; }
}
