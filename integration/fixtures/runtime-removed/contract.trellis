import { auth } from trellis;

model Value { value: string; }
model Empty {}
model Saved { value: string; }
model Sample { site: string; value: string; }
model Observed { values: list<string>; }
model ResourceValue { value: string; }

api runtime@v1 {
  title "Runtime acceptance";
  description "Small generated transport and durability fixture.";
  rpc Echo { input Value; output Value; }
  operation Work { input Value; output Value; }
  operation Upload { input Value; output Value; upload; }
  event Changed { payload Value; }
  live Watch { input Empty; event Value; }
  capabilities { public { allows { rpc Echo; operation Work; operation Upload; publish event Changed; subscribe event Changed; live Watch; } } }
}

api events@v1 {
  title "Durable event acceptance";
  description "Distinct publisher authority on one consumer.";
  event Alpha { payload Sample; }
  event Beta { payload Sample; }
  rpc Observed { input Empty; output Observed; }
  rpc DropAlpha { input Empty; output Empty; }
  capabilities { public { allows { publish event Alpha; publish event Beta; subscribe event Alpha; subscribe event Beta; rpc Observed; rpc DropAlpha; } } }
}

service Provider { implements runtime; }
app Caller {
  use runtime { rpc Echo; operation Work; operation Upload; publish event Changed; subscribe event Changed; live Watch; }
}
app Denied { use runtime; }
service AdminService { use auth { rpc Grants.Get; rpc Grants.Revoke; rpc Sessions.List; } }
service EventService { implements events; }
app Alpha { use events { publish event Alpha; rpc Observed; rpc DropAlpha; } }
app Beta { use events { publish event Beta; } }
