import { auth } from trellis;

model Value { value: string; }
model UpdateDetail { count: int64; payload: bytes; }
model Update { value: string; nested: UpdateDetail; }
model Empty {}
model Saved { value: string; }
model Sample { site: string; value: string; }
model Observed { values: list<string>; }
model ResourceValue { value: string; }

api runtime@v1 {
  title "Runtime acceptance";
  description "Small generated transport and durability fixture.";
  rpc Echo { input Value; output Value; }
  rpc Download { input Value; output Value; download; }
  operation Work { input Value; progress Update; output Value; signals { Continue Value; } }
  operation Upload { input Value; output Value; signals { Continue Value; } upload; }
  operation Ingest { input Value; output Value; stream; }
  rpc Generate { input Value; output Value; download; }
  event Changed { payload Value; }
  live Watch { input Empty; event Value; }
  capabilities {
    capability transfers.transport { title "Transport"; description "Exercise the runtime transport surfaces."; grants "The caller may invoke and observe the fixture transports."; allows { rpc Echo; operation Work; operation Upload; operation Ingest; publish event Changed; subscribe event Changed; live Watch; } }
    capability echo.call { title "Echo"; description "Invoke the echo RPC."; grants "The caller may echo values."; allows { rpc Echo; } }
    capability operations.work { title "Work"; description "Execute the work operation."; grants "The caller may execute and control work."; allows { operation Work; } }
    capability transfers.download { title "Download"; description "Download a fixture value."; grants "The caller may download values."; allows { rpc Download; rpc Generate; } }
  }
}

api events@v1 {
  title "Durable event acceptance";
  description "Distinct publisher authority on one consumer.";
  event Alpha { payload Sample; }
  event Beta { payload Sample; }
  rpc Observed { input Empty; output Observed; }
  rpc DropAlpha { input Empty; output Empty; }
  capabilities {
    capability alpha.publish { title "Publish Alpha"; description "Publish Alpha samples."; grants "The caller may publish Alpha."; allows { publish event Alpha; } }
    capability beta.publish { title "Publish Beta"; description "Publish Beta samples."; grants "The caller may publish Beta."; allows { publish event Beta; } }
    capability events.inspect { title "Inspect delivery"; description "Read observed samples."; grants "The caller may inspect delivery results."; allows { rpc Observed; } }
    capability alpha.drop { title "Drop Alpha"; description "Close the Alpha fixture subscription."; grants "The caller may stop Alpha observation."; allows { rpc DropAlpha; } }
  }
}

service Provider { implements runtime; }
service ResourceProvider {}
agent Caller {
  use runtime { required capability transfers.transport; }
}
app Denied { use runtime; }
service AdminService { use auth { required capability roles.manage; required capability users.manage; } }
service EventService { implements events; }
app Alpha { use events { required capability alpha.publish; required capability events.inspect; required capability alpha.drop; } }
app Beta { use events { required capability beta.publish; } }
