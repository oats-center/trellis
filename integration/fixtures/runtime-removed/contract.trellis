import { auth } from trellis;

model Value { value: string; }
model Empty {}
model Saved { value: string; }
model Sample { site: string; value: string; }
model Observed { values: list<string>; }
model ResourceValue { value: string; }

api runtime@v1 {
  title "Runtime acceptance";
  description "Small generated transport and durability fixture.";
  rpc Echo { input Value; output Value; }
  operation Work { input Value; output Value; }
  operation Upload { input Value; output Value; upload; }
  event Changed { payload Value; }
  live Watch { input Empty; event Value; }
  capabilities { capability transport { title "Transport"; description "Exercise the runtime transport surfaces."; consequence "The caller may invoke and observe the fixture transports."; consent_revision 1; allows { rpc Echo; operation Work; operation Upload; publish event Changed; subscribe event Changed; live Watch; } } }
}

api events@v1 {
  title "Durable event acceptance";
  description "Distinct publisher authority on one consumer.";
  event Alpha { payload Sample; }
  event Beta { payload Sample; }
  rpc Observed { input Empty; output Observed; }
  rpc DropAlpha { input Empty; output Empty; }
  capabilities {
    capability publishAlpha { title "Publish Alpha"; description "Publish Alpha samples."; consequence "The caller may publish Alpha."; consent_revision 1; allows { publish event Alpha; } }
    capability publishBeta { title "Publish Beta"; description "Publish Beta samples."; consequence "The caller may publish Beta."; consent_revision 1; allows { publish event Beta; } }
    capability inspect { title "Inspect delivery"; description "Read observed samples."; consequence "The caller may inspect delivery results."; consent_revision 1; allows { rpc Observed; } }
    capability dropAlpha { title "Drop Alpha"; description "Close the Alpha fixture subscription."; consequence "The caller may stop Alpha observation."; consent_revision 1; allows { rpc DropAlpha; } }
  }
}

service Provider { implements runtime; }
app Caller {
  use runtime { required capability transport; }
}
app Denied { use runtime; }
service AdminService { use auth { required capability capabilityGrantsRead; required capability capabilityGrantsRevoke; required capability authorizationSessionsRead; } }
service EventService { implements events; }
app Alpha { use events { required capability publishAlpha; required capability inspect; required capability dropAlpha; } }
app Beta { use events { required capability publishBeta; } }
