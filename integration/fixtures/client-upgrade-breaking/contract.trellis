model Value { value: string; revision: uint32; }
api upgrade@v1 {
  title "Client upgrade acceptance";
  description "Changed wire contract for an already-open browser.";
  rpc Echo { input Value; output Value; }
  rpc Extra { input Value; output Value; }
  capabilities {
    capability documents.read { title "Read documents"; description "Read revisioned fixture documents."; consequence "The caller may read revisioned documents through Echo and Extra."; consent_revision 3; allows { rpc Echo; rpc Extra; } }
    capability echo.call { title "Echo"; description "Read revisioned values through Echo only."; consequence "The caller may invoke revisioned Echo."; consent_revision 2; allows { rpc Echo; } }
  }
}
service Provider { implements upgrade; }
agent Caller {
  use upgrade { required capability documents.read; }
}
app BrowserCaller {
  use upgrade { required capability documents.read; }
}
