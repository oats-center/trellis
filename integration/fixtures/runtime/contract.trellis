import { auth, events as eventlog, health, jobs } from trellis;

model Value { value: string; }
model UpdateDetail { count: int64; payload: bytes; }
model Update { value: string; nested: UpdateDetail; }
model Empty {}
model Saved { value: string; }
model Sample { site: string; value: string; }
model Observed { values: list<string>; }
model DeliveryStats { attempts: list<int64>; active: int64; maxActive: int64; successes: list<string>; }
model KeyedValue { key: string; value: string; }
model ResourceValue { value: string; }

api documents@v1 {
  title "Live application major one";
  description "A versioned application API using the shared Live protocol.";
  live Watch { input Value; event Value; }
  live List.Watch { input Value; event Value; }
  rpc Echo { input Value; output Value; }
  capabilities {
    capability read { title "Read live documents"; description "Observe the first application major."; consequence "The caller can observe version-one values."; consent_revision 1; allows { live Watch; live List.Watch; rpc Echo; } }
  }
}
service LiveV1Provider { implements documents; }
agent LiveV1Caller { use documents { required capability read; } }

api runtime@v1 {
  title "Runtime acceptance";
  description "Small generated transport and durability fixture.";
  rpc Echo { input Value; output Value; }
  rpc Download { input Value; output Value; download; }
  operation Work { input Value; progress Update; output Value; signals { Continue Value; } }
  operation Upload { input Value; output Value; signals { Continue Value; } upload; }
  operation Ingest { input Value; output Value; stream; }
  rpc Generate { input Value; output Value; download; }
  event Changed { payload Value; }
  live Watch { input Empty; event Value; }
  capabilities {
    capability transport { title "Transport"; description "Exercise the runtime transport surfaces."; consequence "The caller may invoke and observe the fixture transports."; consent_revision 1; allows { rpc Echo; operation Work; operation Upload; operation Ingest; publish event Changed; subscribe event Changed; live Watch; } }
    capability echo { title "Echo"; description "Invoke the echo RPC."; consequence "The caller may echo values."; consent_revision 1; allows { rpc Echo; } }
    capability work { title "Work"; description "Execute the work operation."; consequence "The caller may execute and control work."; consent_revision 1; allows { operation Work; } }
    capability download { title "Download"; description "Download a fixture value."; consequence "The caller may download values."; consent_revision 1; allows { rpc Download; rpc Generate; } }
  }
}

api events@v1 {
  title "Durable event acceptance";
  description "Distinct publisher authority on one consumer.";
  event Alpha { payload Sample; }
  event Beta { payload Sample; }
  rpc Observed { input Empty; output Observed; }
  rpc DropAlpha { input Empty; output Empty; }
  rpc DeliveryStats { input Empty; output DeliveryStats; }
  capabilities {
    capability publishAlpha { title "Publish Alpha"; description "Publish Alpha samples."; consequence "The caller may publish Alpha."; consent_revision 1; allows { publish event Alpha; } }
    capability publishBeta { title "Publish Beta"; description "Publish Beta samples."; consequence "The caller may publish Beta."; consent_revision 1; allows { publish event Beta; } }
    capability subscribeAlpha { title "Subscribe Alpha"; description "Observe Alpha samples."; consequence "The caller may subscribe to Alpha."; consent_revision 1; allows { subscribe event Alpha; } }
    capability subscribeBeta { title "Subscribe Beta"; description "Observe Beta samples."; consequence "The caller may subscribe to Beta."; consent_revision 1; allows { subscribe event Beta; } }
    capability inspect { title "Inspect delivery"; description "Read observed samples and delivery statistics."; consequence "The caller may inspect delivery results."; consent_revision 1; allows { rpc Observed; rpc DeliveryStats; } }
    capability dropAlpha { title "Drop Alpha"; description "Close the Alpha fixture subscription."; consequence "The caller may stop Alpha observation."; consent_revision 1; allows { rpc DropAlpha; } }
  }
}

api device_child@v1 {
  title "Device companion acceptance";
  description "Required and optional companion authority.";
  rpc Required { input Empty; output Empty; }
  rpc Optional { input Empty; output Empty; }
  capabilities {
    capability required {
      title "Required";
      description "Required child operation.";
      consequence "The child can invoke its required operation.";
      consent_revision 1;
      allows { rpc Required; }
    }
    capability optional {
      title "Optional";
      description "Optional child operation.";
      consequence "The child can invoke its optional operation.";
      consent_revision 1;
      allows { rpc Optional; }
    }
  }
}

service Provider {
  implements runtime;
  use runtime {
    required capability echo;
    required capability work;
  }
  job work {
    title "Work";
    description "Runtime fixture work.";
    payload Value;
    result Value;
    update Update;
    deadline 5s;
    retry { attempts 2; backoff [250ms]; }
  }
  job keyedWork { title "Keyed work"; description "Runtime keyed queue acceptance."; payload KeyedValue; result KeyedValue; key_concurrency { path key; policy queue; } }
  job replayWork { title "Replay work"; description "Keyed retry and dead-letter replay acceptance."; payload Value; result Value; retry { attempts 2; backoff [250ms]; } key_concurrency { path value; policy queue; } }
  job preStartedWork { title "Pre-started work"; description "Key acquisition crash recovery."; payload KeyedValue; result KeyedValue; deadline 5s; key_concurrency { path key; policy queue; } }
  kv records { title "Records"; description "Rust KV acceptance values."; schema ResourceValue; version 1; history 4; ttl 0ms; }
  kv optional extras { title "Extras"; description "Optional Rust KV acceptance values approved after connect."; schema ResourceValue; version 1; history 4; ttl 0ms; }
  store files { title "Files"; description "Runtime fixture transfer files."; ttl 0; desired_max_object 1MiB; desired_max_total 8MiB; }
  store archive { title "Archive"; description "Runtime fixture secondary transfer destination."; ttl 0; desired_max_object 1MiB; desired_max_total 8MiB; }
  consumer changes { title "Changes"; description "Runtime fixture durable changes."; events [runtime.Changed]; concurrency 1; replay new; }
}
service EchoProvider { implements runtime; }
service TransferGrowthProvider {
  implements runtime;
  use transport_growth { capability extend; }
  store files { title "Files"; description "Transfer acceptance bytes across authority growth."; ttl 0; desired_max_object 8MiB; desired_max_total 16MiB; }
}
service OrdinaryJobs {
  job work { title "Work"; description "Ordinary queue cancellation"; payload Value; result Value; }
}
agent JobEvidenceReader { use auth { required capability jobResourceBindingsRead; } }
agent DirectoryCaller {
  use auth {
    required capability usersRead;
    required capability accountRead;
    required capability accountProfileWrite;
    required capability usersCreate;
    required capability usersUpdate;
  }
}
agent DirectoryOptional {
  use auth { required capability accountRead; capability usersRead; }
}
agent AccountCaller { use auth { required capability accountRead; } }
agent EventEvidenceReader { use auth { required capability eventResourceBindingsRead; } }
api optional_availability@v2 {
  title "Optional operation availability";
  description "Native clients use approved optional operations without legacy atom grants.";
  rpc Read { input Value; output Value; }
  operation Extend { input Value; update Value; output Value; signals { Continue Value; } }
  capabilities {
    capability read { title "Read"; description "Read fixture values."; consequence "The caller may read values."; consent_revision 1; allows { rpc Read; } }
    capability extend { title "Extend"; description "Execute the optional operation."; consequence "The caller may extend values."; consent_revision 1; allows { operation Extend; } }
  }
}
service NativeOptionalProvider { implements optional_availability; }
agent NativeOptionalExtend { use optional_availability { required capability read; capability extend; } }
service ResourceProvider {
  kv records { title "Records"; description "Console resource lifecycle acceptance values."; schema ResourceValue; version 1; history 4; ttl 0ms; }
}
service OperationProvider {
  implements runtime;
  job keyedWork { title "Keyed work"; description "Rust keyed queue acceptance."; payload KeyedValue; result KeyedValue; key_concurrency { path key; policy queue; } }
}
service OperationCaller { use runtime { required capability work; } }
agent EchoCaller { use runtime { required capability echo; } }
agent Observer {
  use health { required capability observe; required capability inspect; }
  use jobs { required capability observe; required capability summary; }
  use eventlog { required capability observe; required capability query; }
}
agent TransferCaller { use runtime { required capability transport; required capability download; } }
agent Caller {
  use runtime { required capability transport; required capability download; }
  state saved { title "Saved"; description "Caller-owned saved value."; schema Saved; version 1; }
  state savedResource { title "Saved resource"; description "Rust State acceptance value."; schema ResourceValue; version 1; }
}
app StateCaller {
  state savedResource { title "Saved resource"; description "Rust State acceptance value."; schema ResourceValue; version 1; }
}
agent NativeStateCaller {
  state savedResource { title "Saved resource"; description "Native State acceptance value."; schema ResourceValue; version 1; }
}
agent Denied { use runtime; }
agent JobsAdmin { use jobs { required capability query; required capability inspect; required capability keyLookup; required capability retry; required capability dlqReplay; required capability listServices; } }
service AdminService {
  use auth {
    required capability deploymentsRead;
    required capability capabilityGrantsRead;
    required capability capabilityGrantsRevoke;
    required capability authorizationSessionsRead;
  }
}
service EventService {
  implements events;
  consumer events { title "Events"; description "Durable event acceptance values."; events [events.Alpha, events.Beta]; concurrency 1; replay new; retry { attempts 3; backoff [150ms, 300ms]; } }
}
service EventServiceConsumerOnly {
  implements events;
  consumer events { title "Events"; description "Durable-only event acceptance values."; events [events.Alpha, events.Beta]; concurrency 1; replay new; }
}
service EventServiceBoth {
  implements events;
  use events { required capability subscribeAlpha; required capability subscribeBeta; }
  consumer events { title "Events"; description "Durable plus explicit subscribe acceptance values."; events [events.Alpha, events.Beta]; concurrency 1; replay new; }
}
service EventSubscriberService {
  implements events;
  use events { required capability subscribeAlpha; required capability subscribeBeta; }
}
service EventClient {
  use events {
    required capability publishAlpha;
    required capability subscribeBeta;
  }
}
service ChildProvider { implements device_child; }
agent Alpha { use events { required capability publishAlpha; required capability inspect; required capability dropAlpha; } }
agent Beta { use events { required capability publishBeta; } }
device Device {
  state telemetry { title "Telemetry"; description "Device-owned State acceptance value."; schema ResourceValue; version 1; }
  agent Companion {
    state shared { title "Shared"; description "Same-user companion State acceptance value."; schema ResourceValue; version 1; }
    use auth { required capability deviceCompanionsManage; }
    use device_child {
      required capability required;
      capability optional;
    }
  }
}
device StateDevice {
  state telemetry { title "Telemetry"; description "Device State without a companion"; schema ResourceValue; version 1; }
}
device AgentDevice {
  agent Companion {
    use auth { required capability deviceCompanionsManage; }
    use device_child {
      required capability required;
      capability optional;
    }
  }
}

model LiveProbeKey {
  runId: string;
  streamId: string;
}

model LiveProbeRelease {
  runId: string;
  streamId: string;
  throughIndex: int64;
  finish: bool;
  fail: bool;
  payloadBytes?: uint32;
  paddingBytes?: uint32;
}

model LiveProbeFrame {
  runId: string;
  streamId: string;
  sourceGeneration: int64;
  index: int64;
  payload: bytes;
  padding: string;
}

model LiveProbeStatus {
  starts: int64;
  active: int64;
  cleanups: int64;
  emitted: int64;
}

api liveprobe@v1 {
  title "Live observation acceptance";
  description "Case-owned source control and observed source lifetime.";
  rpc Inspect { input LiveProbeKey; output LiveProbeStatus; }
  rpc Release { input LiveProbeRelease; output LiveProbeStatus; }
  live Watch { input LiveProbeKey; event LiveProbeFrame; }
  capabilities { capability observe { title "Observe"; description "Control and observe the live fixture."; consequence "The caller may inspect, release, and watch live probes."; consent_revision 1; allows { rpc Inspect; rpc Release; live Watch; } } }
}

service LiveProbeProvider { implements liveprobe; }

agent LiveProbeCaller {
  use liveprobe { required capability observe; }
}

api transport_growth@v1 {
  title "Capability growth acceptance";
  description "Optional-capability growth on one live service attachment.";
  rpc Advance { input Empty; output Empty; }
  rpc Nudge { input Empty; output Empty; }
  rpc Extend { input Empty; output Empty; }
  rpc Extend2 { input Empty; output Empty; }
  rpc Park { input Empty; output Value; }
  event Tick { payload Value; }
  operation Hold { input Empty; progress Update; output Value; signals { Continue Value; } }
  live Progress { input Empty; event Value; }
  capabilities {
    capability advance { title "Advance"; description "Advance the fixture."; consequence "The caller may advance work."; consent_revision 1; allows { rpc Advance; } }
    capability control { title "Control"; description "Control the fixture attachment."; consequence "The caller may nudge or park the attachment."; consent_revision 1; allows { rpc Nudge; rpc Park; } }
    capability hold { title "Hold"; description "Execute held work."; consequence "The caller may execute and observe held work."; consent_revision 1; allows { operation Hold; } }
    capability progress { title "Progress"; description "Observe live progress."; consequence "The caller may observe progress."; consent_revision 1; allows { live Progress; } }
    capability publishTick { title "Publish Tick"; description "Publish fixture ticks."; consequence "The caller may publish ticks."; consent_revision 1; allows { publish event Tick; } }
    capability extend {
      title "Optional capability";
      description "Optional growth operation.";
      consequence "The subject can invoke its optional operation.";
      consent_revision 1;
      allows { rpc Extend; }
    }
    capability extend2 {
      title "Second optional capability";
      description "Second optional growth operation.";
      consequence "The subject can invoke its second optional operation.";
      consent_revision 1;
      allows { rpc Extend2; }
    }
  }
}

api probe_aux@v1 {
  title "Auxiliary live route";
  description "A second live route served on one service attachment.";
  live Pulse { input Empty; event Value; }
  capabilities { capability observe { title "Observe"; description "Observe the auxiliary route."; consequence "The caller may observe auxiliary pulses."; consent_revision 1; allows { live Pulse; } } }
}

api finite@v1 {
  title "Finite response acceptance";
  description "Accepted requests completing across ordinary authority renewal.";
  error Rejected(Value);
  rpc HoldSuccess { input Value; output Value; errors [Rejected]; }
  rpc HoldDeclared { input Value; output Value; errors [Rejected]; }
  rpc HoldCancelled { input Value; output Value; errors [Rejected]; }
  rpc HoldDeadline { input Value; output Value; errors [Rejected]; }
  capabilities {
    capability invoke {
      title "Wait for a result";
      description "Execute the finite response fixture.";
      consequence "The caller may receive a success or declared failure.";
      consent_revision 1;
      allows { rpc HoldSuccess; rpc HoldDeclared; rpc HoldCancelled; rpc HoldDeadline; }
    }
  }
}
service FiniteProvider { implements finite; }
service FiniteCaller { use finite { required capability invoke; } }

service TransportGrowthSubject {
  implements liveprobe;
  implements probe_aux;
  use transport_growth {
    required capability advance;
    required capability hold;
    required capability progress;
    capability extend;
  }
}

service TransportGrowthTarget { implements transport_growth; }
service TransportGrowthOperationProvider {
  implements transport_growth;
  use transport_growth {
    required capability advance;
    capability extend;
    capability extend2;
  }
  job held {
    title "Held work";
    description "A job accepted before a transport cutover completes exactly once.";
    payload Value;
    result Value;
    update Value;
    deadline 30s;
    retry { attempts 2; backoff [250ms]; }
  }
  job retained {
    title "Retained work";
    description "Work whose retained references span transport renewal without a business deadline.";
    payload Value;
    result Value;
  }
  consumer ticks {
    title "Ticks";
    description "A durable delivery held across a transport cutover.";
    events [transport_growth.Tick];
    concurrency 1;
    replay new;
  }
}

agent TransportGrowthCaller {
  use transport_growth {
    required capability advance;
    required capability control;
    required capability hold;
    required capability publishTick;
    capability extend;
  }
}
agent RpcDistributionCaller {
  use transport_growth { required capability control; required capability progress; }
}

agent DownloadGrowthCaller {
  use runtime { required capability download; }
  use transport_growth { capability extend; }
}
