model Value { value: string; }
model Status { stage: string; }
model Preview { text: string; }

api echo@v1 {
  title "Testkit echo";
  description "External Rust testkit acceptance fixture.";
  rpc Echo { input Value; output Value; }
  operation Work {
    input Value;
    output Value;
    progress Status;
    update Preview;
    signals { Continue Value; }
  }
  operation UpdateOnly { input Value; output Value; update Preview; signals { Continue Value; } }
  operation Silent { input Value; output Value; }
  operation Upload { input Value; output Value; upload; }
  event Observed { payload Value; }
  capabilities { public { allows { rpc Echo; operation Work; operation UpdateOnly; operation Silent; operation Upload; publish event Observed; subscribe event Observed; } } }
}

service Provider { implements echo; }
app Caller { use echo { rpc Echo; operation Work; operation UpdateOnly; operation Silent; operation Upload; subscribe event Observed; } }
agent AgentCaller { use echo { rpc Echo; operation Work; operation UpdateOnly; operation Silent; subscribe event Observed; } }
app RestrictedCaller {}
device UnsupportedDevice {}
