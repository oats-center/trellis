import { auth } from trellis;

model Value { value: string; }
model Status { stage: string; }
model Preview { text: string; }

api echo@v1 {
  title "Testkit echo";
  description "External Rust testkit acceptance fixture.";
  rpc Echo { input Value; output Value; }
  operation Work {
    input Value;
    output Value;
    progress Status;
    update Preview;
    signals { Continue Value; }
  }
  operation UpdateOnly { input Value; output Value; update Preview; signals { Continue Value; } }
  operation Silent { input Value; output Value; }
  operation OptionalSilent { input Value; output Value; }
  operation Upload { input Value; output Value; upload; }
  event Observed { payload Value; }
  capabilities {
    capability invoke { title "Invoke and observe"; description "Invoke fixture work and observe its events."; consequence "The caller may invoke Echo, work operations, and observe results."; consent_revision 1; allows { rpc Echo; operation Work; operation UpdateOnly; operation Silent; subscribe event Observed; } }
    capability upload { title "Upload"; description "Upload fixture values."; consequence "The caller may execute uploads."; consent_revision 1; allows { operation Upload; } }
    capability publishObserved { title "Publish observations"; description "Publish fixture observations."; consequence "The publisher may emit Observed events."; consent_revision 1; allows { publish event Observed; } }
    capability optionalSilent {
      title "Optional silent operation";
      description "Partial lifecycle authorization acceptance.";
      consequence "The caller can invoke and manage the optional silent operation.";
      consent_revision 1;
      allows { operation OptionalSilent; }
    }
  }
}

service Provider { implements echo; }
service Consumer { use echo { required capability invoke; capability optionalSilent; } }
service JobsProvider {
  job work { title "Work"; description "Private lifecycle recovery acceptance"; payload Value; result Value; }
}
service KvProvider {
  store objects { title "Private objects"; description "Raw resource isolation acceptance"; ttl 0; desired_max_object 1MiB; desired_max_total 8MiB; }
  kv records {
    title "Records";
    description "Authenticated generated KV availability across connection readiness.";
    schema Value;
    version 1;
    history 4;
    ttl 0ms;
  }
}
agent Caller { use echo { required capability invoke; required capability upload; } }
agent AgentCaller { use echo { required capability invoke; } }
agent RestrictedCaller {}
agent OptionalOperationCaller { use echo { capability optionalSilent; } }
agent OperationAuthorizationCaller { use echo { required capability optionalSilent; } }
device UnsupportedDevice {}
device CompanionDevice {
  state saved { title "Device saved value"; description "Installed device State authority acceptance"; schema Value; version 1; }
  agent Companion {
    state saved { title "User saved value"; description "Independent companion State authority acceptance"; schema Value; version 1; }
    use auth { required capability deviceCompanionsManage; }
    use echo { required capability invoke; }
  }
}
device OptionalCompanionDevice {
  agent optional Companion {
    use auth { required capability deviceCompanionsManage; }
    use echo { required capability invoke; }
  }
}
