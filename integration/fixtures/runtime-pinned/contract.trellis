import { auth } from trellis;

model Value { value: string; }
model UpdateDetail { count: int64; payload: bytes; }
model Update { value: string; nested: UpdateDetail; }
model Empty {}
model Saved { value: string; }
model Sample { site: string; value: string; }
model Observed { values: list<string>; }
model DeliveryStats { attempts: list<int64>; active: int64; maxActive: int64; successes: list<string>; }
model KeyedValue { key: string; value: string; }
model ResourceValue { value: string; }

api runtime@v1 {
  title "Runtime acceptance";
  description "Small generated transport and durability fixture.";
  rpc Echo { input Value; output Value; }
  rpc Download { input Value; output Value; download; }
  operation Work { input Value; progress Update; output Value; signals { Continue Value; } }
  operation Upload { input Value; output Value; signals { Continue Value; } upload; }
  operation Ingest { input Value; output Value; stream; }
  rpc Generate { input Value; output Value; download; }
  event Changed { payload Value; params [value]; }
  live Watch { input Empty; event Value; }
  capabilities {
    capability transfers.transport { title "Transport"; description "Exercise the runtime transport surfaces."; grants "The caller may invoke and observe the fixture transports."; allows { rpc Echo; operation Work; operation Upload; operation Ingest; publish event Changed; subscribe event Changed; live Watch; } }
    capability echo.call { title "Echo"; description "Invoke the echo RPC."; grants "The caller may echo values."; allows { rpc Echo; } }
    capability operations.work { title "Work"; description "Execute the work operation."; grants "The caller may execute and control work."; allows { operation Work; } }
    capability transfers.download { title "Download"; description "Download a fixture value."; grants "The caller may download values."; allows { rpc Download; rpc Generate; } }
  }
}

api events@v1 {
  title "Durable event acceptance";
  description "Distinct publisher authority on one consumer.";
  event Alpha { payload Sample; }
  event Beta { payload Sample; }
  rpc Observed { input Empty; output Observed; }
  rpc DropAlpha { input Empty; output Empty; }
  rpc DeliveryStats { input Empty; output DeliveryStats; }
  capabilities {
    capability alpha.publish { title "Publish Alpha"; description "Publish Alpha samples."; grants "The caller may publish Alpha."; allows { publish event Alpha; } }
    capability beta.publish { title "Publish Beta"; description "Publish Beta samples."; grants "The caller may publish Beta."; allows { publish event Beta; } }
    capability alpha.subscribe { title "Subscribe Alpha"; description "Observe Alpha samples."; grants "The caller may subscribe to Alpha."; allows { subscribe event Alpha; } }
    capability beta.subscribe { title "Subscribe Beta"; description "Observe Beta samples."; grants "The caller may subscribe to Beta."; allows { subscribe event Beta; } }
    capability events.inspect { title "Inspect delivery"; description "Read observed samples and delivery statistics."; grants "The caller may inspect delivery results."; allows { rpc Observed; rpc DeliveryStats; } }
    capability alpha.drop { title "Drop Alpha"; description "Close the Alpha fixture subscription."; grants "The caller may stop Alpha observation."; allows { rpc DropAlpha; } }
  }
}

api device_child@v1 {
  title "Device companion acceptance";
  description "Required and optional companion authority.";
  rpc Required { input Empty; output Empty; }
  rpc Optional { input Empty; output Empty; }
  capabilities {
    capability child.required {
      title "Required";
      description "Required child operation.";
      grants "The child can invoke its required operation.";
      allows { rpc Required; }
    }
    capability child.optional {
      title "Optional";
      description "Optional child operation.";
      grants "The child can invoke its optional operation.";
      allows { rpc Optional; }
    }
  }
}

service Provider {
  implements runtime;
  use runtime {
    required capability echo.call;
    required capability operations.work;
  }
  job work {
    title "Work";
    description "Runtime fixture work.";
    payload Value;
    result Value;
    update Update;
    deadline 5s;
    retry { attempts 2; backoff [250ms]; }
  }
  job keyedWork { title "Keyed work"; description "Runtime keyed queue acceptance."; payload KeyedValue; result KeyedValue; key_concurrency { path key; policy queue; } }
  job replayWork { title "Replay work"; description "Keyed retry and dead-letter replay acceptance."; payload Value; result Value; retry { attempts 2; backoff [250ms]; } key_concurrency { path value; policy queue; } }
  job restartWork { title "Restart work"; description "Automatic retry and crashed-worker redelivery."; payload Value; result Value; deadline 60s; retry { attempts 3; backoff [250ms, 250ms]; } }
  job preStartedWork { title "Pre-started work"; description "Key acquisition crash recovery."; payload KeyedValue; result KeyedValue; deadline 5s; key_concurrency { path key; policy queue; } }
  kv records { title "Records"; description "Rust KV acceptance values."; schema ResourceValue; version 1; history 4; ttl 0ms; }
  kv optional extras { title "Extras"; description "Optional Rust KV acceptance values approved after connect."; schema ResourceValue; version 1; history 4; ttl 0ms; }
  store files { title "Files"; description "Runtime fixture transfer files."; ttl 0; desired_max_object 1MiB; desired_max_total 8MiB; }
  store archive { title "Archive"; description "Runtime fixture secondary transfer destination."; ttl 0; desired_max_object 1MiB; desired_max_total 8MiB; }
  consumer changes { title "Changes"; description "Runtime fixture durable changes."; events [runtime.Changed]; concurrency 1; replay new; }
  kv extended { title "Extended"; description "Revision-pinned projection acceptance value."; schema ResourceValue; version 1; history 4; ttl 0ms; }
}
service OperationProvider {
  implements runtime;
  job keyedWork { title "Keyed work"; description "Rust keyed queue acceptance."; payload KeyedValue; result KeyedValue; key_concurrency { path key; policy queue; } }
}
service OperationCaller { use runtime { required capability operations.work; } }
app Caller {
  use runtime { required capability transfers.transport; }
  state saved { title "Saved"; description "Caller-owned saved value."; schema Saved; version 1; }
  state savedResource { title "Saved resource"; description "Rust State acceptance value."; schema ResourceValue; version 1; }
}
app StateCaller {
  state savedResource { title "Saved resource"; description "Rust State acceptance value."; schema ResourceValue; version 1; }
}
app Denied { use runtime; }
service AdminService {
  use auth {
    required capability users.manage;
    required capability roles.manage;
  }
}
service EventService {
  implements events;
  consumer events { title "Events"; description "Durable event acceptance values."; events [events.Alpha, events.Beta]; concurrency 1; replay new; retry { attempts 3; backoff [150ms, 300ms]; } }
}
service EventServiceConsumerOnly {
  implements events;
  consumer events { title "Events"; description "Durable-only event acceptance values."; events [events.Alpha, events.Beta]; concurrency 1; replay new; }
}
service EventServiceBoth {
  implements events;
  use events { required capability alpha.subscribe; required capability beta.subscribe; }
  consumer events { title "Events"; description "Durable plus explicit subscribe acceptance values."; events [events.Alpha, events.Beta]; concurrency 1; replay new; }
}
service EventSubscriberService {
  implements events;
  use events { required capability alpha.subscribe; required capability beta.subscribe; }
}
service EventClient {
  use events {
    required capability alpha.publish;
    required capability beta.subscribe;
  }
}
service ChildProvider { implements device_child; }
app Alpha { use events { required capability alpha.publish; required capability events.inspect; required capability alpha.drop; } }
app Beta { use events { required capability beta.publish; } }
device Device {
  state telemetry { title "Telemetry"; description "Device-owned State acceptance value."; schema ResourceValue; version 1; }
  app Companion {
    state shared { title "Shared"; description "Same-user companion State acceptance value."; schema ResourceValue; version 1; }
    use device_child {
      required capability child.required;
      capability child.optional;
    }
  }
}
device AgentDevice {
  agent Companion {
    use device_child {
      required capability child.required;
      capability child.optional;
    }
  }
}

model LiveProbeKey {
  runId: string;
  streamId: string;
}

model LiveProbeRelease {
  runId: string;
  streamId: string;
  throughIndex: int64;
  finish: bool;
  fail: bool;
  payloadBytes?: uint32;
  paddingBytes?: uint32;
}

model LiveProbeFrame {
  runId: string;
  streamId: string;
  sourceGeneration: int64;
  index: int64;
  payload: bytes;
  padding: string;
}

model LiveProbeStatus {
  starts: int64;
  active: int64;
  cleanups: int64;
  emitted: int64;
}

api liveprobe@v1 {
  title "Live observation acceptance";
  description "Case-owned source control and observed source lifetime.";
  rpc Inspect { input LiveProbeKey; output LiveProbeStatus; }
  rpc Release { input LiveProbeRelease; output LiveProbeStatus; }
  live Watch { input LiveProbeKey; event LiveProbeFrame; }
  capabilities { capability probe.observe { title "Observe"; description "Control and observe the live fixture."; grants "The caller may inspect, release, and watch live probes."; allows { rpc Inspect; rpc Release; live Watch; } } }
}

service LiveProbeProvider { implements liveprobe; }

app LiveProbeCaller {
  use liveprobe { required capability probe.observe; }
}

api transport_growth@v1 {
  title "Capability growth acceptance";
  description "Optional-capability growth on one live service attachment.";
  rpc Advance { input Empty; output Empty; }
  rpc Extend { input Empty; output Empty; }
  capabilities {
    capability growth.advance { title "Advance"; description "Advance the fixture."; grants "The caller may advance work."; allows { rpc Advance; } }
    capability growth.extend {
      title "Optional capability";
      description "Optional growth operation.";
      grants "The subject can invoke its optional operation.";
      allows { rpc Extend; }
    }
  }
}

service TransportGrowthSubject {
  implements liveprobe;
  use transport_growth {
    required capability growth.advance;
    capability growth.extend;
  }
}

service TransportGrowthTarget { implements transport_growth; }
