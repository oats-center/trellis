import { auth, events, health, jobs, state } from trellis;

app Console {
  use auth {
    capability manageRoles;
    capability managePrincipals;
    capability readUsers;
    capability managePlatform;
    capability acceptApis;
    capability forceReplaceApis;
    capability manageClients;
    required capability readSessions;
    required capability revokeSessions;
    required capability readIdentities;
    required capability manageIdentities;
    required capability changePassword;
    required capability readAccount;
    required capability updateProfile;
  }
  use events {
    required capability inspectConsumers;
    required capability dismissDeadLetters;
    required capability inspectDeadLetters;
    required capability replayDeadLetters;
    required capability readDiagnostics;
    required capability inspect;
    required capability readMetrics;
    required capability query;
    required capability observe;
  }
  use health {
    required capability inspect;
    required capability readMetrics;
    required capability query;
    required capability readSummary;
    required capability observeStatusChanges;
    required capability observe;
  }
  use jobs {
    required capability cancel;
    required capability dismissDeadLetters;
    required capability findByKey;
    required capability inspect;
    required capability readDeadLetters;
    required capability listServices;
    required capability readMetrics;
    required capability query;
    required capability replayDeadLetters;
    required capability retry;
    required capability readSummary;
    required capability observe;
  }
  use state {
    required capability delete;
  }
}
