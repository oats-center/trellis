import { auth, events, health, jobs, state } from trellis;

app Console {
  use auth {
    capability roles.manage;
    capability accounts.manage;
    capability users.manage;
    capability users.read;
    capability platform.manage;
    capability apis.accept;
    capability apis.forceReplace;
    capability clients.manage;
    required capability sessions.read;
    required capability sessions.revoke;
    required capability identities.read;
    required capability identities.manage;
    required capability account.changePassword;
    required capability account.read;
    required capability account.edit;
  }
  use events {
    required capability consumers.inspect;
    required capability deadLetters.dismiss;
    required capability deadLetters.inspect;
    required capability deadLetters.replay;
    required capability diagnostics.read;
    required capability events.inspect;
    required capability metrics.read;
    required capability events.query;
    required capability events.observe;
  }
  use health {
    required capability health.inspect;
    required capability metrics.read;
    required capability health.query;
    required capability summary.read;
    required capability status.observe;
    required capability health.observe;
  }
  use jobs {
    required capability jobs.cancel;
    required capability deadLetters.dismiss;
    required capability jobs.findByKey;
    required capability jobs.inspect;
    required capability deadLetters.read;
    required capability services.list;
    required capability metrics.read;
    required capability jobs.query;
    required capability deadLetters.replay;
    required capability jobs.retry;
    required capability summary.read;
    required capability jobs.observe;
  }
  use state {
    required capability values.delete;
  }
}
