FROM --platform=$BUILDPLATFORM docker.io/library/node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json /app/
COPY ts /app/ts
COPY web /app/web
COPY portal /app/portal
COPY docs /app/docs
COPY art /app/art

RUN npm ci && npm run build:prepared --workspace @trellis/console

FROM docker.io/library/nginx:1.29-alpine

COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/docker-entrypoint.d/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /app/web/build /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
