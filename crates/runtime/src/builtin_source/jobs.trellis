api jobs@v1 {
  title "Trellis Jobs";
  description "Trellis-managed background job administration API.";
  version "1.0.0";
  error NotFoundError(JobsNotFoundErrorData);
  error UnexpectedError;
  error ValidationError;
  rpc Cancel {
    input JobsCancelRequest;
    output JobsCancelResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc DismissDLQ {
    input JobsDismissDLQRequest;
    output JobsDismissDLQResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc GetKey {
    input JobsGetKeyRequest;
    output JobsGetKeyResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Inspect {
    input JobsInspectRequest;
    output JobsInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc ListDLQ {
    input JobsListDLQRequest;
    output JobsListDLQResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc ListServices {
    input JobsListServicesRequest;
    output JobsListServicesResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Metrics {
    input JobsMetricsRequest;
    output JobsMetricsResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Query {
    input JobsQueryRequest;
    output JobsQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Summary {
    input JobsSummaryRequest;
    output JobsSummaryResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc ReplayDLQ {
    input JobsReplayDLQRequest;
    output JobsReplayDLQResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Retry {
    input JobsRetryRequest;
    output JobsRetryResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  live Watch {
    input JobsWatchRequest;
    event JobsWatchFrame;
  }
  capabilities {
    capability query {
      title "Query jobs";
      description "Find jobs matching query filters.";
      consequence "Matching job summaries are visible to the caller.";
      consent_revision 1;
      allows { rpc Query; }
    }
    capability inspect {
      title "Inspect jobs";
      description "Read a job's details and execution history.";
      consequence "Job inputs, results, and execution details may be disclosed.";
      consent_revision 1;
      allows { rpc Inspect; }
    }
    capability keyLookup {
      title "Look up job keys";
      description "Find the job associated with a queue key.";
      consequence "The caller can discover keyed job identities.";
      consent_revision 1;
      allows { rpc GetKey; }
    }
    capability listServices {
      title "List job services";
      description "Discover services with managed job queues.";
      consequence "Service and queue identities are visible to the caller.";
      consent_revision 1;
      allows { rpc ListServices; }
    }
    capability summary {
      title "Read job summaries";
      description "Read aggregate job lifecycle counts.";
      consequence "The caller can see aggregate workload status.";
      consent_revision 1;
      allows { rpc Summary; }
    }
    capability metrics {
      title "Read job metrics";
      description "Read operational job metrics.";
      consequence "The caller can see queue throughput and execution measurements.";
      consent_revision 1;
      allows { rpc Metrics; }
    }
    capability cancel {
      title "Cancel jobs";
      description "Request cancellation of an active job.";
      consequence "The caller can stop pending or running work.";
      consent_revision 1;
      allows { rpc Cancel; }
    }
    capability retry {
      title "Retry jobs";
      description "Request another execution of a retryable job.";
      consequence "The caller can cause job work to execute again.";
      consent_revision 1;
      allows { rpc Retry; }
    }
    capability dlqRead {
      title "Read dead-letter jobs";
      description "List jobs retained in the dead-letter queue.";
      consequence "The caller can see failed job records.";
      consent_revision 1;
      allows { rpc ListDLQ; }
    }
    capability dlqReplay {
      title "Replay dead-letter jobs";
      description "Return a dead-letter job to execution.";
      consequence "Failed work can execute again and repeat business effects.";
      consent_revision 1;
      allows { rpc ReplayDLQ; }
    }
    capability dlqDismiss {
      title "Dismiss dead-letter jobs";
      description "Dismiss a job from the dead-letter queue.";
      consequence "The caller can remove failed work from operational follow-up.";
      consent_revision 1;
      allows { rpc DismissDLQ; }
    }
    capability observe {
      title "Observe jobs";
      description "Follow live job lifecycle updates.";
      consequence "The caller can continuously observe matching job activity.";
      consent_revision 1;
      allows { live Watch; }
    }
  }
}
