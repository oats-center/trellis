api health@v1 {
  title "Trellis Health";
  description "Trellis-managed participant health projection and operational history.";
  version "1.0.0";
  error NotFoundError(HealthNotFoundErrorData);
  error UnexpectedError;
  error ValidationError;
  rpc Inspect {
    input HealthInspectRequest;
    output HealthInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Metrics {
    input HealthMetricsRequest;
    output HealthMetricsResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Query {
    input HealthQueryRequest;
    output HealthQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Summary {
    input HealthSummaryRequest;
    output HealthSummaryResponse;
    errors [UnexpectedError, ValidationError];
  }
  event StatusChanged {
    payload HealthStatusChangedEvent;
  }
  live Watch {
    input HealthWatchRequest;
    event HealthWatchFrame;
  }
  capabilities {
    capability query {
      title "Query health";
      description "Find participants matching health filters.";
      consequence "Matching participant health summaries are visible to the caller.";
      consent_revision 1;
      allows { rpc Query; }
    }
    capability inspect {
      title "Inspect health";
      description "Read a participant's health details and operational history.";
      consequence "The caller can see participant health diagnostics.";
      consent_revision 1;
      allows { rpc Inspect; }
    }
    capability summary {
      title "Read health summaries";
      description "Read aggregate participant health counts.";
      consequence "The caller can see overall deployment health.";
      consent_revision 1;
      allows { rpc Summary; }
    }
    capability metrics {
      title "Read health metrics";
      description "Read participant health measurements.";
      consequence "The caller can see operational health metrics.";
      consent_revision 1;
      allows { rpc Metrics; }
    }
    capability observe {
      title "Observe health";
      description "Follow live participant health updates.";
      consequence "The caller can continuously observe participant health.";
      consent_revision 1;
      allows { live Watch; }
    }
    capability statusChanges {
      title "Receive health status changes";
      description "Consume participant health status-change events.";
      consequence "The caller receives participant status transitions.";
      consent_revision 1;
      allows { subscribe event StatusChanged; }
    }
  }
}
