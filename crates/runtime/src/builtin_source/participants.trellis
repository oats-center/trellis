import { auth } from auth;
import { core } from core;
import { state } from state;
import { health } from health;
import { jobs } from jobs;
import { events } from events;
import { AuthAttachment } from auth_types;

service platform {
  implements auth;
  implements core;
  implements state;
  kv connections {
    title "Connections";
    description "Operational attachment presence; policy and enforcement remain in Auth's durable store.";
    schema AuthAttachment;
    ttl 2m;
    desired_max_value 16KiB;
  }
}
service healthRuntime { implements health; }
service jobsRuntime { implements jobs; }
service eventsRuntime { implements events; }

// Administrative capabilities still require separately delegated platform privileges.
// These declarations are developer requests, never installed principals.
agent cli {
  use auth {
    capability rolesRead;
    capability rolesPut;
    capability rolesDelete;
    capability roleAssignmentsRead;
    capability roleAssignmentsAssign;
    capability roleAssignmentsRevoke;
    capability capabilityGrantsRead;
    capability capabilityGrantsGrant;
    capability capabilityGrantsRevoke;
    capability capabilitiesRead;
    capability principalsEffectiveAccess;
    capability apisRead;
    capability apisReview;
    capability apisAccept;
    capability apisForceReplace;
    capability oauthClientsRead;
    capability oauthClientsPut;
    capability oauthClientsDisable;
    capability oauthClientsDelete;
    capability platformPrivilegesRead;
    capability platformPrivilegesAssign;
    capability platformPrivilegesRevoke;
    capability platformDelegationsRead;
    capability platformDelegationsPut;
    capability platformDelegationsRevoke;
    capability authorizationSessionsRead;
    capability authorizationSessionsRevoke;
    capability connectionsRead;
    capability connectionsKick;
    capability issuersRotate;
    capability issuersRevoke;
    capability usersRead;
    capability usersCreate;
    capability usersUpdate;
    capability usersPasswordReset;
    capability oidcProvidersRead;
    capability oidcProvidersPut;
    capability oidcProvidersDisable;
    capability oidcProvidersDelete;
    capability oidcRoleMappingsRead;
    capability oidcRoleMappingsPut;
    capability oidcRoleMappingsDelete;
    capability deploymentsRead;
    capability deploymentsCreate;
    capability deploymentsApply;
    capability deploymentsEnable;
    capability deploymentsDisable;
    capability deploymentsRemove;
    capability serviceInstancesRead;
    capability serviceInstancesProvision;
    capability serviceInstancesEnable;
    capability serviceInstancesDisable;
    capability serviceInstancesRemove;
    capability devicesRead;
    capability devicesProvision;
    capability devicesEnable;
    capability devicesDisable;
    capability devicesRemove;
    capability resourcesRead;
    capability resourcesRemove;
    required capability accountRead;
    required capability passwordChange;
    required capability identitiesRead;
    required capability identitiesManage;
    required capability sessionsRead;
    required capability sessionsRevoke;
    capability delegationsRead;
    capability delegationsRevoke;
  }
  use state { required capability delete; }
  use core {
    required capability resources_destroy;
    required capability resources_read;
  }
  use health { required capability query; }
  use jobs { required capability query; }
  use events {
    required capability consumersInspect;
    required capability deadLettersDismiss;
    required capability deadLettersInspect;
    required capability deadLettersReplay;
    required capability query;
  }
}

app console {
  use auth {
    capability rolesRead;
    capability rolesPut;
    capability rolesDelete;
    capability roleAssignmentsRead;
    capability roleAssignmentsAssign;
    capability roleAssignmentsRevoke;
    capability capabilityGrantsRead;
    capability capabilityGrantsGrant;
    capability capabilityGrantsRevoke;
    capability capabilitiesRead;
    capability principalsEffectiveAccess;
    capability apisRead;
    capability apisReview;
    capability apisAccept;
    capability apisForceReplace;
    capability oauthClientsRead;
    capability oauthClientsPut;
    capability oauthClientsDisable;
    capability oauthClientsDelete;
    capability platformPrivilegesRead;
    capability platformPrivilegesAssign;
    capability platformPrivilegesRevoke;
    capability platformDelegationsRead;
    capability platformDelegationsPut;
    capability platformDelegationsRevoke;
    capability authorizationSessionsRead;
    capability authorizationSessionsRevoke;
    capability connectionsRead;
    capability connectionsKick;
    capability issuersRotate;
    capability issuersRevoke;
    capability usersRead;
    capability usersCreate;
    capability usersUpdate;
    capability usersPasswordReset;
    capability oidcProvidersRead;
    capability oidcProvidersPut;
    capability oidcProvidersDisable;
    capability oidcProvidersDelete;
    capability oidcRoleMappingsRead;
    capability oidcRoleMappingsPut;
    capability oidcRoleMappingsDelete;
    capability deploymentsRead;
    capability deploymentsCreate;
    capability deploymentsApply;
    capability deploymentsEnable;
    capability deploymentsDisable;
    capability deploymentsRemove;
    capability serviceInstancesRead;
    capability serviceInstancesProvision;
    capability serviceInstancesEnable;
    capability serviceInstancesDisable;
    capability serviceInstancesRemove;
    capability devicesRead;
    capability devicesProvision;
    capability devicesEnable;
    capability devicesDisable;
    capability devicesRemove;
    capability resourcesRead;
    capability resourcesRemove;
    capability securityObserve;
    required capability accountRead;
    required capability passwordChange;
    required capability identitiesRead;
    required capability identitiesManage;
    required capability sessionsRead;
    required capability sessionsRevoke;
    capability delegationsRead;
    capability delegationsRevoke;
  }
  use state {
    required capability delete;
    required capability read;
    required capability write;
    required capability resourcesInspect;
  }
  use core {
    required capability resources_destroy;
    required capability resources_read;
  }
  use health {
    required capability inspect;
    required capability metrics;
    required capability query;
    required capability summary;
    required capability observe;
  }
  use jobs {
    required capability cancel;
    required capability dlqDismiss;
    required capability keyLookup;
    required capability inspect;
    required capability dlqRead;
    required capability listServices;
    required capability metrics;
    required capability query;
    required capability summary;
    required capability dlqReplay;
    required capability retry;
    required capability observe;
  }
  use events {
    required capability consumersInspect;
    required capability deadLettersDismiss;
    required capability deadLettersInspect;
    required capability deadLettersReplay;
    required capability diagnostics;
    required capability inspect;
    required capability metrics;
    required capability query;
    required capability observe;
  }
}
