import {
  ResourcesInspectRequest,
  ResourcesInspectResponse,
  ResourcesQueryRequest,
  ResourcesQueryResponse,
  StateConflict,
  StateDeleteRequest,
  StateDeleteResponse,
  StateGetRequest,
  StateGetResponse,
  StatePutRequest,
  StatePutResponse,
  StateRepresentationError,
} from types;

api state@v1 {
  title "Trellis State";
  description "Trellis-managed single-value State for user bindings and service/device principals.";
  version "1.0.0";

  error Conflict(StateConflict);
  error CorruptRepresentation(StateRepresentationError);
  error UnsupportedRepresentation(StateRepresentationError);

  rpc Get {
    input StateGetRequest;
    output StateGetResponse;
    errors [CorruptRepresentation, UnsupportedRepresentation];
  }

  rpc Put {
    input StatePutRequest;
    output StatePutResponse;
    errors [Conflict, CorruptRepresentation, UnsupportedRepresentation];
  }

  rpc Delete {
    input StateDeleteRequest;
    output StateDeleteResponse;
    errors [Conflict];
  }


  rpc Resources.Query {
    input ResourcesQueryRequest;
    output ResourcesQueryResponse;
    errors [CorruptRepresentation, UnsupportedRepresentation];
    pagination cursor;
  }

  rpc Resources.Inspect {
    input ResourcesInspectRequest;
    output ResourcesInspectResponse;
    errors [CorruptRepresentation, UnsupportedRepresentation];
  }

  capabilities {
    capability read {
      title "Read State";
      description "Read saved State values in the caller's authorized namespace.";
      consequence "The caller can see saved values.";
      consent_revision 1;
      allows { rpc Get; }
    }
    capability write {
      title "Write State";
      description "Create or replace State values in the caller's authorized namespace.";
      consequence "The caller can change saved values.";
      consent_revision 1;
      allows { rpc Put; }
    }
    capability delete {
      title "Delete State";
      description "Delete State values in the caller's authorized namespace.";
      consequence "The caller can remove saved values.";
      consent_revision 1;
      allows { rpc Delete; }
    }
    capability resourcesInspect {
      title "State Resources Read";
      description "Inspect State resource identities, representations, and readiness.";
      consequence "The caller can inspect State resources across explicit administrative scope.";
      consent_revision 1;
      allows { rpc Resources.Inspect; rpc Resources.Query; }
    }
  }
}
