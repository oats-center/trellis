api events@v1 {
  title "Trellis Events";
  description "Event observability, managed Consumer diagnostics, and dead-letter lifecycle.";
  version "1.0.0";
  error NotFoundError(EventsNotFoundErrorData);
  error Conflict(EventsErrorData);
  error Forbidden(EventsErrorData);
  error Unavailable(EventsErrorData);
  error UnreplayableOriginal(EventsErrorData);
  error UnexpectedError;
  error ValidationError;
  rpc Consumers.Inspect {
    input EventsConsumersInspectRequest;
    output EventsConsumersInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Consumers.Query {
    input EventsConsumersQueryRequest;
    output EventsConsumersQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Consumers.ReportDelivery {
    input EventsConsumersReportDeliveryRequest;
    output EventsConsumersReportDeliveryResponse;
    errors [Conflict, Forbidden, NotFoundError, Unavailable, ValidationError];
  }
  rpc Inspect {
    input EventsInspectRequest;
    output EventsInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Metrics {
    input EventsMetricsRequest;
    output EventsMetricsResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Diagnostics {
    input EventsDiagnosticsRequest;
    output EventsDiagnosticsResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Query {
    input EventsQueryRequest;
    output EventsQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc DeadLetters.Query {
    input EventsDeadLettersQueryRequest;
    output EventsDeadLettersQueryResponse;
    errors [Forbidden, UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc DeadLetters.Inspect {
    input EventsDeadLettersInspectRequest;
    output EventsDeadLettersInspectResponse;
    errors [Forbidden, NotFoundError, Unavailable, ValidationError];
  }
  rpc DeadLetters.Replay {
    input EventsDeadLettersReplayRequest;
    output EventsDeadLettersReplayResponse;
    errors [Conflict, Forbidden, NotFoundError, Unavailable, UnreplayableOriginal, ValidationError];
  }
  rpc DeadLetters.Dismiss {
    input EventsDeadLettersDismissRequest;
    output EventsDeadLettersDismissResponse;
    errors [Conflict, Forbidden, NotFoundError, Unavailable, ValidationError];
  }
  live Watch {
    input EventsWatchRequest;
    event EventsWatchFrame;
  }
  capabilities {
    capability query {
      title "Query events";
      description "Find retained events matching query filters.";
      consequence "Matching event summaries are visible to the caller.";
      consent_revision 1;
      allows { rpc Query; }
    }
    capability inspect {
      title "Inspect events";
      description "Read an individual retained event and its delivery details.";
      consequence "The caller can see event payloads and publication metadata.";
      consent_revision 1;
      allows { rpc Inspect; }
    }
    capability metrics {
      title "Read event metrics";
      description "Read event ingestion and delivery measurements.";
      consequence "The caller can see operational event metrics.";
      consent_revision 1;
      allows { rpc Metrics; }
    }
    capability observe {
      title "Observe events";
      description "Follow live event-log updates.";
      consequence "The caller can continuously observe matching event activity.";
      consent_revision 1;
      allows { live Watch; }
    }
    capability consumersInspect {
      title "Inspect Consumers";
      description "Query managed Consumers and inspect their delivery state.";
      consequence "The caller can see Consumer identities and delivery diagnostics.";
      consent_revision 1;
      allows { rpc Consumers.Query; rpc Consumers.Inspect; }
    }
    capability deadLettersInspect {
      title "Inspect dead letters";
      description "Query and inspect failed Consumer deliveries.";
      consequence "The caller can see failed event payloads and delivery errors.";
      consent_revision 1;
      allows { rpc DeadLetters.Query; rpc DeadLetters.Inspect; }
    }
    capability deadLettersReplay {
      title "Replay dead letters";
      description "Request another Consumer delivery of a dead-letter event.";
      consequence "Consumer processing may run again and repeat business effects.";
      consent_revision 1;
      allows { rpc DeadLetters.Replay; }
    }
    capability deadLettersDismiss {
      title "Dismiss dead letters";
      description "Dismiss a failed Consumer delivery.";
      consequence "The caller can remove failed deliveries from operational follow-up.";
      consent_revision 1;
      allows { rpc DeadLetters.Dismiss; }
    }
    capability diagnostics {
      title "Read event diagnostics";
      description "Inspect event projection and ingestion diagnostics.";
      consequence "The caller can see event infrastructure failures and progress.";
      consent_revision 1;
      allows { rpc Diagnostics; }
    }
  }
}
