api events@v1 {
  title "Trellis Events";
  description "Event observability, managed Consumer diagnostics, and dead-letter lifecycle.";
  version "1.0.0";
  error NotFoundError(EventsNotFoundErrorData);
  error Conflict(EventsErrorData);
  error Forbidden(EventsErrorData);
  error Unavailable(EventsErrorData);
  error UnreplayableOriginal(EventsErrorData);
  error UnexpectedError;
  error ValidationError;
  /// Get one event consumer and how far behind it is.
  rpc Consumers.Inspect {
    input EventsConsumersInspectRequest;
    output EventsConsumersInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  /// List event consumers and their delivery status.
  rpc Consumers.Query {
    input EventsConsumersQueryRequest;
    output EventsConsumersQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  /// A service reports how delivering an event to it went.
  rpc Consumers.ReportDelivery {
    input EventsConsumersReportDeliveryRequest;
    output EventsConsumersReportDeliveryResponse;
    errors [Conflict, Forbidden, NotFoundError, Unavailable, ValidationError];
  }
  /// Get one published event and its data.
  rpc Inspect {
    input EventsInspectRequest;
    output EventsInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  /// Event volume and delivery speed over a time window.
  rpc Metrics {
    input EventsMetricsRequest;
    output EventsMetricsResponse;
    errors [UnexpectedError, ValidationError];
  }
  /// Problems with event storage and processing, and whether history is complete.
  rpc Diagnostics {
    input EventsDiagnosticsRequest;
    output EventsDiagnosticsResponse;
    errors [UnexpectedError, ValidationError];
  }
  /// List published events, newest first, optionally by type, sender or text.
  rpc Query {
    input EventsQueryRequest;
    output EventsQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  /// List events that failed to reach a service.
  rpc DeadLetters.Query {
    input EventsDeadLettersQueryRequest;
    output EventsDeadLettersQueryResponse;
    errors [Forbidden, UnexpectedError, ValidationError];
    pagination cursor;
  }
  /// Get one failed delivery, its data and the error.
  rpc DeadLetters.Inspect {
    input EventsDeadLettersInspectRequest;
    output EventsDeadLettersInspectResponse;
    errors [Forbidden, NotFoundError, Unavailable, ValidationError];
  }
  /// Send a failed event to its service again.
  rpc DeadLetters.Replay {
    input EventsDeadLettersReplayRequest;
    output EventsDeadLettersReplayResponse;
    errors [Conflict, Forbidden, NotFoundError, Unavailable, UnreplayableOriginal, ValidationError];
  }
  /// Discard a failed delivery.
  rpc DeadLetters.Dismiss {
    input EventsDeadLettersDismissRequest;
    output EventsDeadLettersDismissResponse;
    errors [Conflict, Forbidden, NotFoundError, Unavailable, ValidationError];
  }
  /// Follow published events and delivery changes as they happen.
  live Watch {
    input EventsWatchRequest;
    event EventsWatchFrame;
  }
  capabilities {
    capability events.query {
      title "Search events";
      description "Find events in the history.";
      grants "Can see event summaries.";
      allows { rpc Query; }
    }
    capability events.inspect {
      title "Open events";
      description "See an event's full contents and delivery.";
      grants "Can see event data.";
      allows { rpc Inspect; }
    }
    capability metrics.read {
      title "See event metrics";
      description "See event volume and delivery speed.";
      grants "Can see event metrics.";
      allows { rpc Metrics; }
    }
    capability events.observe {
      title "Watch events live";
      description "Follow new events as they happen.";
      grants "Can see events live.";
      allows { live Watch; }
    }
    capability consumers.inspect {
      title "See event consumers";
      description "See which services receive events and how delivery is going.";
      grants "Can see delivery status.";
      allows { rpc Consumers.Query; rpc Consumers.Inspect; }
    }
    capability deadLetters.inspect {
      title "See failed deliveries";
      description "See events that services could not process.";
      grants "Can see failed event data and errors.";
      allows { rpc DeadLetters.Query; rpc DeadLetters.Inspect; }
    }
    capability deadLetters.replay {
      title "Retry failed deliveries";
      description "Send a failed event to its service again.";
      grants "The service may repeat its work.";
      allows { rpc DeadLetters.Replay; }
    }
    capability deadLetters.dismiss {
      title "Dismiss failed deliveries";
      description "Clear a failed delivery from the list.";
      grants "Removes it from follow-up.";
      allows { rpc DeadLetters.Dismiss; }
    }
    capability diagnostics.read {
      title "See event diagnostics";
      description "See problems with event storage and processing.";
      grants "Can see event system errors.";
      allows { rpc Diagnostics; }
    }
    capability replays.process {
      title "Process own event replays";
      description "Let a service finish replays of its own events.";
      grants "The service can complete its own replays.";
      allows { rpc Consumers.ReportDelivery; rpc DeadLetters.Inspect; }
    }
    group operator {
      title "Operate events";
      description "Watch events and consumers, and replay or dismiss failed deliveries.";
      grants "Can see event data and replay or discard failed deliveries.";
      capability events.query;
      capability events.inspect;
      capability events.observe;
      capability consumers.inspect;
      capability deadLetters.inspect;
      capability deadLetters.replay;
      capability deadLetters.dismiss;
      capability metrics.read;
      capability diagnostics.read;
    }
  }
}
