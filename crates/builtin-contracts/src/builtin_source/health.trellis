api health@v1 {
  title "Trellis Health";
  description "Trellis-managed participant health projection and operational history.";
  version "1.0.0";
  error NotFoundError(HealthNotFoundErrorData);
  error UnexpectedError;
  error ValidationError;
  rpc Inspect {
    input HealthInspectRequest;
    output HealthInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Metrics {
    input HealthMetricsRequest;
    output HealthMetricsResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Query {
    input HealthQueryRequest;
    output HealthQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Summary {
    input HealthSummaryRequest;
    output HealthSummaryResponse;
    errors [UnexpectedError, ValidationError];
  }
  event Heartbeat {
    payload HealthHeartbeatSample;
  }
  event StatusChanged {
    payload HealthStatusChangedEvent;
  }
  live Watch {
    input HealthWatchRequest;
    event HealthWatchFrame;
  }
  capabilities {
    capability health.query {
      title "Search health";
      description "Find services and devices by health.";
      grants "Can see health summaries.";
      allows { rpc Query; }
    }
    capability health.inspect {
      title "See health details";
      description "See a service's or device's health history.";
      grants "Can see health details.";
      allows { rpc Inspect; }
    }
    capability summary.read {
      title "See health overview";
      description "See how many things are healthy or not.";
      grants "Can see overall health.";
      allows { rpc Summary; }
    }
    capability metrics.read {
      title "See health metrics";
      description "See health measurements over time.";
      grants "Can see health metrics.";
      allows { rpc Metrics; }
    }
    capability health.observe {
      title "Watch health live";
      description "Follow health changes as they happen.";
      grants "Can see health live.";
      allows { live Watch; }
    }
    capability status.observe {
      title "Get health alerts";
      description "Be told when something becomes healthy or unhealthy.";
      grants "Receives health changes.";
      allows { subscribe event StatusChanged; }
    }
    capability health.report {
      title "Report own health";
      description "Let a service or device report its own health.";
      grants "Records health for that service or device only.";
      allows { publish event Heartbeat; }
    }
    group monitor {
      title "Monitor health";
      description "See the health of services and devices and get alerts.";
      grants "Can see health data.";
      capability health.query;
      capability health.inspect;
      capability health.observe;
      capability status.observe;
      capability summary.read;
      capability metrics.read;
    }
  }
}
