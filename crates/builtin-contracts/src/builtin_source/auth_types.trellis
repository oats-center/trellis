}
model AuthUserUpdateRequest {
  userId: ulid;
  displayName?: AuthName;
  enabled: bool;
  givenName?: AuthName;
  familyName?: AuthName;
  email?: string;
  clearEmail?: bool;
  expectedRevision: AuthRevision;
  expectedProfileRevision?: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthUserDeleteRequest {
  userId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthUserProfileUpdateRequest {
  displayName?: AuthName;
  givenName?: AuthName;
  familyName?: AuthName;
  email?: string;
  avatarOverrideUrl?: string;
  clearEmail?: bool;
  clearAvatarOverride?: bool;
