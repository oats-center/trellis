model AuthSecurityEvent {
  eventId: ulid;
  occurredAt: timestamp;
  principalId?: ulid;
  authorizationSessionId?: ulid;
  attachmentId?: ulid;
  issuerKeyId?: AuthKeyId;
  enforcement?: AuthEnforcementProgress;
}

// Configuration a participant declares and Trellis keeps.
type AuthConfigRevisionNumber = uint32(min=1);
type AuthConfigFieldName = string(min_length=1, max_length=128);
/// Whose configuration: a deployment, one of its instances, an app's client,
/// or a service claim waiting for its service. A claim's settings become its
/// deployment's when the claim is approved.
model AuthConfigTarget {
  deploymentId?: ulid;
  instanceId?: ulid;
  clientId?: AuthClientId;
  claimId?: ulid;
}
/// Where a field's effective value comes from.
enum AuthConfigSource { deployment; instance; default; unset; }
model AuthConfigField {
  name: AuthConfigFieldName;
  title: string;
  description: string;
  /// JSON Schema of the field's type.
  schema: json;
  required: bool;
  /// Write-only; its value is never returned to an administrator.
  secret: bool;
  /// Read only when the participant connects.
  restart: bool;
  default?: json;
  /// The effective value of a setting. Never present for a secret.
  value?: json;
  /// A value is stored for this field here or on the deployment.
  isSet: bool;
  source: AuthConfigSource;
  /// Why the value stored here doesn't fit this build: the wrong type, or a
  /// secret stored as a plain setting or the other way round. This build
  /// ignores it and keeps the value stored before it, or the default.
  invalid?: string;
  /// A plain value is stored under this secret's name, saved before the
  /// build declared it secret. It is never shown or delivered; setting the
  /// field as a secret replaces it.
  storedAsPlain: bool;
}
/// A field a build declares, before anything is stored for it.
model AuthConfigDeclaration {
  name: AuthConfigFieldName;
  title: string;
  description: string;
  /// JSON Schema of the field's type.
  schema: json;
  required: bool;
  secret: bool;
  restart: bool;
  default?: json;
}
/// A stored value the build doesn't declare. It is kept for a build that does.
model AuthConfigUnusedValue {
  name: AuthConfigFieldName;
  secret: bool;
  /// The stored value of a setting. Never present for a secret.
  value?: json;
  source: AuthConfigSource;
}
/// Which configuration an instance loaded when it last connected.
model AuthConfigInstanceStatus {
  instanceId: ulid;
  title: string;
  connectedRevision?: AuthConfigRevisionNumber;
  connectedInstanceRevision?: AuthConfigRevisionNumber;
  connectedAt?: timestamp;
  /// A setting that applies after a restart has a different value for this
  /// instance's build than the one it loaded when it connected.
  restartPending: bool;
}
model AuthConfigResponse {
  target: AuthConfigTarget;
  /// Current revision stored at this target; absent before the first write.
  revision?: AuthConfigRevisionNumber;
  /// For an instance target, the deployment revision under its overrides.
  deploymentRevision?: AuthConfigRevisionNumber;
  /// Whether a build's declaration is known: the installed build's, an app's
  /// attached declaration, or, for a claim, the build its service submitted.
  declared: bool;
  fields: list<AuthConfigField>;
  /// Required fields without a usable value; instances wait until they are set.
  missing: list<AuthConfigFieldName>;
  /// Stored values the build doesn't declare, here and on the deployment.
  unused: list<AuthConfigUnusedValue>;
  instances: list<AuthConfigInstanceStatus>;
}
model AuthConfigGetRequest { target: AuthConfigTarget; }
model AuthConfigSetRequest {
  target: AuthConfigTarget;
  /// Settings by field name. Any lowerCamelCase name is stored, whether or
  /// not a build declares it; a build ignores what it doesn't declare and
  /// what doesn't fit its type.
  values?: map<json>;
  /// Secrets by field name, stored sealed under the same rule.
  secrets?: map<json>;
  /// Fields whose stored value is removed, so the default or deployment value applies.
  unset?: list<AuthConfigFieldName>;
  /// The revision this change is based on; absent only for the first write.
  expectedRevision?: AuthConfigRevisionNumber;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthConfigRevision {
  revision: AuthConfigRevisionNumber;
  createdAt: timestamp;
  createdBy: string;
  /// Stored settings; secrets are never included, nor plain values stored
  /// under a name the installed build declares secret.
  values: map<json>;
  /// Fields whose plain values are left out of `values` because the
  /// installed build declares them secret.
  hiddenValues: list<AuthConfigFieldName>;
  /// Fields this revision changed from the one before it.
  changed: list<AuthConfigFieldName>;
  /// Secret fields whose value this revision changed.
  changedSecrets: list<AuthConfigFieldName>;
  current: bool;
}
model AuthConfigRevisionsListRequest { target: AuthConfigTarget; page?: CursorQuery; }
type AuthConfigRevisionsListResponse = CursorPage<AuthConfigRevision>;
model AuthConfigRevisionDeleteRequest {
  target: AuthConfigTarget;
  revision: AuthConfigRevisionNumber;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthConfigRollbackRequest {
  target: AuthConfigTarget;
  /// The earlier revision whose values become a new revision.
  revision: AuthConfigRevisionNumber;
  expectedRevision: AuthConfigRevisionNumber;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOwnConfigRequest {
  /// The caller is connecting, so its restart-only values take effect now.
  atConnect: bool;
}
model AuthOwnConfigResponse {
  deploymentRevision?: AuthConfigRevisionNumber;
  instanceRevision?: AuthConfigRevisionNumber;
  /// Effective values, secrets included, with defaults applied.
  values: map<json>;
  /// Required fields without a usable value; the participant waits for them.
  missing: list<AuthConfigFieldName>;
  /// Fields whose stored value doesn't fit this build, with why. The build
  /// uses the value stored before it, or the default.
  invalid: map<string>;
  /// Console page where an administrator sets the missing values.
  configUrl?: string;
}
/// Configuration changed; the payload says whose and the current revision, never values.
model AuthConfigChanged {
  eventId: ulid;
  occurredAt: timestamp;
  deploymentId?: ulid;
  instanceId?: ulid;
  clientId?: AuthClientId;
  /// Absent when a new app declaration changed what an app reads and its
  /// client has no stored settings.
  revision?: AuthConfigRevisionNumber;
}
/// Attach an app build's settings declaration to its registered client.
model AuthConfigAppDeclareRequest {
  clientId: AuthClientId;
  /// Package evidence of the build that declares the app.
  packageEvidence: json;
  /// The app or agent request in that package, such as `acme-orders.Panel`.
  requestId: string;
  idempotencyKey: AuthIdempotencyKey;
}
/// An app's own settings, as every signed-in user of it reads them.
model AuthAppConfigResponse {
  revision?: AuthConfigRevisionNumber;
  values: map<json>;
}

/// What an administrator changes about a webhook endpoint.
enum AuthWebhookChange { enable; disable; rotateUrl; retireUrl; set; }
/// A webhook runtime setting a deployment may override.
enum AuthWebhookSetting {
  requestsPerSecond;
  burst;
  failuresPerMinute;
  maxBody;
  dedupeWindow;
  syncDecideDeadline;
  asyncDecideDeadline;
  rotationOverlap;
  recordRetention;
  intakeRetention;
  intakeMaxBytes;
}
model AuthWebhooksUpdateRequest {
  deploymentId: ulid;
  endpoint: string;
  change: AuthWebhookChange;
  /// The setting `set` changes.
  setting?: AuthWebhookSetting;
  /// Milliseconds for durations, bytes for sizes, a count otherwise; null returns to the default.
  value?: uint64 | null;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthWebhooksUpdateResponse { endpoint: string; enabled: bool; }
