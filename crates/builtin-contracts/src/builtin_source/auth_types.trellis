  issuer: string;
  subject: string;
  linkedAt: timestamp;
}
type AuthUserIdentitiesListResponse = CursorPage<AuthUserIdentity>;
model AuthUserIdentityUnlinkRequest { identityId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthIdentityLinkCreateRequest { providerId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthIdentityLinkCreateResponse { authorizationUrl: string; expiresAt: timestamp; }

model AuthOIDCProvider {
