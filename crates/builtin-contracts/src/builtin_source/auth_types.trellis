  username: string;
  hasLocalPassword: bool;
  profileRevision: AuthRevision;
  gravatarEnabled: bool;
}
model AuthUserGetRequest { userId: ulid; }
model AuthUserGetResponse { user: AuthUser; }
type AuthUsersListResponse = CursorPage<AuthUser>;
model AuthUserCreateRequest {
  username: AuthName;
  displayName: AuthName;
  password?: AuthPassword;
  givenName?: AuthName;
  familyName?: AuthName;
  email?: string;
