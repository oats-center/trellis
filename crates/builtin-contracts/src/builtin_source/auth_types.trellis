// Public Auth data. Signed authority, catalog, certificate, and issuer-chain
// bytes are decoded by the shared protocol verifier, not by domain DTO codecs.
type AuthApiId = string(min_length=1, max_length=256);
type AuthCapabilityId = string(min_length=1, max_length=512);
type AuthClientId = string(min_length=1, max_length=2048);
type AuthDigest = string(min_length=1, max_length=128);
type AuthKeyId = string(min_length=1, max_length=128);
type AuthPublicKey = string(min_length=43, max_length=43);
type AuthRevision = uint64(min=1);
type AuthIdempotencyKey = ulid;
type AuthSignedBlob = bytes;
type AuthName = string(min_length=1, max_length=256);
type AuthShortName = string(min_length=1, max_length=128);
type AuthDescription = string(max_length=4096);
type AuthSearch = string(max_length=256);
type AuthCursor = string(min_length=1, max_length=4096);
type AuthPath = string(min_length=1, max_length=4096);
type AuthRegistrySecret = string(min_length=1, max_length=4096);
type AuthPassword = string(min_length=8, max_length=512);
type AuthExistingPassword = string(max_length=512);
type AuthPositiveSeconds = uint32(min=1);
type AuthMachineCode = string(min_length=1, max_length=64);

enum AuthPrincipalKind { user; service; device; }
enum AuthPublicClientKind { browser; native; }
enum AuthBindingKind { browser; native; service; device; }
enum AuthCredentialKind { oauthGrant; provisionedIdentity; }
enum AuthEnforcementState { queued; running; completed; }
enum AuthAuthorizationSessionState { active; superseded; revoked; }
enum AuthAttachmentState { pending; admitted; closed; }
enum AuthDecision { approved; declined; }
/// How a principal holds a capability: a role, a direct grant, a role an
/// identity provider's group gives, being the default administrator, or, for
/// the "account" group, being an active user.
enum AuthCapabilitySourceKind { role; direct; oidcRole; administrator; account; }
enum AuthActionKind { rpc; operation; event; live; transfer; }
enum AuthActionDirection { call; invoke; observe; cancel; control; publish; subscribe; read; write; delete; submit; process; consume; }
enum AuthRevocationReason {
  policyReduced;
  logout;
  credentialRevoked;
  issuerCompromised;
  explicitRevoke;
  loginExpired;
  oauthFamilyRevoked;
  apiForceReplacement;
  deploymentDisabled;
}

model AuthEmpty {}
model AuthErrorDetails { code: AuthMachineCode; }
model AuthPageRequest {
  page?: CursorQuery;
  search?: AuthSearch;
}
model AuthEnforcementProgress {
  workId: ulid;
  state: AuthEnforcementState;
  scannedSessions: uint64;
  retiredSessions: uint64;
  pendingKicks: uint64;
  failedKicks: uint64;
}
model AuthMutationResult {
  revision: AuthRevision;
  enforcement?: AuthEnforcementProgress;
}
model AuthCapabilityIdentity {
  capabilityId: AuthCapabilityId;
  identityGeneration: AuthRevision;
}
model AuthCapabilitySelection {
  requiredCapabilities: list<AuthCapabilityId>;
  optionalCapabilities: list<AuthCapabilityId>;
}
model AuthActionSummary {
  name: AuthName;
  kind: AuthActionKind;
  direction: AuthActionDirection;
}
/// The presentation group users choose access by; ungrouped capabilities
/// belong to their API's own group.
enum AuthCapabilityKind { capability; group; }
/// A capability, or a developer-defined group that stands for its members.
model AuthCapabilityDefinition {
  identity: AuthCapabilityIdentity;
  kind: AuthCapabilityKind;
  apiId: AuthApiId;
  consentRevision: AuthRevision;
  title: string;
  description: string;
  grants: string;
  /// A group's current member capabilities.
  members: list<string>;
  allows: list<AuthActionSummary>;
}
model AuthCapabilitiesListRequest {
  page?: CursorQuery;
  apiId?: AuthApiId;
  search?: AuthSearch;
}
type AuthCapabilitiesListResponse = CursorPage<AuthCapabilityDefinition>;

model AuthRole {
  roleId: ulid;
  identityGeneration: AuthRevision;
  revision: AuthRevision;
  title: string;
  description: string;
  capabilities: list<AuthCapabilityIdentity>;
  /// Auth assigns this role to every user it creates.
  assignToNewUsers: bool;
}
model AuthRoleGetRequest { roleId: ulid; }
model AuthRoleGetResponse { role: AuthRole; }
type AuthRolesListResponse = CursorPage<AuthRole>;
model AuthRolePutRequest {
  roleId?: ulid;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
  title: AuthName;
  description: AuthDescription;
  capabilityIds: list<AuthCapabilityId>;
  /// Assign to every user created from now on; existing users keep their roles.
  assignToNewUsers: bool;
}
model AuthRolePutResponse { role: AuthRole; enforcement?: AuthEnforcementProgress; }
model AuthRoleDeleteRequest {
  roleId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthRoleAssignment {
  assignmentId: ulid;
  principalId: ulid;
  roleId: ulid;
  roleIdentityGeneration: AuthRevision;
  revision: AuthRevision;
  expiresAt?: timestamp;
}
model AuthRoleAssignmentsListRequest {
  principalId?: ulid;
  roleId?: ulid;
  page?: CursorQuery;
}
type AuthRoleAssignmentsListResponse = CursorPage<AuthRoleAssignment>;
model AuthRoleAssignRequest {
  principalId: ulid;
  roleId: ulid;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
  expiresAt?: timestamp;
}
model AuthRoleAssignResponse { assignment: AuthRoleAssignment; enforcement?: AuthEnforcementProgress; }
model AuthRoleRevokeRequest {
  assignmentId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthCapabilityGrant {
  grantId: ulid;
  principalId: ulid;
  capability: AuthCapabilityIdentity;
  revision: AuthRevision;
  expiresAt?: timestamp;
}
model AuthCapabilityGrantsListRequest {
  principalId?: ulid;
  capabilityId?: AuthCapabilityId;
  page?: CursorQuery;
}
type AuthCapabilityGrantsListResponse = CursorPage<AuthCapabilityGrant>;
model AuthCapabilityGrantRequest {
  principalId: ulid;
  capabilityId: AuthCapabilityId;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
  expiresAt?: timestamp;
}
model AuthCapabilityGrantResponse { grant: AuthCapabilityGrant; enforcement?: AuthEnforcementProgress; }
model AuthCapabilityRevokeRequest {
  grantId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthCapabilitySource {
  kind: AuthCapabilitySourceKind;
  roleId?: ulid;
  grantId?: ulid;
  providerId?: ulid;
  mappingId?: ulid;
}
model AuthEffectiveCapability {
  definition: AuthCapabilityDefinition;
  sources: list<AuthCapabilitySource>;
  expiresAt?: timestamp;
}
model AuthPrincipal {
  principalId: ulid;
  kind: AuthPrincipalKind;
  title: string;
  enabled: bool;
  revision: AuthRevision;
  createdAt: timestamp;
}
model AuthPrincipalRequest { principalId: ulid; }
model AuthEffectiveAccessResponse {
  principal: AuthPrincipal;
  capabilities: list<AuthEffectiveCapability>;
}

model AuthPackageSourceEvidence {
  name: AuthName;
  version: AuthShortName;
  digest: AuthDigest;
  source: string;
}
model AuthPackageEvidence {
  rootPackage: AuthName;
  rootDigest: AuthDigest;
  packages: list<AuthPackageSourceEvidence>;
}
model AuthAcceptedApi {
  apiId: AuthApiId;
  title: string;
  description: string;
  /// The authored release version, when the API names one.
  version?: string;
  generation: AuthRevision;
  acceptedRevision: AuthRevision;
  canonicalDigest: AuthDigest;
  acceptedAt: timestamp;
  capabilities: list<AuthCapabilityDefinition>;
}
model AuthApiGetRequest { apiId: AuthApiId; }
/// A domain error an action may return.
model AuthApiActionError {
  name: string;
  /// JSON Schema of the error's data, when it carries any.
  payload?: json;
}
/// One RPC, operation, event or live feed an API offers. Schemas are JSON
/// Schema documents carrying the IDL's descriptions.
model AuthApiAction {
  kind: AuthActionKind;
  /// The action's name, such as `Users.Create`.
  name: string;
  description?: string;
  /// What a caller sends: an RPC's request, an operation's invocation, or a
  /// live feed's request.
  input?: json;
  /// What an RPC returns or an operation completes with.
  output?: json;
  /// An event's data, or each item a live feed sends.
  payload?: json;
  /// An operation's durable progress.
  progress?: json;
  /// An operation's live-only updates.
  update?: json;
  /// An operation's named signals and their data.
  signals: map<json>;
  errors: list<AuthApiActionError>;
  /// The payload fields an event is routed by, as dotted paths.
  params: list<string>;
  /// RPC results come a page at a time.
  paginated: bool;
  /// An operation accepts uploaded bytes.
  upload: bool;
  /// Uploaded bytes go straight to the handler instead of being staged.
  stream: bool;
  /// An RPC result may carry a download.
  download: bool;
}
model AuthApiGetResponse {
  api: AuthAcceptedApi;
  actions: list<AuthApiAction>;
  canonicalIdl: string;
}
type AuthApisListResponse = CursorPage<AuthAcceptedApi>;
model AuthApiReviewRequest { apiId: AuthApiId; packageEvidence: AuthPackageEvidence; }
model AuthCapabilityChange {
  capabilityId: AuthCapabilityId;
  previousConsentRevision?: AuthRevision;
  proposedConsentRevision?: AuthRevision;
  previousIdentityGeneration?: AuthRevision;
  description: string;
}
model AuthApiReview {
  reviewId: ulid;
  apiId: AuthApiId;
  canonicalDigest: AuthDigest;
  currentGeneration?: AuthRevision;
  currentAcceptedRevision?: AuthRevision;
  compatible: bool;
  breakage: list<string>;
  actionChanges: list<AuthActionSummary>;
  capabilityChanges: list<AuthCapabilityChange>;
  affectedRoleIds: list<ulid>;
  affectedDeploymentIds: list<ulid>;
  expiresAt: timestamp;
}
model AuthApiReviewResponse { review: AuthApiReview; }
model AuthReviewedRoleEdit { roleId: ulid; expectedRevision: AuthRevision; capabilityIds: list<AuthCapabilityId>; }
model AuthReviewedMappingEdit { mappingId: ulid; expectedRevision: AuthRevision; roleIds: list<ulid>; }
model AuthApiAcceptRequest {
  reviewId: ulid;
  canonicalDigest: AuthDigest;
  expectedGeneration: uint64;
  expectedAcceptedRevision: uint64;
  roleEdits: list<AuthReviewedRoleEdit>;
  mappingEdits: list<AuthReviewedMappingEdit>;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthApiForceReplaceRequest {
  reviewId: ulid;
  canonicalDigest: AuthDigest;
  expectedGeneration: AuthRevision;
  expectedAcceptedRevision: AuthRevision;
  acknowledgeBreakage: bool;
  acknowledgeConsentImpact: bool;
  roleEdits: list<AuthReviewedRoleEdit>;
  mappingEdits: list<AuthReviewedMappingEdit>;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthApiAcceptResponse { api: AuthAcceptedApi; enforcement?: AuthEnforcementProgress; }

model AuthOAuthClient {
  clientId: AuthClientId;
  kind: AuthPublicClientKind;
  title: string;
  description: string;
  redirectUris: list<string>;
  development: bool;
  enabled: bool;
  impliedConsent: list<AuthCapabilityId>;
  signUp: AuthOAuthClientSignUp;
  revision: AuthRevision;
}
/// Ways someone signing in to the app may create their own account. Each new
/// account gets the roles marked for new users.
model AuthOAuthClientSignUp {
  /// A username and password chosen on the Portal.
  password: bool;
  /// A first sign-in with an active identity provider.
  providers: bool;
}
model AuthOAuthClientGetRequest { clientId: AuthClientId; }
model AuthOAuthClientGetResponse { client: AuthOAuthClient; }
type AuthOAuthClientsListResponse = CursorPage<AuthOAuthClient>;
model AuthOAuthClientPutRequest {
  clientId: AuthClientId;
  kind: AuthPublicClientKind;
  title: AuthName;
  description: AuthDescription;
  redirectUris: list<string>;
  development: bool;
  impliedConsent: list<AuthCapabilityId>;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
/// Shortest local password Auth accepts, in characters (Unicode code points).
type AuthPasswordMinLength = uint32(min=8, max=128);
/// How users may sign in to this installation. Takes effect immediately.
/// OIDC sign-in is on exactly when an OIDC provider is enabled; at least one
/// of local users and an enabled provider stays available.
model AuthSignInSettings {
  /// Sign in with a username and password.
  localUsers: bool;
  /// Create your own username-and-password account, through apps that also
  /// allow it. Needs localUsers.
  localSignUp: bool;
  /// Every new or changed local password, including sign-up, is at least
  /// this long. Existing passwords are not checked again.
  passwordMinLength: AuthPasswordMinLength;
  revision: AuthRevision;
}
model AuthSignInSettingsGetResponse { settings: AuthSignInSettings; }
model AuthSignInSettingsUpdateRequest {
  localUsers: bool;
  localSignUp: bool;
  passwordMinLength: AuthPasswordMinLength;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOAuthClientSignUpUpdateRequest {
  clientId: AuthClientId;
  signUp: AuthOAuthClientSignUp;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOAuthClientMutationRequest {
  clientId: AuthClientId;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
enum AuthPortalLogoFormat { png; jpeg; webp; svg; }
/// At most 256 KiB once decoded.
type AuthPortalLogoData = string(min_length=1, max_length=349528);
type AuthPortalName = string(min_length=1, max_length=64);
type AuthPortalStylesheet = string(max_length=65536);
type AuthPortalTitle = string(max_length=120);
type AuthPortalSubtitle = string(max_length=280);
type AuthPortalFooter = string(max_length=500);
model AuthPortalLogo { format: AuthPortalLogoFormat; base64: AuthPortalLogoData; }
/// Hex colours such as #0050b3 for the Portal's own palette.
model AuthPortalPalette {
  page?: string;
  surface?: string;
  ink?: string;
  muted?: string;
  line?: string;
  lineStrong?: string;
  primary?: string;
  primaryHover?: string;
  onPrimary?: string;
  soft?: string;
}
model AuthPortalCopy {
  signInTitle?: AuthPortalTitle;
  signInSubtitle?: AuthPortalSubtitle;
  footer?: AuthPortalFooter;
}
/// Without clientId, the installation theme every client inherits.
model AuthPortalTheme {
  clientId?: AuthClientId;
  name?: AuthPortalName;
  logo?: AuthPortalLogo;
  stylesheet?: AuthPortalStylesheet;
  colors: AuthPortalPalette;
  darkColors: AuthPortalPalette;
  copy: AuthPortalCopy;
  revision: AuthRevision;
  updatedAt: timestamp;
}
model AuthPortalThemeSummary {
  clientId?: AuthClientId;
  name?: string;
  revision: AuthRevision;
  updatedAt: timestamp;
}
type AuthPortalThemesListResponse = CursorPage<AuthPortalThemeSummary>;
model AuthPortalThemeGetRequest { clientId?: AuthClientId; }
model AuthPortalThemeGetResponse { theme?: AuthPortalTheme; }
/// Replaces the whole theme; only the installation theme takes a stylesheet.
model AuthPortalThemePutRequest {
  clientId?: AuthClientId;
  name?: AuthPortalName;
  logo?: AuthPortalLogo;
  stylesheet?: AuthPortalStylesheet;
  colors: AuthPortalPalette;
  darkColors: AuthPortalPalette;
  copy: AuthPortalCopy;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthPortalThemeDeleteRequest {
  clientId?: AuthClientId;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDelegationBinding {
  kind: AuthPublicClientKind;
  clientId: AuthClientId;
  origin?: string;
  durableDpopJkt?: string;
}
model AuthConsentChoice {
  capability: AuthCapabilityIdentity;
  consentRevision: AuthRevision;
  decision: AuthDecision;
  expiresAt?: timestamp;
}
model AuthDelegation {
  delegationId: ulid;
  principalId: ulid;
  binding: AuthDelegationBinding;
  choices: list<AuthConsentChoice>;
  revision: AuthRevision;
}
model AuthDelegationsListRequest {
  principalId?: ulid;
  clientId?: AuthClientId;
  page?: CursorQuery;
}
type AuthDelegationsListResponse = CursorPage<AuthDelegation>;
model AuthDelegationReviewRequest { delegationId: ulid; }
model AuthDelegationReviewResponse { delegation: AuthDelegation; currentCapabilities: list<AuthCapabilityDefinition>; }
model AuthDelegationRevokeRequest {
  delegationId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthRuntimeBinding {
  kind: AuthBindingKind;
  clientId?: AuthClientId;
  origin?: string;
  durableDpopJkt?: string;
  deploymentId?: ulid;
  instanceId?: ulid;
  participantId?: string;
}
model AuthAuthorizationSession {
  authorizationSessionId: ulid;
  principalId: ulid;
  principalKind: AuthPrincipalKind;
  binding: AuthRuntimeBinding;
  runtimeId: string;
  sessionPublicKey: AuthPublicKey;
  credentialKind: AuthCredentialKind;
  loginSessionId?: ulid;
  oauthGrantId?: ulid;
  identityKeyId?: AuthKeyId;
  state: AuthAuthorizationSessionState;
  createdAt: timestamp;
  notAfter?: timestamp;
  maximumContextExpiresAt?: timestamp;
  retiredAt?: timestamp;
  reason?: AuthRevocationReason;
}
model AuthAuthorizationSessionsListRequest {
  principalId?: ulid;
  clientId?: AuthClientId;
  loginSessionId?: ulid;
  oauthGrantId?: ulid;
  deploymentId?: ulid;
  state?: AuthAuthorizationSessionState;
  page?: CursorQuery;
}
type AuthAuthorizationSessionsListResponse = CursorPage<AuthAuthorizationSession>;
model AuthAuthorizationSessionRevokeRequest {
  authorizationSessionId: ulid;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthAuthorizationSessionRevokeResponse {
  authorizationSessionId: ulid;
  retiredAt: timestamp;
  enforcement: AuthEnforcementProgress;
}
model AuthAttachment {
  attachmentId: ulid;
  authorizationSessionId: ulid;
  serverId: string;
  brokerClientId: uint64;
  sessionPublicKey: AuthPublicKey;
  admittedTransportPolicyDigest: AuthDigest;
  state: AuthAttachmentState;
  admittedAt?: timestamp;
  closedAt?: timestamp;
}
model AuthConnectionsListRequest {
  authorizationSessionId?: ulid;
  principalId?: ulid;
  state?: AuthAttachmentState;
  page?: CursorQuery;
}
type AuthConnectionsListResponse = CursorPage<AuthAttachment>;
model AuthConnectionsKickRequest { attachmentId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthConnectionsKickResponse { attachmentId: ulid; enforcement: AuthEnforcementProgress; }
model AuthAuthorityRenewRequest { contextDigest: AuthDigest; }
model AuthAuthorityRenewResponse {
  contextDigest: AuthDigest;
  authority: AuthSignedBlob;
  catalog: AuthSignedBlob;
  providers: list<AuthSignedBlob>;
}
model AuthAdmissionRenewRequest { contextDigest: AuthDigest; }
model AuthAdmissionRenewResponse { admissionCredential: string; expiresAt: timestamp; }
model AuthIssuerRotateRequest { expectedCurrentKeyId: AuthKeyId; idempotencyKey: AuthIdempotencyKey; }
model AuthIssuerRotateResponse { keyId: AuthKeyId; rotation: AuthSignedBlob; }
model AuthIssuerRevokeRequest { keyId: AuthKeyId; idempotencyKey: AuthIdempotencyKey; }
model AuthIssuerRevokeResponse { keyId: AuthKeyId; enforcement: AuthEnforcementProgress; }

enum AuthLoginMethod { local; oidc; }
enum AuthLoginState { active; revoked; }
model AuthLoginSession {
  loginSessionId: ulid;
  principalId: ulid;
  method: AuthLoginMethod;
  providerId?: ulid;
  createdAt: timestamp;
  expiresAt: timestamp;
  claimFreshUntil?: timestamp;
  state: AuthLoginState;
}
type AuthSessionsListResponse = CursorPage<AuthLoginSession>;
model AuthSessionsMeResponse { principal: AuthPrincipal; login?: AuthLoginSession; authorizationSessionId: ulid; }
model AuthSessionsLogoutResponse { loginSessionId: ulid; enforcement: AuthEnforcementProgress; }
/// The Trellis server the caller is connected to.
model AuthRuntimeVersionResponse {
  /// The running server's version.
  version: string;
  /// A newer release on the server's channel. Only administrators see it.
  update?: AuthRuntimeUpdate;
}
model AuthRuntimeUpdate {
  /// The newest release's version.
  version: string;
  /// When the server last asked GitHub.
  checkedAt: timestamp;
}
model AuthLoginRevokeRequest { loginSessionId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthUser {
  principalId: ulid;
  displayName: string;
  givenName?: string;
  familyName?: string;
  email?: string;
  emailVerified: bool;
  avatarUrl?: string;
  account?: AuthUserAccountDetails;
}
model AuthUserAccountDetails {
  principal: AuthPrincipal;
  username: string;
  hasLocalPassword: bool;
  profileRevision: AuthRevision;
  /// The linked OIDC sign-in whose picture the account shows. Absent, it
  /// shows the Gravatar for its email.
  pictureProviderId?: ulid;
}
model AuthUserGetRequest { userId: ulid; }
/// Exactly one key: a user ID, or an OIDC sign-in.
model AuthUserFindRequest { userId?: ulid; identity?: AuthUserFindIdentity; }
/// An OIDC sign-in: the configured provider's ID and the provider's exact `sub`.
model AuthUserFindIdentity { providerId: ulid; subject: string; }
/// Absent when no account matches.
model AuthUserFindResponse { found?: AuthUserFindMatch; }
/// The account, with its state and revision in `user.account.principal`, and
/// every OIDC sign-in linked to it.
model AuthUserFindMatch { user: AuthUser; identities: list<AuthUserIdentity>; }
model AuthUserGetResponse { user: AuthUser; }
type AuthUsersListResponse = CursorPage<AuthUser>;
model AuthUserCreateRequest {
  username: AuthName;
  displayName: AuthName;
  password?: AuthPassword;
  givenName?: AuthName;
  familyName?: AuthName;
  email?: string;
  /// OIDC sign-ins to link to the new account in the same transaction. Each
  /// provider must be enabled, and a sign-in another user has fails the whole
  /// creation with `identity_linked_to_another_user`.
  identities?: list<AuthUserFindIdentity>;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthUserUpdateRequest {
  userId: ulid;
  displayName?: AuthName;
  enabled: bool;
  givenName?: AuthName;
  familyName?: AuthName;
  email?: string;
  clearEmail?: bool;
  expectedRevision: AuthRevision;
  expectedProfileRevision?: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthUserDeleteRequest {
  userId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthUserProfileUpdateRequest {
  displayName?: AuthName;
  givenName?: AuthName;
  familyName?: AuthName;
  email?: string;
  clearEmail?: bool;
  /// Show the picture from this linked OIDC sign-in.
  pictureProviderId?: ulid;
  /// Show the Gravatar for the account's email instead of an OIDC sign-in's picture.
  useGravatar?: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthPasswordChangeRequest {
  currentPassword: AuthExistingPassword;
  newPassword: AuthPassword;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthPasswordResetCreateRequest { userId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthPasswordResetCreateResponse { token: string; expiresAt: timestamp; }
model AuthUserIdentity {
  identityId: ulid;
  providerId: ulid;
  issuer: string;
  subject: string;
  linkedAt: timestamp;
}
type AuthUserIdentitiesListResponse = CursorPage<AuthUserIdentity>;
model AuthUserIdentityUnlinkRequest { identityId: ulid; idempotencyKey: AuthIdempotencyKey; }
/// An administrator links an OIDC sign-in to an account. `expectedRevision` is
/// the account's `user.account.principal.revision`.
model AuthUserIdentitiesLinkRequest {
  userId: ulid;
  identity: AuthUserFindIdentity;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
/// An administrator removes an OIDC sign-in from an account. `expectedRevision`
/// is the account's `user.account.principal.revision`.
model AuthUserIdentitiesUnlinkRequest {
  userId: ulid;
  identity: AuthUserFindIdentity;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthIdentityLinkCreateRequest { providerId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthIdentityLinkCreateResponse { authorizationUrl: string; expiresAt: timestamp; }
/** An OIDC provider a person can link to their own account. */
model AuthIdentityLinkProvider { providerId: ulid; title: string; }
model AuthIdentityLinkProvidersResponse { providers: list<AuthIdentityLinkProvider>; }

/// The `prompt` Auth sends the provider on the first OIDC sign-in after this
/// browser signed out: `login` (OIDC `prompt=login`) asks for credentials
/// again; `selectAccount` (`select_account`) shows an account chooser, which
/// lets the person pick an account but does not prove they signed in again;
/// `consent` asks the person to approve this Trellis again; `none` sends no
/// prompt, so the provider may sign the person straight back in.
enum AuthOIDCSignOutPrompt { login; selectAccount; consent; none; }

/// A parameter Auth adds to every authorization request it sends the
/// provider, for sign-in and for linking, such as Auth0's
/// `organization=<org id>`.
model AuthOIDCAuthorizationParameter { name: string; value: string; }

model AuthOIDCProvider {
  providerId: ulid;
  issuer: string;
  clientId: string;
  title: string;
  enabled: bool;
  scopes: list<string>;
  roleClaim: string;
  claimFreshnessSeconds: AuthPositiveSeconds;
  hasClientSecret: bool;
  /// SHA-256 fingerprint of the issuer certificate Auth trusts for this
  /// provider besides the system trust store, as colon-separated uppercase
  /// hex. Absent when the provider relies on the system trust store alone.
  certificateFingerprint?: string;
  promptAfterSignOut: AuthOIDCSignOutPrompt;
  authorizationParameters: list<AuthOIDCAuthorizationParameter>;
  revision: AuthRevision;
}
model AuthOIDCProviderGetRequest { providerId: ulid; }
model AuthOIDCProviderGetResponse { provider: AuthOIDCProvider; }
type AuthOIDCProvidersListResponse = CursorPage<AuthOIDCProvider>;
model AuthOIDCProviderPutRequest {
  providerId?: ulid;
  issuer: string;
  clientId: string;
  title: AuthName;
  scopes: list<string>;
  roleClaim: string;
  claimFreshnessSeconds: AuthPositiveSeconds;
  clientSecret?: string;
  /// Trust the issuer certificate with this SHA-256 fingerprint for this
  /// provider, for an issuer whose certificate nothing on the server vouches
  /// for. Auth reads the chain the issuer presents and refuses the change when
  /// its issuer has another fingerprint. Left out, the provider keeps its
  /// current pin; `null` removes it.
  certificateFingerprint?: string | null;
  /// Left out, `login`.
  promptAfterSignOut?: AuthOIDCSignOutPrompt;
  /// At most 16, with unique names of letters, digits, `-`, `_` and `.`.
  /// Names Auth sets itself (`client_id`, `redirect_uri`, `response_type`,
  /// `scope`, `state`, `nonce`, `code_challenge`, `code_challenge_method` and
  /// `prompt`) are refused. Left out, none.
  authorizationParameters?: list<AuthOIDCAuthorizationParameter>;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOIDCProviderMutationRequest {
  providerId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOIDCRoleMapping {
  mappingId: ulid;
  providerId: ulid;
  externalRole: string;
  roleIds: list<ulid>;
  revision: AuthRevision;
}
model AuthOIDCRoleMappingsListRequest { providerId: ulid; page?: CursorQuery; }
type AuthOIDCRoleMappingsListResponse = CursorPage<AuthOIDCRoleMapping>;
model AuthOIDCRoleMappingPutRequest {
  mappingId?: ulid;
  providerId: ulid;
  externalRole: AuthName;
  roleIds: list<ulid>;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOIDCRoleMappingPutResponse { mapping: AuthOIDCRoleMapping; enforcement?: AuthEnforcementProgress; }
model AuthOIDCRoleMappingDeleteRequest {
  mappingId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}

enum AuthDeploymentKind { service; device; }
enum AuthDeploymentState { enabled; disabled; removed; }
enum AuthResourceKind { kv; store; state; job; eventConsumer; webhook; }
model AuthDeployment {
  deploymentId: ulid;
  title: string;
  kind: AuthDeploymentKind;
  participantId: string;
  implementationDigest: AuthDigest;
  selection: AuthCapabilitySelection;
  state: AuthDeploymentState;
  revision: AuthRevision;
}
model AuthDeploymentCreateRequest {
  title: AuthName;
  kind: AuthDeploymentKind;
  participantId: string;
  packageEvidence: AuthPackageEvidence;
  acknowledgeSharedApis?: bool;
  /// Confirms approving webhook endpoints that check nothing (`verify none`).
  acknowledgeUnauthenticatedWebhooks?: bool;
  idempotencyKey: AuthIdempotencyKey;
}
/// One IDL file of a package.
model AuthPackageFile {
  /// The file's path relative to the package's trellis.toml, or just its name.
  path: AuthPath;
  text: string;
}
/// A package's own IDL: its manifest when it has one, and its `.trellis` files.
model AuthPackageSources {
  /// The package's trellis.toml. Its listed sources are found among `files` by path, or by file name when only one file has it.
  manifest?: string;
  /// The package name, when there is no manifest.
  name?: AuthName;
  /// The package version, when there is no manifest.
  version?: AuthShortName;
  files: list<AuthPackageFile>;
}
model AuthPackageResolveRequest {
  /// The package that declares the service or device.
  root: AuthPackageSources;
  /// Packages supplied for dependencies Trellis does not hold. Each is used before any package Trellis holds with the same name.
  packages?: list<AuthPackageSources>;
}
enum AuthPackageOrigin { builtin; installed; supplied; registry; }
/// The package chosen for one dependency.
model AuthResolvedPackage {
  name: AuthName;
  version: AuthShortName;
  origin: AuthPackageOrigin;
  /// Other versions Trellis holds that also match, newest first. The highest matching version is chosen.
  otherVersions: list<AuthShortName>;
}
/// A dependency no held or supplied package satisfies.
model AuthMissingPackage {
  name: AuthName;
  /// The version requirements its dependents state; empty when any version does.
  requirements: list<string>;
  /// The packages that depend on it.
  requiredBy: list<AuthName>;
  /// Versions held or supplied that do not match, newest first.
  availableVersions: list<AuthShortName>;
}
model AuthResolvedParticipant {
  participantId: string;
  kind: AuthDeploymentKind;
  /// The settings it declares.
  config: list<AuthConfigDeclaration>;
}
model AuthPackageResolveResponse {
  /// The complete evidence for `Deployments.Create`, once every dependency resolved.
  packageEvidence?: AuthPackageEvidence;
  /// The root package's services and devices.
  participants: list<AuthResolvedParticipant>;
  /// The package chosen for each dependency, by name.
  dependencies: list<AuthResolvedPackage>;
  missing: list<AuthMissingPackage>;
  /// Imports, in a package without trellis.toml, that name no package Trellis holds or was supplied. Only its trellis.toml can say what they are.
  unknownImports: list<string>;
  /// Supplied packages that don't compile, with why. Nothing else was compiled; resolve again without them.
  rejected: list<AuthRejectedPackage>;
}
/// A supplied package that doesn't compile.
model AuthRejectedPackage {
  /// Its position in the request's `packages`, which says which files were at fault whatever their manifest names.
  index: uint32;
  /// The package name its trellis.toml gives.
  name: AuthName;
  reason: string;
}
/// A registry Trellis pulls published packages from.
model AuthPackageRegistry {
  name: AuthShortName;
  /// The workspace Trellis signs in to this registry for, such as `ghcr.io/oats-center`. A package's repository is its workspace followed by its name.
  prefix: AuthName;
  /// The user Trellis signs in to the registry as; absent when it pulls anonymously.
  username?: AuthName;
  updatedAt: timestamp;
}
model AuthPackageRegistriesListResponse { registries: list<AuthPackageRegistry>; }
/// How Trellis signs in to a private registry. The secret is sealed with the storage key and never returned.
model AuthPackageRegistryCredentials {
  username: AuthName;
  /// A password or access token.
  secret: AuthRegistrySecret;
}
model AuthPackageRegistryPutRequest {
  name: AuthShortName;
  prefix: AuthName;
  /// Absent to pull anonymously, as a public registry allows. Putting a registry again replaces its credentials.
  credentials?: AuthPackageRegistryCredentials;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthPackageRegistryPutResponse { registry: AuthPackageRegistry; }
model AuthPackageRegistryRemoveRequest {
  name: AuthShortName;
  idempotencyKey: AuthIdempotencyKey;
}
/// A published package release. Give exactly one of `version` and `digest`.
model AuthPackagePullRequest {
  /// The package's full identity, such as `ghcr.io/acme/orders`, which is also its repository. Trellis signs in with the registry added for its workspace, or pulls anonymously.
  package: AuthName;
  /// The release version, such as `1.2.0`.
  version?: AuthShortName;
  /// The release's OCI manifest digest, such as `sha256:…`, to get exactly the release that was reviewed.
  digest?: AuthDigest;
}
/// The release a pull fetched and checked.
model AuthPublishedPackage {
  /// The package's full identity.
  package: AuthName;
  version: AuthShortName;
  /// The release's OCI manifest digest; pulling by it gets exactly this release again.
  digest: AuthDigest;
}
model AuthPackagePullResponse {
  published: AuthPublishedPackage;
  /// The complete evidence for `Deployments.Create` or `Deployments.Apply`, compiled from the release and the exact dependencies it was published with.
  packageEvidence: AuthPackageEvidence;
  /// The package's services and devices.
  participants: list<AuthResolvedParticipant>;
  /// The dependencies it was published with.
  dependencies: list<AuthResolvedPackage>;
}
model AuthDeploymentGetRequest { deploymentId: ulid; }
model AuthDeploymentGetResponse { deployment: AuthDeployment; }
type AuthDeploymentsListResponse = CursorPage<AuthDeployment>;
model AuthDeploymentApplyRequest {
  deploymentId: ulid;
  packageEvidence: AuthPackageEvidence;
  acknowledgeSharedApis?: bool;
  /// Confirms approving webhook endpoints that check nothing (`verify none`).
  acknowledgeUnauthenticatedWebhooks?: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeploymentMutationRequest {
  deploymentId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeploymentMutationResponse { deployment: AuthDeployment; enforcement?: AuthEnforcementProgress; }
enum AuthServiceUpdateState { pending; applied; rejected; superseded; }
model AuthServiceUpdateResource {
  kind: AuthResourceKind;
  name: string;
}
/// A webhook endpoint as an approver sees it.
model AuthWebhookSummary {
  name: string;
  title: string;
  mode: string;
  methods: list<string>;
  /// Each verifier in plain words.
  verifiers: list<string>;
  decides: bool;
  /// The endpoint checks nothing; approving it needs acknowledgeUnauthenticatedWebhooks.
  unauthenticated: bool;
}
model AuthServiceUpdateChanges {
  addedCapabilities: list<AuthCapabilityId>;
  removedCapabilities: list<AuthCapabilityId>;
  addedResources: list<AuthServiceUpdateResource>;
  reattachedResources: list<AuthServiceUpdateResource>;
  changedResources: list<AuthServiceUpdateResource>;
  removedResources: list<AuthServiceUpdateResource>;
  addedApis: list<AuthApiId>;
  sharedApis: list<AuthApiId>;
  /// Webhook endpoints the build adds or changes, described for approval.
  webhooks: list<AuthWebhookSummary>;
  removedApis: list<AuthApiId>;
  acceptedApis: list<AuthApiId>;
  acceptedUsedApis: list<AuthApiId>;
}
enum AuthServiceUpdateDeciderKind { user; automatic; }
/// Who decided a service update.
model AuthServiceUpdateDecider {
  /// `user` for a person's decision; `automatic` when Trellis decided without asking, such as installing a build that asked for no more access.
  kind: AuthServiceUpdateDeciderKind;
  /// The user who decided, for `user`.
  principalId?: ulid;
  /// The user's display name, or their username, for `user`.
  name?: string;
}
model AuthServiceUpdate {
  updateId: ulid;
  deploymentId: ulid;
  instanceId: ulid;
  participantId: string;
  participantDigest: AuthDigest;
  state: AuthServiceUpdateState;
  changes: AuthServiceUpdateChanges;
  reviewUrl?: string;
  requestedAt: timestamp;
  decidedAt?: timestamp;
  decidedBy?: AuthServiceUpdateDecider;
  revision: AuthRevision;
}
model AuthServiceUpdateSubmitRequest { participantId: string; packageEvidence: AuthPackageEvidence; }
enum AuthServiceClaimState { waiting; claimed; removed; }
/// A service deployment that takes whatever service first connects with its
/// identity. The connecting service submits its IDL as an update to the claim;
/// approving it creates the deployment (`deploymentId`) and its instance.
model AuthServiceClaim {
  claimId: ulid;
  title: AuthName;
  instanceTitle: AuthName;
  state: AuthServiceClaimState;
  deploymentId?: ulid;
  createdAt: timestamp;
  revision: AuthRevision;
}
model AuthServiceClaimCreateRequest {
  title: AuthName;
  instanceTitle: AuthName;
  identityPublicKey: AuthPublicKey;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthServiceClaimRemoveRequest {
  claimId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthServiceClaimResponse { claim: AuthServiceClaim; }
type AuthServiceClaimsListResponse = CursorPage<AuthServiceClaim>;
model AuthServiceUpdateStatusRequest { updateId: ulid; }
model AuthServiceUpdateResponse { update: AuthServiceUpdate; }
model AuthServiceUpdatesListRequest { deploymentId?: ulid; page?: CursorQuery; }
type AuthServiceUpdatesListResponse = CursorPage<AuthServiceUpdate>;
model AuthServiceUpdateDecideRequest {
  updateId: ulid;
  decision: AuthDecision;
  acknowledgeSharedApis?: bool;
  /// Confirms approving webhook endpoints that check nothing (`verify none`).
  acknowledgeUnauthenticatedWebhooks?: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
/// `removed`: an administrator removed it. `retired`: Trellis retired it
/// automatically (see `retiredReason`). Neither can connect or be turned on again.
enum AuthInstanceState { active; disabled; removed; retired; }
enum AuthInstanceOriginKind { provisioned; enrolled; }
/// How an instance came to exist: an administrator provisioned it, or a
/// process enrolled it with an enrollment secret.
model AuthInstanceOrigin {
  kind: AuthInstanceOriginKind;
  /// The enrollment secret that created it.
  secretId?: ulid;
  secretTitle?: AuthName;
}
/// Why Trellis retired an instance: `offline` past the retirement period,
/// `stopped` (it retired itself at a graceful stop), `replaced` (its secret was
/// at its cap and a new enrollment took its place), or `secretRevoked` (its
/// secret was revoked with `retireInstances`).
enum AuthRetiredReason { offline; stopped; replaced; secretRevoked; }
model AuthProvisionedInstance {
  instanceId: ulid;
  principal: AuthPrincipal;
  deploymentId: ulid;
  /// `removed` and `retired` instances keep their record for a while but can never connect or be turned on again.
  state: AuthInstanceState;
  origin: AuthInstanceOrigin;
  /// When one of its connections was last admitted or closed. Absent until it first connects.
  lastSeenAt?: timestamp;
  retiredAt?: timestamp;
  retiredReason?: AuthRetiredReason;
  /// Whether the instance runs the deployment's installed build. One that does not cannot be turned on until it connects with that build.
  upToDate: bool;
  identityPublicKey?: AuthPublicKey;
  revision: AuthRevision;
  /// Digest of the build the instance's installed revision names.
  participantDigest?: AuthDigest;
  /// When the instance's current connection began. Absent while it is not connected.
  connectedAt?: timestamp;
  /// What the connected instance waits for before it can serve. Absent when it waits for nothing Trellis holds.
  waiting?: AuthInstanceWaiting;
}
/// What a connected instance waits for before it can serve.
model AuthInstanceWaiting {
  /// The update its build submitted, waiting for an administrator.
  update?: AuthInstanceWaitingUpdate;
  /// Required settings its build has no value for.
  missingSettings: list<AuthConfigFieldName>;
  /// Console page where an administrator sets them.
  settingsUrl?: string;
}
model AuthInstanceWaitingUpdate {
  updateId: ulid;
  /// Console page where an administrator reviews the update. Absent when the installation serves no Console.
  reviewUrl?: string;
}
model AuthInstancesListRequest { deploymentId?: ulid; page?: CursorQuery; }
type AuthInstancesListResponse = CursorPage<AuthProvisionedInstance>;
model AuthInstanceProvisionRequest {
  deploymentId: ulid;
  title: AuthName;
  identityPublicKey?: AuthPublicKey;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthInstanceProvisionResponse { instance: AuthProvisionedInstance; provisioningSecret?: string; }
model AuthInstanceMutationRequest {
  instanceId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthInstanceMutationResponse { instance: AuthProvisionedInstance; enforcement?: AuthEnforcementProgress; }

type AuthEnrollmentLimit = uint32(min=1, max=1000000);
type AuthRetirementSeconds = uint32(min=3600);
type AuthRecordDays = uint32(min=1, max=36500);
type AuthGraceSeconds = uint32(max=86400);
type AuthEnrollmentSecretText = string(min_length=1, max_length=256);
/// A secret that lets the processes holding it register themselves as new
/// instances of one deployment. Only its hash is kept.
model AuthEnrollmentSecret {
  secretId: ulid;
  deploymentId: ulid;
  title: AuthName;
  /// After this it creates no more instances. Absent: it works until revoked.
  expiresAt?: timestamp;
  /// The most instances it may have at once, counting those not retired or removed.
  maxInstances: AuthEnrollmentLimit;
  /// The most new instances it may create in any hour.
  enrollmentsPerHour: AuthEnrollmentLimit;
  /// Its instances may only run the deployment's installed build: their own updates are refused.
  currentBuildOnly: bool;
  /// Instances it created that are not retired or removed.
  instances: uint64;
  createdAt: timestamp;
  /// When it last created an instance.
  lastUsedAt?: timestamp;
  revokedAt?: timestamp;
  revision: AuthRevision;
  /// What went wrong with it in the last 24 hours. Empty when nothing did.
  alerts: list<AuthEnrollmentAlert>;
}
/// `revokedUsed` and `expiredUsed`: someone presented it after it stopped
/// working, so a copy is still out there. `instanceLimit` and `rateLimited`: it
/// hit its cap or hourly rate. `participantMismatch` and `buildMismatch`: a
/// process of another service, or with another build, presented it.
enum AuthEnrollmentAlertKind { revokedUsed; expiredUsed; instanceLimit; rateLimited; participantMismatch; buildMismatch; }
model AuthEnrollmentAlert {
  kind: AuthEnrollmentAlertKind;
  count: uint64;
  lastAt: timestamp;
}
model AuthEnrollmentSecretIssueRequest {
  deploymentId: ulid;
  title: AuthName;
  expiresAt?: timestamp;
  /// Absent takes the installation's `secretMaxInstances`.
  maxInstances?: AuthEnrollmentLimit;
  /// Absent takes the installation's `secretEnrollmentsPerHour`.
  enrollmentsPerHour?: AuthEnrollmentLimit;
  currentBuildOnly?: bool;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthEnrollmentSecretIssueResponse {
  secret: AuthEnrollmentSecret;
  /// The secret, shown only in the first response. Trellis keeps only its
  /// hash, so a repeated request with the same idempotency key returns the
  /// record without it.
  text?: string;
}
model AuthEnrollmentSecretsListRequest { deploymentId: ulid; page?: CursorQuery; }
type AuthEnrollmentSecretsListResponse = CursorPage<AuthEnrollmentSecret>;
/// Replaces the secret's title and limits; an absent `expiresAt` means it never expires.
model AuthEnrollmentSecretUpdateRequest {
  secretId: ulid;
  title: AuthName;
  expiresAt?: timestamp;
  maxInstances: AuthEnrollmentLimit;
  enrollmentsPerHour: AuthEnrollmentLimit;
  currentBuildOnly: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthEnrollmentSecretResponse { secret: AuthEnrollmentSecret; }
model AuthEnrollmentSecretRevokeRequest {
  secretId: ulid;
  /// Also retire every instance the secret created, which disconnects them.
  retireInstances?: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthEnrollmentSecretRevokeResponse {
  secret: AuthEnrollmentSecret;
  /// Instances retired with the secret.
  retiredInstances: uint64;
  /// Connections of those instances that were still open when the revocation
  /// committed. Trellis closes them through its enforcement pipeline.
  closingConnections: uint64;
}
/// The installation's rules for enrolled and offline instances.
model AuthInstallationInstancePolicy {
  /// Whether instances offline longer than `retireOfflineAfterSeconds` are retired.
  retireOffline: bool;
  retireOfflineAfterSeconds: AuthRetirementSeconds;
  /// Whether provisioned instances are retired too, not only enrolled ones.
  retireProvisioned: bool;
  /// Days a retired or removed instance's record is kept.
  retiredRecordDays: AuthRecordDays;
  /// How long a just-enrolled instance that has not connected yet is protected from replacement.
  firstConnectGraceSeconds: AuthGraceSeconds;
  /// The instance cap a new secret takes.
  secretMaxInstances: AuthEnrollmentLimit;
  /// The hourly rate a new secret takes.
  secretEnrollmentsPerHour: AuthEnrollmentLimit;
}
/// One deployment's own retirement rules. An absent field follows the installation.
model AuthDeploymentInstancePolicy {
  retireOffline?: bool;
  retireOfflineAfterSeconds?: AuthRetirementSeconds;
  retireProvisioned?: bool;
}
/// The retirement rules that apply to one deployment.
model AuthEffectiveInstancePolicy {
  retireOffline: bool;
  retireOfflineAfterSeconds: AuthRetirementSeconds;
  retireProvisioned: bool;
}
model AuthInstancePolicyGetRequest { deploymentId?: ulid; }
model AuthInstancePolicyResponse {
  installation: AuthInstallationInstancePolicy;
  /// With `deploymentId`: what the deployment sets itself.
  deployment?: AuthDeploymentInstancePolicy;
  /// With `deploymentId`: what applies to it.
  effective?: AuthEffectiveInstancePolicy;
}
/// Without `deploymentId`, replaces the installation's rules with
/// `installation`. With it, replaces the deployment's own rules with
/// `deployment` (absent clears them).
model AuthInstancePolicySetRequest {
  deploymentId?: ulid;
  installation?: AuthInstallationInstancePolicy;
  deployment?: AuthDeploymentInstancePolicy;
  idempotencyKey: AuthIdempotencyKey;
}
/// Sent to `POST /auth/service/enroll` by a process that holds an enrollment
/// secret. `proof` is the new identity key's signature over the rest.
model AuthServiceEnrollmentRequest {
  requestId: ulid;
  iat: AuthDeviceProofIssuedAt;
  enrollmentSecret: AuthEnrollmentSecretText;
  identityKeyId: AuthDigest;
  identityPublicKey: AuthPublicKey;
  participantId: string;
  participantDigest: AuthDigest;
  title: AuthName;
  proof: AuthDeviceProof;
}
model AuthServiceEnrollmentResponse {
  instanceId: ulid;
  deploymentId: ulid;
  title: AuthName;
}
/// Sent to `POST /auth/service/identity` by a process that holds an identity
/// key, to learn what became of it. `proof` is the key's signature over the rest.
model AuthServiceIdentityStatusRequest {
  requestId: ulid;
  iat: AuthDeviceProofIssuedAt;
  identityKeyId: AuthDigest;
  identityPublicKey: AuthPublicKey;
  proof: AuthDeviceProof;
}
/// `removed`: an administrator removed its instance; the process should stop.
/// `retired` or `unregistered`: the key will never connect, so a process with an
/// enrollment secret enrolls a new one. `active` and `disabled`: the key is
/// still registered.
enum AuthServiceIdentityState { active; disabled; removed; retired; unregistered; }
model AuthServiceIdentityStatusResponse { state: AuthServiceIdentityState; }
type AuthDeviceConfirmationCode = string(min_length=8, max_length=8);
type AuthDeviceProvisioningSecret = string(min_length=43, max_length=43);
/// JSON-number Unix milliseconds; the session-proof verifier also requires an integer.
type AuthDeviceProofIssuedAt = number(min=0, max=9007199254740991);
model AuthDeviceProof { format: string; signature: string; }
model AuthDeviceEnrollmentRequest {
  requestId: ulid;
  iat: AuthDeviceProofIssuedAt;
  connectionId: ulid;
  identityKeyId: AuthDigest;
  sessionKey: AuthPublicKey;
  participantId: string;
  identityPublicKey: AuthPublicKey;
  challengeDigest: AuthDigest;
  confirmationCode: AuthDeviceConfirmationCode;
  provisioningSecret?: AuthDeviceProvisioningSecret;
  proof: AuthDeviceProof;
  sessionProof: AuthDeviceProof;
}
enum AuthDeviceReviewState { pending; approved; rejected; expired; }
model AuthDeviceReview {
  reviewId: ulid;
  instanceId: ulid;
  deploymentId: ulid;
  participantId: string;
  state: AuthDeviceReviewState;
  expiresAt: timestamp;
  revision: AuthRevision;
  companionClientId?: AuthClientId;
  companionRequestId?: string;
  companionRequired?: bool;
}
model AuthDeviceReviewGetRequest { reviewId: ulid; confirmationCode: AuthDeviceConfirmationCode; }
model AuthDeviceReviewResponse { review: AuthDeviceReview; }
type AuthDeviceReviewsListResponse = CursorPage<AuthDeviceReview>;
model AuthDeviceReviewDecideRequest {
  reviewId: ulid;
  confirmationCode: AuthDeviceConfirmationCode;
  decision: AuthDecision;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeviceCompanionAttachRequest {
  reviewId: ulid;
  confirmationCode: AuthDeviceConfirmationCode;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeviceCompanion {
  instanceId: ulid;
  clientId: AuthClientId;
  requestId: string;
  oauthGrantId: ulid;
  revision: AuthRevision;
}
model AuthDeviceCompanionRevokeRequest {
  instanceId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
enum AuthResourceOwnerKind { "user"; "deployment"; }
enum AuthResourceState { "pending"; "ready"; "failed"; "detached"; "destroying"; }
model AuthResourceBinding {
  resourceId: AuthDigest;
  ownerKind: AuthResourceOwnerKind;
  ownerId: ulid;
  participantId?: string;
  clientId?: string;
  browserOrigin?: string;
  localName: string;
  kind: AuthResourceKind;
  revision: AuthRevision;
  state: AuthResourceState;
}
