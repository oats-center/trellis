// Public Auth data. Signed authority, catalog, certificate, and issuer-chain
// bytes are decoded by the shared protocol verifier, not by domain DTO codecs.
type AuthApiId = string(min_length=1, max_length=256);
type AuthCapabilityId = string(min_length=1, max_length=512);
type AuthClientId = string(min_length=1, max_length=2048);
type AuthDigest = string(min_length=1, max_length=128);
type AuthKeyId = string(min_length=1, max_length=128);
type AuthPublicKey = string(min_length=43, max_length=43);
type AuthRevision = uint64(min=1);
type AuthIdempotencyKey = string(min_length=1, max_length=256);
type AuthSignedBlob = bytes;
type AuthName = string(min_length=1, max_length=256);
type AuthShortName = string(min_length=1, max_length=128);
type AuthDescription = string(max_length=4096);
type AuthSearch = string(max_length=256);
type AuthCursor = string(min_length=1, max_length=4096);
type AuthPath = string(min_length=1, max_length=4096);
type AuthPassword = string(min_length=8, max_length=512);
type AuthExistingPassword = string(max_length=512);
type AuthPositiveSeconds = uint32(min=1);
type AuthMachineCode = string(min_length=1, max_length=64);

enum AuthPrincipalKind { user; service; device; }
enum AuthPublicClientKind { browser; native; }
enum AuthBindingKind { browser; native; service; device; }
enum AuthCredentialKind { oauthGrant; provisionedIdentity; }
enum AuthEnforcementState { queued; running; completed; }
enum AuthAuthorizationSessionState { active; superseded; revoked; }
enum AuthAttachmentState { pending; admitted; closed; }
enum AuthDecision { approved; declined; }
enum AuthCapabilitySourceKind { role; direct; oidcRole; administrator; }
enum AuthActionKind { rpc; operation; event; live; transfer; }
enum AuthActionDirection { call; invoke; observe; cancel; control; publish; subscribe; read; write; delete; submit; process; consume; }
enum AuthRevocationReason {
  policyReduced;
  logout;
  credentialRevoked;
  issuerCompromised;
  explicitRevoke;
  loginExpired;
  oauthFamilyRevoked;
  apiForceReplacement;
  deploymentDisabled;
}

model AuthEmpty {}
model AuthErrorDetails { code: AuthMachineCode; }
model AuthPageRequest {
  page?: CursorQuery;
  search?: AuthSearch;
}
model AuthEnforcementProgress {
  workId: ulid;
  state: AuthEnforcementState;
  scannedSessions: uint64;
  retiredSessions: uint64;
  pendingKicks: uint64;
  failedKicks: uint64;
}
model AuthMutationResult {
  revision: AuthRevision;
  enforcement?: AuthEnforcementProgress;
}
model AuthCapabilityIdentity {
  capabilityId: AuthCapabilityId;
  identityGeneration: AuthRevision;
}
model AuthCapabilitySelection {
  requiredCapabilities: list<AuthCapabilityId>;
  optionalCapabilities: list<AuthCapabilityId>;
}
model AuthActionSummary {
  name: AuthName;
  kind: AuthActionKind;
  direction: AuthActionDirection;
}
/// The presentation group people choose access by; ungrouped capabilities
/// belong to their API's own group.
enum AuthCapabilityKind { capability; group; }
/// A capability, or a developer-defined group that stands for its members.
model AuthCapabilityDefinition {
  identity: AuthCapabilityIdentity;
  kind: AuthCapabilityKind;
  apiId: AuthApiId;
  consentRevision: AuthRevision;
  title: string;
  description: string;
  grants: string;
  /// A group's current member capabilities.
  members: list<string>;
  allows: list<AuthActionSummary>;
}
model AuthCapabilitiesListRequest {
  page?: CursorQuery;
  apiId?: AuthApiId;
  search?: AuthSearch;
}
type AuthCapabilitiesListResponse = CursorPage<AuthCapabilityDefinition>;

model AuthRole {
  roleId: ulid;
  identityGeneration: AuthRevision;
  revision: AuthRevision;
  title: string;
  description: string;
  capabilities: list<AuthCapabilityIdentity>;
  /// Auth assigns this role to every user it creates.
  assignToNewUsers: bool;
}
model AuthRoleGetRequest { roleId: ulid; }
model AuthRoleGetResponse { role: AuthRole; }
type AuthRolesListResponse = CursorPage<AuthRole>;
model AuthRolePutRequest {
  roleId?: ulid;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
  title: AuthName;
  description: AuthDescription;
  capabilityIds: list<AuthCapabilityId>;
  /// Assign to every user created from now on; existing users keep their roles.
  assignToNewUsers: bool;
}
model AuthRolePutResponse { role: AuthRole; enforcement?: AuthEnforcementProgress; }
model AuthRoleDeleteRequest {
  roleId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthRoleAssignment {
  assignmentId: ulid;
  principalId: ulid;
  roleId: ulid;
  roleIdentityGeneration: AuthRevision;
  revision: AuthRevision;
  expiresAt?: timestamp;
}
model AuthRoleAssignmentsListRequest {
  principalId?: ulid;
  roleId?: ulid;
  page?: CursorQuery;
}
type AuthRoleAssignmentsListResponse = CursorPage<AuthRoleAssignment>;
model AuthRoleAssignRequest {
  principalId: ulid;
  roleId: ulid;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
  expiresAt?: timestamp;
}
model AuthRoleAssignResponse { assignment: AuthRoleAssignment; enforcement?: AuthEnforcementProgress; }
model AuthRoleRevokeRequest {
  assignmentId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthCapabilityGrant {
  grantId: ulid;
  principalId: ulid;
  capability: AuthCapabilityIdentity;
  revision: AuthRevision;
  expiresAt?: timestamp;
}
model AuthCapabilityGrantsListRequest {
  principalId?: ulid;
  capabilityId?: AuthCapabilityId;
  page?: CursorQuery;
}
type AuthCapabilityGrantsListResponse = CursorPage<AuthCapabilityGrant>;
model AuthCapabilityGrantRequest {
  principalId: ulid;
  capabilityId: AuthCapabilityId;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
  expiresAt?: timestamp;
}
model AuthCapabilityGrantResponse { grant: AuthCapabilityGrant; enforcement?: AuthEnforcementProgress; }
model AuthCapabilityRevokeRequest {
  grantId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthCapabilitySource {
  kind: AuthCapabilitySourceKind;
  roleId?: ulid;
  grantId?: ulid;
  providerId?: ulid;
  mappingId?: ulid;
}
model AuthEffectiveCapability {
  definition: AuthCapabilityDefinition;
  sources: list<AuthCapabilitySource>;
  expiresAt?: timestamp;
}
model AuthPrincipal {
  principalId: ulid;
  kind: AuthPrincipalKind;
  title: string;
  enabled: bool;
  revision: AuthRevision;
  createdAt: timestamp;
}
model AuthPrincipalRequest { principalId: ulid; }
model AuthEffectiveAccessResponse {
  principal: AuthPrincipal;
  capabilities: list<AuthEffectiveCapability>;
}

model AuthPackageSourceEvidence {
  name: AuthName;
  version: AuthShortName;
  digest: AuthDigest;
  source: string;
}
model AuthPackageEvidence {
  rootPackage: AuthName;
  rootDigest: AuthDigest;
  packages: list<AuthPackageSourceEvidence>;
}
model AuthAcceptedApi {
  apiId: AuthApiId;
  title: string;
  description: string;
  /// The authored release version, when the API names one.
  version?: string;
  generation: AuthRevision;
  acceptedRevision: AuthRevision;
  canonicalDigest: AuthDigest;
  acceptedAt: timestamp;
  capabilities: list<AuthCapabilityDefinition>;
}
model AuthApiGetRequest { apiId: AuthApiId; }
/// A domain error an action may return.
model AuthApiActionError {
  name: string;
  /// JSON Schema of the error's data, when it carries any.
  payload?: json;
}
/// One RPC, operation, event or live feed an API offers. Schemas are JSON
/// Schema documents carrying the IDL's descriptions.
model AuthApiAction {
  kind: AuthActionKind;
  /// The action's name, such as `Users.Create`.
  name: string;
  description?: string;
  /// What a caller sends: an RPC's request, an operation's invocation, or a
  /// live feed's request.
  input?: json;
  /// What an RPC returns or an operation completes with.
  output?: json;
  /// An event's data, or each item a live feed sends.
  payload?: json;
  /// An operation's durable progress.
  progress?: json;
  /// An operation's live-only updates.
  update?: json;
  /// An operation's named signals and their data.
  signals: map<json>;
  errors: list<AuthApiActionError>;
  /// The payload fields an event is routed by, as dotted paths.
  params: list<string>;
  /// RPC results come a page at a time.
  paginated: bool;
  /// An operation accepts uploaded bytes.
  upload: bool;
  /// Uploaded bytes go straight to the handler instead of being staged.
  stream: bool;
  /// An RPC result may carry a download.
  download: bool;
}
model AuthApiGetResponse {
  api: AuthAcceptedApi;
  actions: list<AuthApiAction>;
  canonicalIdl: string;
}
type AuthApisListResponse = CursorPage<AuthAcceptedApi>;
model AuthApiReviewRequest { apiId: AuthApiId; packageEvidence: AuthPackageEvidence; }
model AuthCapabilityChange {
  capabilityId: AuthCapabilityId;
  previousConsentRevision?: AuthRevision;
  proposedConsentRevision?: AuthRevision;
  previousIdentityGeneration?: AuthRevision;
  description: string;
}
model AuthApiReview {
  reviewId: ulid;
  apiId: AuthApiId;
  canonicalDigest: AuthDigest;
  currentGeneration?: AuthRevision;
  currentAcceptedRevision?: AuthRevision;
  compatible: bool;
  breakage: list<string>;
  actionChanges: list<AuthActionSummary>;
  capabilityChanges: list<AuthCapabilityChange>;
  affectedRoleIds: list<ulid>;
  affectedDeploymentIds: list<ulid>;
  expiresAt: timestamp;
}
model AuthApiReviewResponse { review: AuthApiReview; }
model AuthReviewedRoleEdit { roleId: ulid; expectedRevision: AuthRevision; capabilityIds: list<AuthCapabilityId>; }
model AuthReviewedMappingEdit { mappingId: ulid; expectedRevision: AuthRevision; roleIds: list<ulid>; }
model AuthApiAcceptRequest {
  reviewId: ulid;
  canonicalDigest: AuthDigest;
  expectedGeneration: uint64;
  expectedAcceptedRevision: uint64;
  roleEdits: list<AuthReviewedRoleEdit>;
  mappingEdits: list<AuthReviewedMappingEdit>;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthApiForceReplaceRequest {
  reviewId: ulid;
  canonicalDigest: AuthDigest;
  expectedGeneration: AuthRevision;
  expectedAcceptedRevision: AuthRevision;
  acknowledgeBreakage: bool;
  acknowledgeConsentImpact: bool;
  roleEdits: list<AuthReviewedRoleEdit>;
  mappingEdits: list<AuthReviewedMappingEdit>;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthApiAcceptResponse { api: AuthAcceptedApi; enforcement?: AuthEnforcementProgress; }

model AuthOAuthClient {
  clientId: AuthClientId;
  kind: AuthPublicClientKind;
  title: string;
  description: string;
  redirectUris: list<string>;
  development: bool;
  enabled: bool;
  impliedConsent: list<AuthCapabilityId>;
  signUp: AuthOAuthClientSignUp;
  revision: AuthRevision;
}
/// Ways someone signing in to the app may create their own account. Each new
/// account gets the roles marked for new users.
model AuthOAuthClientSignUp {
  /// A username and password chosen on the Portal.
  password: bool;
  /// A first sign-in with an active identity provider.
  providers: bool;
}
model AuthOAuthClientGetRequest { clientId: AuthClientId; }
model AuthOAuthClientGetResponse { client: AuthOAuthClient; }
type AuthOAuthClientsListResponse = CursorPage<AuthOAuthClient>;
model AuthOAuthClientPutRequest {
  clientId: AuthClientId;
  kind: AuthPublicClientKind;
  title: AuthName;
  description: AuthDescription;
  redirectUris: list<string>;
  development: bool;
  impliedConsent: list<AuthCapabilityId>;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
/// How people may sign in to this installation. Takes effect immediately.
model AuthSignInSettings {
  /// Sign in with a username and password.
  localUsers: bool;
  /// Create your own username-and-password account, through apps that also
  /// allow it. Needs localUsers.
  localSignUp: bool;
  /// Sign in with an active identity provider (company sign-in). At least one
  /// of localUsers and providers stays on.
  providers: bool;
  revision: AuthRevision;
}
model AuthSignInSettingsGetResponse { settings: AuthSignInSettings; }
model AuthSignInSettingsUpdateRequest {
  localUsers: bool;
  localSignUp: bool;
  providers: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOAuthClientSignUpUpdateRequest {
  clientId: AuthClientId;
  signUp: AuthOAuthClientSignUp;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOAuthClientMutationRequest {
  clientId: AuthClientId;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
enum AuthPortalLogoFormat { png; jpeg; webp; svg; }
/// At most 256 KiB once decoded.
type AuthPortalLogoData = string(min_length=1, max_length=349528);
type AuthPortalName = string(min_length=1, max_length=64);
type AuthPortalStylesheet = string(max_length=65536);
type AuthPortalTitle = string(max_length=120);
type AuthPortalSubtitle = string(max_length=280);
type AuthPortalFooter = string(max_length=500);
model AuthPortalLogo { format: AuthPortalLogoFormat; base64: AuthPortalLogoData; }
/// Hex colours such as #0050b3 for the Portal's own palette.
model AuthPortalPalette {
  page?: string;
  surface?: string;
  ink?: string;
  muted?: string;
  line?: string;
  lineStrong?: string;
  primary?: string;
  primaryHover?: string;
  onPrimary?: string;
  soft?: string;
}
model AuthPortalCopy {
  signInTitle?: AuthPortalTitle;
  signInSubtitle?: AuthPortalSubtitle;
  footer?: AuthPortalFooter;
}
/// Without clientId, the installation theme every client inherits.
model AuthPortalTheme {
  clientId?: AuthClientId;
  name?: AuthPortalName;
  logo?: AuthPortalLogo;
  stylesheet?: AuthPortalStylesheet;
  colors: AuthPortalPalette;
  darkColors: AuthPortalPalette;
  copy: AuthPortalCopy;
  revision: AuthRevision;
  updatedAt: timestamp;
}
model AuthPortalThemeSummary {
  clientId?: AuthClientId;
  name?: string;
  revision: AuthRevision;
  updatedAt: timestamp;
}
type AuthPortalThemesListResponse = CursorPage<AuthPortalThemeSummary>;
model AuthPortalThemeGetRequest { clientId?: AuthClientId; }
model AuthPortalThemeGetResponse { theme?: AuthPortalTheme; }
/// Replaces the whole theme; only the installation theme takes a stylesheet.
model AuthPortalThemePutRequest {
  clientId?: AuthClientId;
  name?: AuthPortalName;
  logo?: AuthPortalLogo;
  stylesheet?: AuthPortalStylesheet;
  colors: AuthPortalPalette;
  darkColors: AuthPortalPalette;
  copy: AuthPortalCopy;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthPortalThemeDeleteRequest {
  clientId?: AuthClientId;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDelegationBinding {
  kind: AuthPublicClientKind;
  clientId: AuthClientId;
  origin?: string;
  durableDpopJkt?: string;
}
model AuthConsentChoice {
  capability: AuthCapabilityIdentity;
  consentRevision: AuthRevision;
  decision: AuthDecision;
  expiresAt?: timestamp;
}
model AuthDelegation {
  delegationId: ulid;
  principalId: ulid;
  binding: AuthDelegationBinding;
  choices: list<AuthConsentChoice>;
  revision: AuthRevision;
}
model AuthDelegationsListRequest {
  principalId?: ulid;
  clientId?: AuthClientId;
  page?: CursorQuery;
}
type AuthDelegationsListResponse = CursorPage<AuthDelegation>;
model AuthDelegationReviewRequest { delegationId: ulid; }
model AuthDelegationReviewResponse { delegation: AuthDelegation; currentCapabilities: list<AuthCapabilityDefinition>; }
model AuthDelegationRevokeRequest {
  delegationId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthRuntimeBinding {
  kind: AuthBindingKind;
  clientId?: AuthClientId;
  origin?: string;
  durableDpopJkt?: string;
  deploymentId?: ulid;
  instanceId?: ulid;
  participantId?: string;
}
model AuthAuthorizationSession {
  authorizationSessionId: ulid;
  principalId: ulid;
  principalKind: AuthPrincipalKind;
  binding: AuthRuntimeBinding;
  runtimeId: string;
  sessionPublicKey: AuthPublicKey;
  credentialKind: AuthCredentialKind;
  loginSessionId?: ulid;
  oauthGrantId?: ulid;
  identityKeyId?: AuthKeyId;
  state: AuthAuthorizationSessionState;
  createdAt: timestamp;
  notAfter?: timestamp;
  maximumContextExpiresAt?: timestamp;
  retiredAt?: timestamp;
  reason?: AuthRevocationReason;
}
model AuthAuthorizationSessionsListRequest {
  principalId?: ulid;
  clientId?: AuthClientId;
  loginSessionId?: ulid;
  oauthGrantId?: ulid;
  deploymentId?: ulid;
  state?: AuthAuthorizationSessionState;
  page?: CursorQuery;
}
type AuthAuthorizationSessionsListResponse = CursorPage<AuthAuthorizationSession>;
model AuthAuthorizationSessionRevokeRequest {
  authorizationSessionId: ulid;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthAuthorizationSessionRevokeResponse {
  authorizationSessionId: ulid;
  retiredAt: timestamp;
  enforcement: AuthEnforcementProgress;
}
model AuthAttachment {
  attachmentId: ulid;
  authorizationSessionId: ulid;
  serverId: string;
  brokerClientId: uint64;
  sessionPublicKey: AuthPublicKey;
  admittedTransportPolicyDigest: AuthDigest;
  state: AuthAttachmentState;
  admittedAt?: timestamp;
  closedAt?: timestamp;
}
model AuthConnectionsListRequest {
  authorizationSessionId?: ulid;
  principalId?: ulid;
  state?: AuthAttachmentState;
  page?: CursorQuery;
}
type AuthConnectionsListResponse = CursorPage<AuthAttachment>;
model AuthConnectionsKickRequest { attachmentId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthConnectionsKickResponse { attachmentId: ulid; enforcement: AuthEnforcementProgress; }
model AuthAuthorityRenewRequest { contextDigest: AuthDigest; }
model AuthAuthorityRenewResponse {
  contextDigest: AuthDigest;
  authority: AuthSignedBlob;
  catalog: AuthSignedBlob;
  providers: list<AuthSignedBlob>;
}
model AuthAdmissionRenewRequest { contextDigest: AuthDigest; }
model AuthAdmissionRenewResponse { admissionCredential: string; expiresAt: timestamp; }
model AuthIssuerRotateRequest { expectedCurrentKeyId: AuthKeyId; idempotencyKey: AuthIdempotencyKey; }
model AuthIssuerRotateResponse { keyId: AuthKeyId; rotation: AuthSignedBlob; }
model AuthIssuerRevokeRequest { keyId: AuthKeyId; idempotencyKey: AuthIdempotencyKey; }
model AuthIssuerRevokeResponse { keyId: AuthKeyId; enforcement: AuthEnforcementProgress; }

enum AuthLoginMethod { local; oidc; }
enum AuthLoginState { active; revoked; }
model AuthLoginSession {
  loginSessionId: ulid;
  principalId: ulid;
  method: AuthLoginMethod;
  providerId?: ulid;
  createdAt: timestamp;
  expiresAt: timestamp;
  claimFreshUntil?: timestamp;
  state: AuthLoginState;
}
type AuthSessionsListResponse = CursorPage<AuthLoginSession>;
model AuthSessionsMeResponse { principal: AuthPrincipal; login?: AuthLoginSession; authorizationSessionId: ulid; }
model AuthSessionsLogoutResponse { loginSessionId: ulid; enforcement: AuthEnforcementProgress; }
model AuthLoginRevokeRequest { loginSessionId: ulid; idempotencyKey: AuthIdempotencyKey; }
