}
model AuthPasswordResetCreateRequest { userId: ulid; idempotencyKey: AuthIdempotencyKey; }
model AuthPasswordResetCreateResponse { token: string; expiresAt: timestamp; }
model AuthUserIdentity {
  identityId: ulid;
