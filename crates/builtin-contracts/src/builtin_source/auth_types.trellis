}
model AuthOIDCRoleMapping {
  mappingId: ulid;
  providerId: ulid;
  externalRole: string;
  roleIds: list<ulid>;
  revision: AuthRevision;
}
model AuthOIDCRoleMappingsListRequest { providerId: ulid; page?: CursorQuery; }
type AuthOIDCRoleMappingsListResponse = CursorPage<AuthOIDCRoleMapping>;
model AuthOIDCRoleMappingPutRequest {
  mappingId?: ulid;
  providerId: ulid;
  externalRole: AuthName;
  roleIds: list<ulid>;
  expectedRevision: uint64;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthOIDCRoleMappingPutResponse { mapping: AuthOIDCRoleMapping; enforcement?: AuthEnforcementProgress; }
model AuthOIDCRoleMappingDeleteRequest {
  mappingId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}

enum AuthDeploymentKind { service; device; }
enum AuthDeploymentState { enabled; disabled; removed; }
enum AuthResourceKind { kv; store; state; job; eventConsumer; }
model AuthDeployment {
  deploymentId: ulid;
  title: string;
  kind: AuthDeploymentKind;
  participantId: string;
  implementationDigest: AuthDigest;
  selection: AuthCapabilitySelection;
  state: AuthDeploymentState;
  revision: AuthRevision;
}
model AuthDeploymentCreateRequest {
  title: AuthName;
  kind: AuthDeploymentKind;
  participantId: string;
  packageEvidence: AuthPackageEvidence;
  acknowledgeSharedApis?: bool;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeploymentGetRequest { deploymentId: ulid; }
model AuthDeploymentGetResponse { deployment: AuthDeployment; }
type AuthDeploymentsListResponse = CursorPage<AuthDeployment>;
model AuthDeploymentApplyRequest {
  deploymentId: ulid;
  packageEvidence: AuthPackageEvidence;
  acknowledgeSharedApis?: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeploymentMutationRequest {
  deploymentId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeploymentMutationResponse { deployment: AuthDeployment; enforcement?: AuthEnforcementProgress; }
enum AuthServiceUpdateState { pending; applied; rejected; superseded; }
model AuthServiceUpdateResource {
  kind: AuthResourceKind;
  name: string;
}
model AuthServiceUpdateChanges {
  addedCapabilities: list<AuthCapabilityId>;
  removedCapabilities: list<AuthCapabilityId>;
  addedResources: list<AuthServiceUpdateResource>;
  reattachedResources: list<AuthServiceUpdateResource>;
  changedResources: list<AuthServiceUpdateResource>;
  removedResources: list<AuthServiceUpdateResource>;
  addedApis: list<AuthApiId>;
  sharedApis: list<AuthApiId>;
  removedApis: list<AuthApiId>;
  acceptedApis: list<AuthApiId>;
}
model AuthServiceUpdate {
  updateId: ulid;
  deploymentId: ulid;
  instanceId: ulid;
  participantId: string;
  participantDigest: AuthDigest;
  state: AuthServiceUpdateState;
  changes: AuthServiceUpdateChanges;
  reviewUrl: string;
  requestedAt: timestamp;
  decidedAt?: timestamp;
  revision: AuthRevision;
}
model AuthServiceUpdateSubmitRequest { participantId: string; packageEvidence: AuthPackageEvidence; }
enum AuthServiceClaimState { waiting; claimed; removed; }
/// A service deployment that takes whatever service first connects with its
/// identity. The connecting service submits its IDL as an update to the claim;
/// approving it creates the deployment (`deploymentId`) and its instance.
model AuthServiceClaim {
  claimId: ulid;
  title: AuthName;
  instanceTitle: AuthName;
  state: AuthServiceClaimState;
  deploymentId?: ulid;
  createdAt: timestamp;
  revision: AuthRevision;
}
model AuthServiceClaimCreateRequest {
  title: AuthName;
  instanceTitle: AuthName;
  identityPublicKey: AuthPublicKey;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthServiceClaimRemoveRequest {
  claimId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthServiceClaimResponse { claim: AuthServiceClaim; }
type AuthServiceClaimsListResponse = CursorPage<AuthServiceClaim>;
model AuthServiceUpdateStatusRequest { updateId: ulid; }
model AuthServiceUpdateResponse { update: AuthServiceUpdate; }
model AuthServiceUpdatesListRequest { deploymentId?: ulid; page?: CursorQuery; }
type AuthServiceUpdatesListResponse = CursorPage<AuthServiceUpdate>;
model AuthServiceUpdateDecideRequest {
  updateId: ulid;
  decision: AuthDecision;
  acknowledgeSharedApis?: bool;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthProvisionedInstance {
  instanceId: ulid;
  principal: AuthPrincipal;
  deploymentId: ulid;
  identityPublicKey?: AuthPublicKey;
  revision: AuthRevision;
}
model AuthInstancesListRequest { deploymentId?: ulid; page?: CursorQuery; }
type AuthInstancesListResponse = CursorPage<AuthProvisionedInstance>;
model AuthInstanceProvisionRequest {
  deploymentId: ulid;
  title: AuthName;
  identityPublicKey?: AuthPublicKey;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthInstanceProvisionResponse { instance: AuthProvisionedInstance; provisioningSecret?: string; }
model AuthInstanceMutationRequest {
  instanceId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthInstanceMutationResponse { instance: AuthProvisionedInstance; enforcement?: AuthEnforcementProgress; }
type AuthDeviceConfirmationCode = string(min_length=8, max_length=8);
type AuthDeviceProvisioningSecret = string(min_length=43, max_length=43);
/// JSON-number Unix milliseconds; the session-proof verifier also requires an integer.
type AuthDeviceProofIssuedAt = number(min=0, max=9007199254740991);
model AuthDeviceProof { format: string; signature: string; }
model AuthDeviceEnrollmentRequest {
  requestId: ulid;
  iat: AuthDeviceProofIssuedAt;
  connectionId: ulid;
  identityKeyId: AuthDigest;
  sessionKey: AuthPublicKey;
  participantId: string;
  identityPublicKey: AuthPublicKey;
  challengeDigest: AuthDigest;
  confirmationCode: AuthDeviceConfirmationCode;
  provisioningSecret?: AuthDeviceProvisioningSecret;
  proof: AuthDeviceProof;
  sessionProof: AuthDeviceProof;
}
enum AuthDeviceReviewState { pending; approved; rejected; expired; }
model AuthDeviceReview {
  reviewId: ulid;
  instanceId: ulid;
  deploymentId: ulid;
  participantId: string;
  state: AuthDeviceReviewState;
  expiresAt: timestamp;
  revision: AuthRevision;
  companionClientId?: AuthClientId;
  companionRequestId?: string;
  companionRequired?: bool;
}
model AuthDeviceReviewGetRequest { reviewId: ulid; confirmationCode: AuthDeviceConfirmationCode; }
model AuthDeviceReviewResponse { review: AuthDeviceReview; }
type AuthDeviceReviewsListResponse = CursorPage<AuthDeviceReview>;
model AuthDeviceReviewDecideRequest {
  reviewId: ulid;
  confirmationCode: AuthDeviceConfirmationCode;
  decision: AuthDecision;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeviceCompanionAttachRequest {
  reviewId: ulid;
  confirmationCode: AuthDeviceConfirmationCode;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
model AuthDeviceCompanion {
  instanceId: ulid;
  clientId: AuthClientId;
  requestId: string;
  oauthGrantId: ulid;
  revision: AuthRevision;
}
model AuthDeviceCompanionRevokeRequest {
  instanceId: ulid;
  expectedRevision: AuthRevision;
  idempotencyKey: AuthIdempotencyKey;
}
enum AuthResourceOwnerKind { "user"; "deployment"; }
enum AuthResourceState { "pending"; "ready"; "failed"; "detached"; "destroying"; }
model AuthResourceBinding {
  resourceId: AuthDigest;
  ownerKind: AuthResourceOwnerKind;
  ownerId: ulid;
  participantId?: string;
  clientId?: string;
  browserOrigin?: string;
  localName: string;
  kind: AuthResourceKind;
  revision: AuthRevision;
  state: AuthResourceState;
}
model AuthResourceGetRequest { resourceId: AuthDigest; }
model AuthResourceGetResponse { resource: AuthResourceBinding; }
model AuthResourcesListRequest { ownerKind?: AuthResourceOwnerKind; ownerId?: ulid; state?: AuthResourceState; page?: CursorQuery; }
type AuthResourcesListResponse = CursorPage<AuthResourceBinding>;
model AuthResourceRemoveRequest { resourceId: AuthDigest; expectedRevision: AuthRevision; idempotencyKey: AuthIdempotencyKey; }

enum AuthResourceEvidenceKind { jobQueue; eventConsumer; }
enum AuthResourceEvidenceState { available; unavailable; stale; }
model AuthJobResourceEvidence {
  namespace: string;
  workStream: string;
  consumer: string;
  publishPrefix: string;
  workSubject: string;
}
model AuthEventConsumerEvidence {
  stream: string;
  consumer: string;
  replayConsumer: string;
  filterSubjects: list<string>;
}
model AuthResourceEvidence {
  resourceId: AuthDigest;
  ownerId: ulid;
  participantId: string;
  installedRevision: AuthRevision;
  localName: string;
  kind: AuthResourceEvidenceKind;
  state: AuthResourceEvidenceState;
  resourceBindingsDigest?: AuthDigest;
  job?: AuthJobResourceEvidence;
  eventConsumer?: AuthEventConsumerEvidence;
}
model AuthResourceBindingsQueryRequest {
  kind: AuthResourceEvidenceKind;
  instanceId?: ulid;
  ownerId?: ulid;
  participantId?: string;
  localName?: string;
  resourceId?: AuthDigest;
  page?: CursorQuery;
}
type AuthResourceBindingsQueryResponse = CursorPage<AuthResourceEvidence>;

model AuthSecurityEvent {
  eventId: ulid;
  occurredAt: timestamp;
  principalId?: ulid;
  authorizationSessionId?: ulid;
  attachmentId?: ulid;
  issuerKeyId?: AuthKeyId;
  enforcement?: AuthEnforcementProgress;
}
