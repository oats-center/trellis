import {
  StateConflict,
  StateDeleteRequest,
  StateDeleteResponse,
  StateGetRequest,
  StateGetResponse,
  StatePutRequest,
  StatePutResponse,
  StateRepresentationError,
  StateRegisterRequest,
  StateRegisterResponse,
  StateRegistrationConflict,
} from types;

api state@v1 {
  title "Trellis State";
  description "Trellis-managed single-value State for user bindings and service/device principals.";
  version "1.0.0";

  error Conflict(StateConflict);
  error CorruptRepresentation(StateRepresentationError);
  error UnsupportedRepresentation(StateRepresentationError);
  error RegistrationConflict(StateRegistrationConflict);

  rpc Register {
    input StateRegisterRequest;
    output StateRegisterResponse;
    errors [RegistrationConflict];
  }

  rpc Get {
    input StateGetRequest;
    output StateGetResponse;
    errors [CorruptRepresentation, UnsupportedRepresentation];
  }

  rpc Put {
    input StatePutRequest;
    output StatePutResponse;
    errors [Conflict, CorruptRepresentation, UnsupportedRepresentation];
  }

  rpc Delete {
    input StateDeleteRequest;
    output StateDeleteResponse;
    errors [Conflict];
  }


  live Watch {
    input StateGetRequest;
    event StateGetResponse;
  }

  capabilities {
    capability read {
      title "Read State";
      description "Read saved State values in the caller's authorized namespace.";
      consequence "The caller can see saved values.";
      consent_revision 2;
      allows { rpc Get; live Watch; }
    }
    capability write {
      title "Write State";
      description "Register representations and create or replace State values in the caller's authorized namespace.";
      consequence "The caller can change saved values.";
      consent_revision 2;
      allows { rpc Register; rpc Put; }
    }
    capability delete {
      title "Delete State";
      description "Delete State values in the caller's authorized namespace.";
      consequence "The caller can remove saved values.";
      consent_revision 1;
      allows { rpc Delete; }
    }
  }
}
