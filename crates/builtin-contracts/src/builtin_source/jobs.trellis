api jobs@v1 {
  title "Trellis Jobs";
  description "Trellis-managed background job administration API.";
  version "1.0.0";
  error NotFoundError(JobsNotFoundErrorData);
  error UnexpectedError;
  error ValidationError;
  rpc History {
    input JobsHistoryRequest;
    output JobsHistoryResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Cancel {
    input JobsCancelRequest;
    output JobsCancelResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc DismissDLQ {
    input JobsDismissDLQRequest;
    output JobsDismissDLQResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc GetKey {
    input JobsGetKeyRequest;
    output JobsGetKeyResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Inspect {
    input JobsInspectRequest;
    output JobsInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc ListDLQ {
    input JobsListDLQRequest;
    output JobsListDLQResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc ListServices {
    input JobsListServicesRequest;
    output JobsListServicesResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Metrics {
    input JobsMetricsRequest;
    output JobsMetricsResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc Query {
    input JobsQueryRequest;
    output JobsQueryResponse;
    errors [UnexpectedError, ValidationError];
    pagination cursor;
  }
  rpc Summary {
    input JobsSummaryRequest;
    output JobsSummaryResponse;
    errors [UnexpectedError, ValidationError];
  }
  rpc ReplayDLQ {
    input JobsReplayDLQRequest;
    output JobsReplayDLQResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  rpc Retry {
    input JobsRetryRequest;
    output JobsRetryResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
  }
  live Watch {
    input JobsWatchRequest;
    event JobsWatchFrame;
  }
  capabilities {
    capability jobs.query {
      title "Search jobs";
      description "Find background jobs.";
      grants "Can see job summaries.";
      allows { rpc Query; }
    }
    capability jobs.inspect {
      title "Open jobs";
      description "See a job's input, result, and history.";
      grants "Can see job data.";
      allows { rpc Inspect; }
    }
    capability jobs.findByKey {
      title "Find jobs by key";
      description "Look up a job by its key.";
      grants "Can find jobs by key.";
      allows { rpc GetKey; }
    }
    capability services.list {
      title "See job services";
      description "See which services run jobs.";
      grants "Can see services and their queues.";
      allows { rpc ListServices; }
    }
    capability summary.read {
      title "See job overview";
      description "See how many jobs are waiting, running, or failed.";
      grants "Can see job counts.";
      allows { rpc Summary; }
    }
    capability metrics.read {
      title "See job metrics";
      description "See job speed and throughput.";
      grants "Can see job metrics.";
      allows { rpc Metrics; }
    }
    capability jobs.cancel {
      title "Cancel jobs";
      description "Stop a waiting or running job.";
      grants "Can stop work.";
      allows { rpc Cancel; }
    }
    capability jobs.retry {
      title "Retry jobs";
      description "Run a job again.";
      grants "Work may run again.";
      allows { rpc Retry; }
    }
    capability deadLetters.read {
      title "See failed jobs";
      description "See jobs that failed for good.";
      grants "Can see failed jobs.";
      allows { rpc ListDLQ; }
    }
    capability deadLetters.replay {
      title "Rerun failed jobs";
      description "Send a failed job back to run again.";
      grants "Work may run again and repeat its effects.";
      allows { rpc ReplayDLQ; }
    }
    capability deadLetters.dismiss {
      title "Dismiss failed jobs";
      description "Clear a failed job from the list.";
      grants "Removes it from follow-up.";
      allows { rpc DismissDLQ; }
    }
    capability jobs.observe {
      title "Watch jobs live";
      description "Follow job changes as they happen.";
      grants "Can see jobs live.";
      allows { live Watch; }
    }
    capability history.read {
      title "Read own job history";
      description "Let a service read the history of its own jobs.";
      grants "Only that service's jobs are returned.";
      allows { rpc History; }
    }
    group operator {
      title "Operate jobs";
      description "Watch jobs and workers, and cancel, retry, replay, or dismiss jobs.";
      grants "Can see job data and change how jobs run.";
      capability jobs.query;
      capability jobs.inspect;
      capability jobs.findByKey;
      capability jobs.cancel;
      capability jobs.retry;
      capability jobs.observe;
      capability services.list;
      capability summary.read;
      capability metrics.read;
      capability history.read;
      capability deadLetters.read;
      capability deadLetters.replay;
      capability deadLetters.dismiss;
    }
  }
}
