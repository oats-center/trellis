import { auth } from auth;
import { core } from core;
import { state } from state;
import { health } from health;
import { jobs } from jobs;
import { events } from events;
import { AuthAttachment } from auth_types;

service platform {
  implements auth;
  implements core;
  implements state;
  kv connections {
    title "Connections";
    description "Operational attachment presence; policy and enforcement remain in Auth's durable store.";
    schema AuthAttachment;
    ttl 2m;
    desired_max_value 16KiB;
  }
}
service healthRuntime { implements health; }
service jobsRuntime {
  implements jobs;
  use auth { required capability readJobBindings; }
}
service eventsRuntime {
  implements events;
  use auth { required capability readEventBindings; }
}

// These declarations are developer requests, never installed principals.
agent cli {
  use auth {
    capability manageRoles;
    capability acceptApis;
    capability forceReplaceApis;
    capability manageClients;
    capability managePlatform;
    capability managePrincipals;
    capability readUsers;
    capability readAccount;
    capability updateProfile;
    capability changePassword;
    capability readIdentities;
    capability manageIdentities;
    capability readSessions;
    capability revokeSessions;
    capability readDelegations;
    capability revokeDelegations;
  }
  use state { capability delete; }
  use core {
    capability destroyResources;
    capability readResources;
  }
  use health { capability query; capability observe; }
  use jobs { capability query; }
  use events {
    capability inspectConsumers;
    capability dismissDeadLetters;
    capability inspectDeadLetters;
    capability replayDeadLetters;
    capability query;
  }
}

app console {
  use auth {
    capability manageRoles;
    capability acceptApis;
    capability forceReplaceApis;
    capability manageClients;
    capability managePlatform;
    capability managePrincipals;
    capability readUsers;
    capability observeSecurityEvents;
    capability readAccount;
    capability updateProfile;
    capability changePassword;
    capability readIdentities;
    capability manageIdentities;
    capability readSessions;
    capability revokeSessions;
    capability readDelegations;
    capability revokeDelegations;
  }
  use state {
    capability delete;
    capability read;
    capability write;
  }
  use core {
    capability destroyResources;
    capability readResources;
  }
  use health {
    capability inspect;
    capability readMetrics;
    capability query;
    capability readSummary;
    capability observe;
  }
  use jobs {
    capability cancel;
    capability dismissDeadLetters;
    capability findByKey;
    capability inspect;
    capability readDeadLetters;
    capability listServices;
    capability readMetrics;
    capability query;
    capability readSummary;
    capability replayDeadLetters;
    capability retry;
    capability observe;
  }
  use events {
    capability inspectConsumers;
    capability dismissDeadLetters;
    capability inspectDeadLetters;
    capability replayDeadLetters;
    capability readDiagnostics;
    capability inspect;
    capability readMetrics;
    capability query;
    capability observe;
  }
}
