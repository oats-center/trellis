{
  "name": "trellis-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "ts/packages/*",
    "web",
    "portal",
    "docs"
  ],
  "scripts": {
    "install:contracts": "cargo xtask install",
    "protocol:wasm": "cargo xtask protocol-wasm",
    "browser:embedded": "npm run build:embedded --workspace @trellis/oauth-portal && npm run build:embedded --workspace @trellis/console",
    "build:runtime": "npm run install:contracts && npm run browser:embedded",
    "build:packages": "npm run build --workspace @oatscenter/result && npm run build --workspace @oatscenter/trellis && npm run build --workspace @oatscenter/trellis-testkit && npm run build --workspace @oatscenter/trellis-svelte",
    "test:package-version": "node --test ts/tools/package_build/release_build_version_test.ts",
    "test:packages": "node ts/tools/run_unit_tests.ts ts/tools/package_build",
    "check:sdk": "npm run build:packages && npm run check --workspace @oatscenter/trellis && npm run check --workspace @oatscenter/trellis-testkit && npm run check:benchmarks",
    "test": "bash scripts/check.sh",
    "test:sdk": "bash scripts/run-sdk-tests.sh",
    "check:benchmarks": "tsc -p benchmarks/runtime/tsconfig.json",
    "test:benchmarks": "node --experimental-transform-types --test benchmarks/runtime/*_test.ts",
    "bench:runtime": "node --experimental-transform-types benchmarks/runtime/run.ts",
    "bench:runtime:report": "node --experimental-transform-types benchmarks/runtime/report.ts",
    "bench:runtime:suite": "node --experimental-transform-types benchmarks/runtime/suite.ts",
    "bench:runtime:browser:build": "esbuild benchmarks/runtime/browser.ts --bundle --format=esm --platform=browser --external:node:* --outfile=benchmarks/runtime/browser.bundle.js",
    "coverage:browser": "node ts/tools/browser_v8_to_lcov.ts",
    "coverage:browser:merge": "node ts/tools/browser_v8_to_lcov.ts --append-to coverage/live-integration/lcov.info",
    "test:integration": "bash scripts/run-ts-integration.sh",
    "check:integration": "tsc --project ts/integration/tsconfig.json",
    "test:browser": "bash scripts/run-browser-tests.sh",
    "fmt": "prettier --write",
    "fmt:check": "prettier --check"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/jwt": "^0.0.10-5",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/nkeys": "^2.0.3",
    "@nats-io/obj": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@noble/hashes": "1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "~2.11.0",
    "@opentelemetry/core": "~2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "~0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "~0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-metrics": "~2.11.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0",
    "@opentelemetry/sdk-trace-node": "~2.11.0",
    "@opentelemetry/sdk-trace-web": "~2.11.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@standard-schema/spec": "^1.1.0",
    "@sveltejs/acorn-typescript": "^1.0.9",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.4",
    "@types/cookie": "^1.0.0",
    "@types/node": "^24.0.0",
    "acorn": "^8.16.0",
    "clsx": "2.1.1",
    "cookie": "^1.1.1",
    "daisyui": "5.5.19",
    "devalue": "^5.7.1",
    "diff": "^9.0.0",
    "esbuild": "0.28.2",
    "esm-env": "^1.2.2",
    "fake-indexeddb": "6.2.5",
    "fflate": "^0.8.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "hono": "^4.12.15",
    "json-schema-library": "^11.4.0",
    "jsonc-parser": "^3.3.1",
    "kleur": "^4.1.5",
    "lucide-svelte": "^1.0.1",
    "magic-string": "^0.30.21",
    "mermaid": "^11.14.0",
    "mrmime": "^2.0.1",
    "pino": "^10.3.1",
    "playwright": "1.59.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "protobufjs": "^8.8.0",
    "serialize-error": "^13.0.1",
    "set-cookie-parser": "^3.1.0",
    "sigma": "^3.0.2",
    "sirv": "^3.0.2",
    "svelte": "5.56.4",
    "svelte-check": "4.4.6",
    "svelteplot": "0.14.2",
    "tailwindcss": "4.2.4",
    "tar": "^7.5.22",
    "tweetnacl": "^1.0.3",
    "type-fest": "^5.6.0",
    "typebox": "^1.1.33",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "ulid": "^3.0.2",
    "uqr": "0.1.3",
    "v8-to-istanbul": "^9.3.0",
    "vite": "8.3.4",
    "zod": "^4.3.6"
  }
}
