{
  "name": "trellis-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "ts/packages/*",
    "web",
    "portal",
    "docs"
  ],
  "scripts": {
    "install:contracts": "cargo xtask install",
    "protocol:wasm": "cargo xtask protocol-wasm",
    "browser:embedded": "npm run build:embedded --workspace @trellis/oauth-portal && npm run build:embedded --workspace @trellis/console",
    "build:runtime": "npm run install:contracts && npm run protocol:wasm && npm run browser:embedded",
    "build:packages": "npm run build --workspace @oatscenter/result && npm run build --workspace @oatscenter/trellis && npm run build --workspace @oatscenter/trellis-svelte",
    "test:package-version": "node --test ts/tools/package_build/release_build_version_test.ts",
    "test:oauth-custody": "node --test ts/browser/oauth_custody.browser_test.ts",
    "fmt": "prettier --write",
    "fmt:check": "prettier --check"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/jwt": "^0.0.10-5",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/nkeys": "^2.0.3",
    "@nats-io/obj": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@noble/hashes": "1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "~2.11.0",
    "@opentelemetry/core": "~2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "~0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "~0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-metrics": "~2.11.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0",
    "@opentelemetry/sdk-trace-node": "~2.11.0",
    "@opentelemetry/sdk-trace-web": "~2.11.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@standard-schema/spec": "^1.1.0",
    "@sveltejs/acorn-typescript": "^1.0.9",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.4",
    "@types/cookie": "^1.0.0",
    "@types/node": "^24.0.0",
    "acorn": "^8.16.0",
    "clsx": "2.1.1",
    "cookie": "^1.1.1",
    "daisyui": "5.5.19",
    "devalue": "^5.7.1",
    "diff": "^9.0.0",
    "esm-env": "^1.2.2",
    "fake-indexeddb": "6.2.5",
    "fflate": "^0.8.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "hono": "^4.12.15",
    "json-schema-library": "^11.4.0",
    "jsonc-parser": "^3.3.1",
    "kleur": "^4.1.5",
    "lucide-svelte": "^1.0.1",
    "magic-string": "^0.30.21",
    "mdsvex": "0.12.6",
    "mermaid": "^11.14.0",
    "mrmime": "^2.0.1",
    "pino": "^10.3.1",
