    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "protobufjs": "^8.8.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "serialize-error": "^13.0.1",
    "set-cookie-parser": "^3.1.0",
    "shiki": "4.0.2",
    "sigma": "^3.0.2",
    "sirv": "^3.0.2",
    "svelte": "5.55.7",
    "svelte-check": "4.4.6",
    "svelteplot": "0.14.2",
    "tailwindcss": "4.2.4",
    "tar": "^7.5.22",
    "tweetnacl": "^1.0.3",
    "type-fest": "^5.6.0",
    "typebox": "^1.1.33",
    "typescript": "6.0.3",
    "typedoc": "0.28.20",
    "ulid": "^3.0.2",
