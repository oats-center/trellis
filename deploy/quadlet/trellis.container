[Unit]
Description=Trellis runtime
After=trellis-nats.service
Requires=trellis-nats.service

[Container]
ContainerName=trellis
Image=localhost/trellis:revision7
Entrypoint=trellis-server
Exec=--config /etc/trellis/config.toml --system all
PublishPort=127.0.0.1:3000:3000
PublishPort=127.0.0.1:3001:3001
Volume=%h/trellis/config:/etc/trellis:ro,Z
Volume=%h/trellis/data:/var/lib/trellis:rw,Z
Volume=%t/trellis:/run/trellis:rw,Z
Network=trellis.network
UserNS=keep-id:uid=10001,gid=10001
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=16m

[Service]
RuntimeDirectory=trellis
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
