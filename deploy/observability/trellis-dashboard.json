{
  "uid": "trellis-obs02",
  "title": "Trellis production overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["trellis", "observability"],
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Required component health",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:component_present",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "title": "Native RPC requests/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:rpc_requests:5m",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "title": "RPC service error ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:rpc_error_ratio:5m",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "Auth refresh p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:auth_refresh:p95",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "title": "Auth refresh mean",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "(sum by (trellis_cluster) (rate(trellis_auth_flow_duration_sum{telemetry_pipeline=\"native\",trellis_operation=\"context_refresh\",trellis_phase=\"total\"}[5m])) / sum by (trellis_cluster) (rate(trellis_auth_flow_duration_count{telemetry_pipeline=\"native\",trellis_operation=\"context_refresh\",trellis_phase=\"total\"}[5m]))) and on (trellis_cluster) (sum by (trellis_cluster) (rate(trellis_auth_flow_duration_count{telemetry_pipeline=\"native\",trellis_operation=\"context_refresh\",trellis_phase=\"total\"}[5m])) > 0)",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "title": "Auth delivery backlog",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:auth_post_commit_pending",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "title": "Auth oldest delivery",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:auth_post_commit_oldest_age",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "title": "Ready Jobs and worker registrations",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:jobs_ready",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        },
        {
          "expr": "trellis:jobs_worker_registrations",
          "refId": "B",
          "legendFormat": "workers {{trellis_cluster}}"
        },
        {
          "expr": "trellis:jobs_waiting_retry",
          "refId": "C",
          "legendFormat": "waiting retry {{trellis_cluster}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 9,
      "title": "Oldest ready Job",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:jobs_oldest_ready_age",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 10,
      "title": "Consumer pending",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:consumer_pending",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 11,
      "title": "Consumer ACK pending",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:consumer_ack_pending",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 12,
      "title": "Consumer no-progress age",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:consumer_progress_age",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 13,
      "title": "Unresolved dead letters",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:dlq_entries",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 14,
      "title": "Projector backlog",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 48, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:projection_pending",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 15,
      "title": "Projector no-progress age",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 56, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis:projection_progress_age",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 16,
      "title": "Connection usability",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 56, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis_connection_count{telemetry_pipeline=\"native\"}",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 17,
      "title": "Operation execution owners",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 64, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "trellis_operation_active{telemetry_pipeline=\"native\"}",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 18,
      "title": "Snapshot freshness",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 64, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - trellis_snapshot_observed_time{telemetry_pipeline=\"native\"}",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 19,
      "title": "Cache requests/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 72, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (trellis_cache_kind, trellis_cache_result) (rate(trellis_contract_cache_requests{telemetry_pipeline=\"native\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 20,
      "title": "Storage p95 by backend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 72, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, trellis_backend) (rate(trellis_storage_duration_bucket{telemetry_pipeline=\"native\",trellis_phase=\"total\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 21,
      "title": "Collector queue utilization",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 80, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "otelcol_exporter_queue_size / clamp_min(otelcol_exporter_queue_capacity, 1)",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 22,
      "title": "Browser ready p95 (untrusted)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 80, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, trellis_app) (rate(trellis_browser_navigation_duration_bucket{telemetry_pipeline=\"browser\",trellis_phase=\"ready\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{trellis_cluster}} {{trellis_component}} {{trellis_state}} {{trellis_source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 23,
      "title": "SDK metric overflow (series present, not event count)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 88, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "count by (trellis_cluster, job, instance) ({__name__=~\"trellis_.*\", telemetry_pipeline=\"native\", otel_metric_overflow=\"true\"}) > 0",
          "refId": "A",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
